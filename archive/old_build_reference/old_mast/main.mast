# Khovan Reach MAST architecture scaffold
# Source: AGENTS.md and design_docs/03_mast_requirements.md
# Verified local MAST patterns used here:
# - import statements
# - shared assignments
# - await task_schedule(...)
# - delay_sim(...)
# - labels
# - log(...)
# - ->END
# - prefab_spawn(prefab_side_generic, ...)
# - npc_spawn(...)
# - sim.add_navproxy(...)
# - set_face(...)
# - await task_schedule(spawn_players)
# - to_object_list(role("__player__") & role("tsn"))
# - sorted(..., key=lambda p: p.id)
# - object.name and object.id for player ship lookup
# - docking_set_docking_logic(player_id, target_id, docking_dock_with_friendly_station)
# - link(player_id, "extra_scan_source", target_id)
# - remove_role(...)
# - set_data_set_value(..., "energy", ...)
# - set_data_set_value(..., "{TorpedoType}_NUM", ...)
# - to_blob(...).set(...)

