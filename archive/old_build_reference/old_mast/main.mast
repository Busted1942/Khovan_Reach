=== khovan_reach_hide_debug_tabs ===
    allow_debug = False
    DEBUG_TAB_ENABLED = False
    gui_tab_remove_top("debug,brain,mast")
    log("Player-facing debug tabs disabled for Khovan Reach normal play.")
    ->END

=== khovan_reach_setup_act_1_space ===
    await task_schedule(khovan_reach_setup_tsn_side)
    await task_schedule(khovan_reach_setup_training_side)

    existing_kestrel_yards = to_object_list(role("kestrel_yards"))
    if len(existing_kestrel_yards) > 0:
        kestrel_yards_id = existing_kestrel_yards[0].id
    else:
        kestrel_yards = npc_spawn(0, 0, 0, "Kestrel Yards", "tsn, friendly, kestrel_yards, khovan_origin", "starbase_command", "behav_station")
        kestrel_yards_id = to_id(kestrel_yards)
        set_face(kestrel_yards_id, random_terran(civilian=True))
        sim.add_navproxy(kestrel_yards_id, "Kestrel Yards", "starbase_command", "#4A7")
    remove_role(kestrel_yards_id, "Station")
    remove_role(kestrel_yards_id, "station")

    existing_tarsis_station = to_object_list(role("tarsis_station"))
    if len(existing_tarsis_station) > 0:
        tarsis_station_id = existing_tarsis_station[0].id
    else:
        tarsis_station = npc_spawn(18000, 0, 0, "Tarsis Station", "tsn, friendly, tarsis_station, khovan_drill_resupply", "starbase_command", "behav_station")
        tarsis_station_id = to_id(tarsis_station)
        set_face(tarsis_station_id, random_terran(civilian=True))
        sim.add_navproxy(tarsis_station_id, "Tarsis Station", "starbase_command", "#4A7")
    remove_role(tarsis_station_id, "Station")
    add_role(tarsis_station_id, "station")
    task_schedule(khovan_reach_keep_tarsis_priority_docking_hidden)

    tarsis_blob = to_blob(tarsis_station_id)
    if tarsis_blob is not None:
        tarsis_blob.set("torpedo_types_available", "Homing,Nuke,EMP,Mine")
        set_data_set_value(tarsis_station_id, "Homing_NUM", 32, 0)
        set_data_set_value(tarsis_station_id, "Nuke_NUM", 8, 0)
        set_data_set_value(tarsis_station_id, "EMP_NUM", 8, 0)
        set_data_set_value(tarsis_station_id, "Mine_NUM", 8, 0)

    log(f"Act I space ready: Kestrel Yards id {kestrel_yards_id}, Tarsis Station id {tarsis_station_id}.")
    ->END

=== khovan_reach_setup_tsn_side ===
    tsn_side = to_side_id("tsn")
    if tsn_side is None:
        tsn_side = await prefab_spawn(prefab_side_generic, data={"key":"tsn"})

    if tsn_side is not None:
        side_set_display_name(tsn_side, "TSN")
        side_set_description(tsn_side, "The Terran Stellar Navy")
        side_set_icon_color(tsn_side, "#07F")

    ->END

=== khovan_reach_setup_training_side ===
    training_side = to_side_id("khovan_training")
    if training_side is None:
        training_side = await prefab_spawn(prefab_side_generic, data={"key":"khovan_training", "name":"Training Contact", "color":"#FC3", "desc":"Masked training-control contacts"})

    if training_side is not None:
        side_set_display_name(training_side, "Training Contact")
        side_set_description(training_side, "Masked training-control contacts")
        side_set_icon_color(training_side, "#FC3")

    ->END

=== khovan_reach_setup_artemis_player_ship ===
    await task_schedule(spawn_players)
    await task_schedule(default_player_friendly_eyes)

    player_objects = sorted(to_object_list(role("__player__") & role("tsn")), key=lambda p: p.id)
    artemis_object = None

    for player_ship in player_objects:
        if player_ship.name == artemis_ship_name:
            artemis_object = player_ship

    if artemis_object is None and len(player_objects) > 0:
        artemis_object = player_objects[0]
        artemis_object.name = artemis_ship_name

    if artemis_object is None:
        artemis_id = 0
        log("TODO player ship: no TSN player ship was available after spawn_players; verify PLAYER_LIST/PLAYER_COUNT settings and LegendaryMissions.fleets mastlib loading.")
        ->END

    artemis_id = artemis_object.id
    artemis_object.update_comms_id()

    artemis_start_energy = int(1000 * artemis_start_energy_percent / 100)
    set_data_set_value(artemis_id, "energy", artemis_start_energy, 0)
    set_data_set_value(artemis_id, "Homing_NUM", artemis_start_homing_torpedoes, 0)
    set_data_set_value(artemis_id, "Nuke_NUM", artemis_start_nukes, 0)
    set_data_set_value(artemis_id, "EMP_NUM", artemis_start_emps, 0)
    set_data_set_value(artemis_id, "Mine_NUM", artemis_start_mines, 0)

    artemis_object.pos = Vec3(0, 0, 500)

    if kestrel_yards_id != 0:
        link(artemis_id, "extra_scan_source", kestrel_yards_id)
        docking_set_docking_logic(artemis_id, kestrel_yards_id, docking_dock_not_allowed)
        artemis_object.data_set.set("dock_base_id", kestrel_yards_id, 0)
        artemis_object.data_set.set("dock_state", "docked", 0)
        artemis_object.data_set.set("playerThrottle", 0, 0)
        task_schedule(khovan_reach_hold_artemis_at_kestrel_until_clearance)

    if tarsis_station_id != 0:
        link(artemis_id, "extra_scan_source", tarsis_station_id)
        docking_set_docking_logic(artemis_id, tarsis_station_id, khovan_dock_with_stock_station_release)

    log(f"Artemis player ship bound to id {artemis_id}. Verified start values applied; docked at Kestrel Yards pending departure clearance.")
    ->END

//enable/comms if has_roles(COMMS_ORIGIN_ID, "__player__") and COMMS_ORIGIN_ID == COMMS_SELECTED_ID
    selected_player_ship = to_object(COMMS_SELECTED_ID)
    if selected_player_ship is not None:
        selected_player_ship.update_comms_id()
        sbs.send_comms_selection_info(COMMS_ORIGIN_ID, "", "white", selected_player_ship.name)

//comms if has_roles(COMMS_ORIGIN_ID, "__player__") and COMMS_ORIGIN_ID == COMMS_SELECTED_ID
    selected_player_ship = to_object(COMMS_SELECTED_ID)
    if selected_player_ship is not None:
        selected_player_ship.update_comms_id()
        sbs.send_comms_selection_info(COMMS_ORIGIN_ID, "", "white", selected_player_ship.name)
    + "Khovan Internal Channel" if False:
        comms_receive_internal("Artemis internal channel is online.", from_name="Artemis")
=== khovan_reach_setup_dialogue_npcs ===
    dillon_face = random_terran(civilian=False)
    existing_dillon_npcs = to_object_list(role("khovan_dillon_npc"))
    if len(existing_dillon_npcs) > 0:
        dillon_npc_id = existing_dillon_npcs[0].id
        set_face(dillon_npc_id, dillon_face)
    else:
        dillon_npc = lifeform_spawn("Master Sergeant Dillon", dillon_face, "tsn, khovan_dialogue_npc, khovan_dillon_npc", artemis_id, path=None, title_color="green")
        dillon_npc_id = to_id(dillon_npc)

    anderson_face = random_terran(civilian=False)
    existing_anderson_npcs = to_object_list(role("khovan_anderson_npc"))
    if len(existing_anderson_npcs) > 0:
        anderson_npc_id = existing_anderson_npcs[0].id
        set_face(anderson_npc_id, anderson_face)
    else:
        anderson_npc = lifeform_spawn("Admiral Anderson", anderson_face, "tsn, khovan_dialogue_npc, khovan_anderson_npc", 0, path=None, title_color="blue")
        anderson_npc_id = to_id(anderson_npc)

    log(f"Dialogue NPC text stand-ins ready: Dillon id {dillon_npc_id}, Anderson id {anderson_npc_id}.")
    ->END

