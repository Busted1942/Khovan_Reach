    + "Training Control: Confirm 13 One DAMCON Team Resting" khovan_drill_2_confirm_damcon_rest if current_scene == 3 and drill_2_sequence_step == 13
    + "Training Control: Confirm 14 Weapon Heat Resolved" khovan_drill_2_confirm_heat_zero if current_scene == 3 and drill_2_sequence_step == 14
    + "Training Control: Confirm 15 Engineering Released" khovan_drill_2_confirm_engineering_released if current_scene == 3 and drill_2_sequence_step == 15
