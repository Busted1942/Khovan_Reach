# Khovan Reach Act I scaffold
# Scenes 1-4 from design_docs/khovan_reach_pass1.md

=== scene_01_departure_and_briefing ===
    current_scene = 1
    mission_phase = "act_1"

    log("Scene 1 armed: Departure and briefing at Kestrel Yards.")
    # TODO: Implement on-screen text with NPC portraits for the opening briefing once the display pattern is validated. For now, the log carries GM prompts for playtesting.
    # TODO: Trigger existing Dillon Clip 1 after clip playback syntax is validated.
    dillon_opening_briefing_run_id += 1
    task_schedule(khovan_reach_play_dillon_opening_text, {"opening_briefing_run_id": dillon_opening_briefing_run_id})

    log("GM prompt: Artemis is on the Kestrel Yards launch ramp. Captain takes the chair and calls station readiness.")
    await delay_sim(seconds=1)
    log("GM prompt: Comms requests departure clearance from Kestrel Yards Control.")
    await delay_sim(seconds=1)
    log("GM prompt: Helm clears the Kestrel launch envelope and sets course for Tarsis Station.")
    await delay_sim(seconds=1)
    ->END

=== khovan_reach_play_dillon_opening_text ===
    default opening_briefing_run_id = dillon_opening_briefing_run_id
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_dillon_text, {"banner": "Opening Briefing", "message": "Captain. Crew of Artemis.", "time": 5})
    await delay_sim(seconds=4)
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_dillon_text, {"banner": "Opening Briefing", "message": "This is a qualification cruise. Your first cruise together as a crew on this ship. Standard pattern: depart Kestrel, dock and resupply at Tarsis, conduct two skill drills in the adjacent operating area, return for debrief.", "time": 11})
    await delay_sim(seconds=10)
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_dillon_text, {"banner": "Opening Briefing", "message": "Expected duration: four standard hours.", "time": 6})
    await delay_sim(seconds=5)
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_dillon_text, {"banner": "Opening Briefing", "message": "I'll be observing. Standard observational framework: each station will be evaluated across operational tasks. The framework is internal; you don't need to track it.", "time": 11})
    await delay_sim(seconds=10)
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_dillon_text, {"banner": "Opening Briefing", "message": "Run the cruise. Do your jobs. I'll handle the rest.", "time": 7})
    await delay_sim(seconds=7)
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_dillon_text, {"banner": "Opening Briefing", "message": "Rules of engagement: defensive posture, hail before any escalation, standard TSN protocol. No live combat is anticipated.", "time": 9})
    await delay_sim(seconds=8)
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_dillon_text, {"banner": "Opening Briefing", "message": "Captain, the ship is yours.", "time": 6})
    await delay_sim(seconds=5)
    if opening_briefing_run_id != dillon_opening_briefing_run_id:
        ->END
    await task_schedule(khovan_reach_objective_text, {"banner": "Departure Step", "message": "Comms: select Kestrel Yards and choose Request Departure Clearance. Artemis remains held at Kestrel until that clearance is logged.", "time": 24})
    ->END

=== scene_02_drill_one_dock_and_resupply ===
    current_scene = 2
    mission_phase = "act_1"
    drill_1_complete = False
    drill_1_retry_occurred = False
    drill_1_docking_clearance_granted = False
    drill_1_docked_at_tarsis = False
    drill_1_docked_without_clearance_notice = False

    log("Scene 2 armed: Drill One - dock and resupply at Tarsis Station.")
    # TODO: Trigger existing Dillon Clip 2 after clip playback syntax is validated.
    log("GM cue: Play Dillon Clip 2 - Drill One Intro.")
    log("Drill One objective text will be sent when Kestrel grants departure clearance.")

    log("GM prompt: Artemis enters the Tarsis approach lane on Helm vector.")
    await delay_sim(seconds=1)
    log("GM prompt: Comms hails Tarsis Docking Control and requests docking clearance.")
    await delay_sim(seconds=1)
    log("GM prompt: Engineering confirms docking-safe power posture; shields down, impulse reduced.")
    await delay_sim(seconds=1)
    log("GM prompt: Weapons confirms weapons hold during docking proximity.")
    await delay_sim(seconds=1)
    log("GM prompt: Captain coordinates final docking and resupply order once the station sequence is clean.")
    log("Scene 2 objective: hail Tarsis, request docking clearance, then dock with Tarsis Station to complete Drill One.")
    log("GM note: This playable slice currently ends after the Act I qualification drills.")
    ->END

=== khovan_reach_complete_drill_1_resupply ===
    default ship_id = artemis_id

    if ship_id == 0:
        log("Drill One resupply could not run: no Artemis ship id is bound.")
        ->END

    if drill_1_complete:
        ->END

    set_data_set_value(ship_id, "energy", drill_1_full_energy, 0)
    set_data_set_value(ship_id, "Homing_NUM", drill_1_full_homing_torpedoes, 0)
    set_data_set_value(ship_id, "Nuke_NUM", drill_1_full_nukes, 0)
    set_data_set_value(ship_id, "EMP_NUM", drill_1_full_emps, 0)
    set_data_set_value(ship_id, "Mine_NUM", drill_1_full_mines, 0)

    drill_1_complete = True
    drill_1_docked_at_tarsis = True
    drill_2_waiting_for_tarsis_release = True
    last_checkpoint = "drill_1_complete"

    if drill_1_retry_occurred:
        log("GM cue: Play Dillon Clip 3 Variant B - Drill One Complete after retry.")
    else:
        log("GM cue: Play Dillon Clip 3 Variant A - Drill One Complete.")

    log("Drill One complete: Artemis resupplied to energy 100%, torpedoes 8 homing / 2 nukes / 2 EMPs / 2 mines. Checkpoint marker set to drill_1_complete.")
    await task_schedule(khovan_reach_objective_text, {"banner": "Drill One Complete", "message": "Drill One complete. Release docking from Tarsis Station to begin Drill Two. Training Control will walk Engineering, Helm, Science, Comms, and Weapons through the next sequence by Comms confirmations.", "time": 28})
    ->END

=== khovan_reach_mark_drill_1_retry ===
    drill_1_retry_occurred = True
    log("Drill One retry flag set.")
    ->END

//shared/signal/docked if has_roles(ORIGIN_ID, "__player__") and has_roles(SELECTED_ID, "tarsis_station")
    if current_scene != 2:
        ->END

    if not drill_1_docking_clearance_granted:
        await task_schedule(khovan_reach_objective_text, {"banner": "Drill One Hold", "message": "Docking detected, but Drill One is not complete. Comms must select Tarsis Station and use Request Docking Clearance before the resupply drill completes.", "time": 24})
        log("Scene 2 trigger: Artemis docked with Tarsis before docking clearance was logged. Drill One is not complete.")
        ->END

    await task_schedule(khovan_reach_complete_drill_1_resupply, {"ship_id": ORIGIN_ID})
    log("Scene 2 trigger: Artemis docked with Tarsis after clearance. Drill One completion and resupply scheduled.")
    ->END

