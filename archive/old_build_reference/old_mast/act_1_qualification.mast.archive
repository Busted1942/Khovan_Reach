    yield success

=== khovan_reach_refresh_drill_2_step ===
    if not drill_2_science_classification_complete:
        drill_2_current_step = 1
    elif not drill_2_comms_hail_complete:
        drill_2_current_step = 2
    elif not drill_2_captain_posture_check:
        drill_2_current_step = 3
    elif not drill_2_helm_geometry_check:
        drill_2_current_step = 4
    elif not drill_2_engineering_boost_check:
        drill_2_current_step = 5
    elif not drill_2_weapons_ready_check or not drill_2_ready_posture_reported:
        drill_2_current_step = 6
    elif not drill_2_fire_authorized_check:
        drill_2_current_step = 7
    elif not drill_2_weapons_subsystem_disabled:
        drill_2_current_step = 8
    elif not drill_2_ceasefire_check:
        drill_2_current_step = 9
    elif not drill_2_verification_check:
        drill_2_current_step = 10
    else:
        drill_2_current_step = 11

    log(f"Drill Two current step marker: {drill_2_current_step}.")
    ->END

=== khovan_reach_mark_drill_2_weapons_disabled ===
    default source = "controlled fire"
    if source == "GM fallback" and not drill_2_fire_authorized_check:
        log("Drill Two GM fallback ignored: Weapons subsystem disable cannot be marked before controlled-fire authorization.")
        ->END

    if drill_2_weapons_subsystem_disabled:
        ->END

    drill_2_weapons_subsystem_disabled = True
    if artemis_id != 0:
        set_weapons_selection(artemis_id, 0)
    await task_schedule(khovan_reach_refresh_drill_2_step)
    task_schedule(khovan_reach_drill_2_announce_weapons_disabled)
    log(f"Drill Two trigger: Drone 01 Weapons subsystem disabled by {source}. Ceasefire cue sent.")
    ->END

=== khovan_reach_drill_2_announce_weapons_disabled ===
    if artemis_id != 0:
        comms_broadcast(artemis_id, "Drone 01 Weapons disabled. CEASE FIRE. Comms: confirm ceasefire with Training Control.", "green")
    for gui in role("__gui__"):
        gui_info_panel_send_message(gui, "Drone 01 Weapons subsystem disabled. CEASE FIRE. Captain, call ceasefire now. Weapons, hold fire. Comms, confirm ceasefire with Training Control.", banner="Ceasefire", banner_color="green", title="Dillon Training Control", title_color="green", history=True, time=24)
    ->END

=== khovan_reach_try_complete_drill_2 ===
    if drill_2_complete:
        ->END

    await task_schedule(khovan_reach_refresh_drill_2_step)

    if drill_2_drone_destroyed:
        drill_2_result = "retry_destroyed"
        log("Drill Two cannot complete: Drone 01 was destroyed. Drill Two is restarting with a fresh drone.")
        ->END

    if not drill_2_science_classification_complete:
        ->END
    if not drill_2_comms_hail_complete:
        ->END
    if not drill_2_captain_posture_check:
        ->END
    if not drill_2_helm_geometry_check:
        ->END
    if not drill_2_engineering_boost_check:
        ->END
    if not drill_2_weapons_ready_check:
        ->END
    if not drill_2_fire_authorized_check:
        ->END
    if not drill_2_weapons_subsystem_disabled:
        ->END
    if not drill_2_ceasefire_check:
        ->END
    if not drill_2_verification_check:
        ->END

    drill_2_complete = True
    drill_2_result = "complete"
    last_checkpoint = "drill_2_complete"

    # TODO: Trigger existing Dillon Clip 5 after clip playback syntax is validated.
    log("GM cue: Play Dillon Clip 5 - Drill Two Complete / Guided sequence complete.")

    if drill_2_drone_id != 0:
        target_pos(drill_2_drone_id, 52000, 0, 16000, 1.0, 0, 0)

    log("Drill Two complete: Drone 01 Weapons subsystem disabled, ceasefire confirmed, and final verification complete. Checkpoint marker set to drill_2_complete.")
    task_schedule(scene_04_drill_three_subsystem_targeting)
    ->END

//damage/object if has_role(DAMAGE_TARGET_ID, "khovan_drill_2_contact")
    if current_scene != 3:
        ->END

    if not drill_2_fire_authorized_check:
        drill_2_fire_before_authorized = True
        drill_2_result = "fire_before_authorized"
        log("Drill Two safety flag: Drone 01 was hit before controlled fire authorization.")
        ->END

    if drill_2_weapons_subsystem_disabled:
        if artemis_id != 0:
            set_weapons_selection(artemis_id, 0)
        set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM", None)
        set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_CRITICAL_HIT", None)
        log("Drill Two safety flag: Drone 01 took additional damage after Weapons disabled cue.")
        ->END

    system = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM")
    target_id = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_CRITICAL_HIT")

    if target_id != 0:
        set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM", None)
        set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_CRITICAL_HIT", None)

        ->END if target_id != DAMAGE_TARGET_ID
        ->END if system is None
        ->END if target_id is None

        t = to_object(target_id)
        ->END if t is None

        max_damage = t.data_set.get("system_max_damage", system)
        cur = t.data_set.get("system_damage", system)
        if cur < 1:
            cur = 1
        up = cur * 1.35
        t.data_set.set("system_damage", up, system)

        if system == sbs.SHPSYS.WEAPONS and up > max_damage:
            await task_schedule(khovan_reach_mark_drill_2_weapons_disabled, {"source": "manual Weapons subsystem damage"})
            await task_schedule(khovan_reach_try_complete_drill_2)
        else:
            log(f"Drill Two subsystem hit recorded on {system.name}; objective remains Weapons subsystem disable.")
        ->END

    drill_2_authorized_damage_count += 1
    if drill_2_authorized_damage_count >= 1:
        await task_schedule(khovan_reach_mark_drill_2_weapons_disabled, {"source": "controlled weapon damage"})
        await task_schedule(khovan_reach_try_complete_drill_2)

    ->END

//damage/destroy if has_role(DESTROYED_ID, "khovan_drill_2_contact")
    drill_2_drone_destroyed = True
    if not drill_2_complete:
        drill_2_result = "retry_destroyed"
        drill_2_retry_count += 1
        log(f"Drill Two reset: Drone 01 destroyed. Cleaning up old object and respawning replacement 1 km farther from Tarsis. Retry count: {drill_2_retry_count}.")
        remove_role(DESTROYED_ID, "khovan_drill_2_contact")
        remove_role(DESTROYED_ID, "khovan_drill_drone")
        if artemis_id != 0:
            set_weapons_selection(artemis_id, 0)
            set_science_selection(artemis_id, 0)
            set_comms_selection(artemis_id, 0)
        if drill_2_navproxy_id != 0:
            sim.delete_navproxy_by_id(drill_2_navproxy_id)
            drill_2_navproxy_id = 0
        sbs.delete_object(DESTROYED_ID)
        drill_2_drone_id = 0
        task_schedule(khovan_reach_restart_drill_2_after_destroy)
    ->END

=== khovan_reach_restart_drill_2_after_destroy ===
    await delay_sim(seconds=3)
    if current_scene != 3:
        ->END
    if drill_2_complete:
        ->END
    await task_schedule(scene_03_drill_two_threat_identification)
    ->END

=== scene_04_drill_three_subsystem_targeting ===
    if drill_3_complete:
        ->END

    current_scene = 4
    mission_phase = "act_1"
    drill_3_started = True
    drill_3_evasion_active = True
    drill_3_science_observed = False
    drill_3_comms_observed = False
    drill_3_captain_authorized = False
    drill_3_helm_observed = False
    drill_3_engineering_observed = False
    drill_3_weapons_lock_observed = False
    drill_3_weapons_ready_observed = False
    drill_3_engine_subsystem_disabled = False
    drill_3_ceasefire_confirmed = False
    drill_3_fire_before_authorized = False
    drill_3_drone_destroyed = False
    drill_3_help_prompt_used = False
    drill_3_result = "pending"

    log("Scene 4 armed: Drill Three - unguided evasive live-fire repeat / Engine disable.")
    # TODO: Trigger existing Dillon Clip 6 after clip playback syntax is validated.
    log("GM cue: Play Dillon Clip 6 - Drill Three Intro / Now You Do It.")

    existing_drill_3_drones = to_object_list(role("khovan_drill_3_contact"))
    if len(existing_drill_3_drones) > 0:
        drill_3_drone_id = existing_drill_3_drones[0].id
    else:
        drill_3_spawn_x = 36000 + (drill_3_retry_count * 1000)
        drill_3_drone = npc_spawn(drill_3_spawn_x, 0, -9000, "Drill Drone 02", "khovan_training, neutral, khovan_drill_drone, khovan_drill_3_contact", "tsn_warpster", "behav_npcship")
        drill_3_drone_id = to_id(drill_3_drone)
        drill_3_navproxy = sim.add_navproxy(drill_3_drone_id, "Drill Drone 02", "tsn_warpster", "#FC3")
        drill_3_navproxy_id = to_id(drill_3_navproxy)

    if artemis_id != 0 and drill_3_drone_id != 0:
        link(artemis_id, "extra_scan_source", drill_3_drone_id)

    drill_3_evasion_run_id += 1
    task_schedule(khovan_drill_3_evasion_loop, {"evasion_run_id": drill_3_evasion_run_id})
    log("Drill Three objective: repeat the contact-handling sequence without step calls. Disable Drone 02 Engine subsystem and confirm ceasefire.")
    log("GM note: Process quality is recorded for debrief; runtime completion requires Engine subsystem disabled plus ceasefire confirmed.")
    ->END

=== khovan_drill_3_evasion_loop ===
    default evasion_run_id = drill_3_evasion_run_id
    if current_scene != 4:
        ->END
    if drill_3_complete:
        ->END
    if not drill_3_evasion_active:
        ->END
    if evasion_run_id != drill_3_evasion_run_id:
        ->END
    if drill_3_drone_id == 0:
        ->END

    target_pos(drill_3_drone_id, 38500, 0, -6000, throttle=0.8, target_id=0, stop_dist=600)
    await delay_sim(seconds=18)
    if current_scene != 4:
        ->END
    if drill_3_complete:
        ->END
    if not drill_3_evasion_active:
        ->END
    if evasion_run_id != drill_3_evasion_run_id:
        ->END
    target_pos(drill_3_drone_id, 33000, 0, -12500, throttle=0.8, target_id=0, stop_dist=600)
    await delay_sim(seconds=18)
    jump khovan_drill_3_evasion_loop

//enable/science if has_roles(SCIENCE_SELECTED_ID, "khovan_drill_3_contact") and current_scene == 4

//science if has_roles(SCIENCE_SELECTED_ID, "khovan_drill_3_contact") and current_scene == 4
    + "scan":
        drill_3_science_observed = True
        <scan>
            % Drill Drone 02. Training-control transponder active. Contact is maneuvering under simple evasion.
    + "intel":
        drill_3_science_observed = True
        <scan>
            % Objective package: Engine subsystem disable. Simulated shield profile available for beam tuning. Process quality is observed, but Engine disable plus ceasefire is the runtime gate.
    + "bio":
        drill_3_science_observed = True
        <scan>
            % Unmanned training drone. No crew life signs.

//enable/comms if has_roles(COMMS_SELECTED_ID, "khovan_drill_3_contact") and current_scene == 4

//comms if has_roles(COMMS_SELECTED_ID, "khovan_drill_3_contact") and current_scene == 4
    + "Khovan Dev Jumps" //comms/gamemaster/khovan_dev_jumps if has_roles(COMMS_ORIGIN_ID, "gamemaster")
    + "Monitor Training Broadcast" khovan_drill_3_monitor_broadcast
    + "Confirm Drill Three Ceasefire" khovan_drill_3_confirm_ceasefire

=== khovan_drill_3_monitor_broadcast ===
    drill_3_comms_observed = True
    comms_receive(f"""Automated broadcast: Drill Drone 02 maneuvering. Objective package is Engine subsystem disable. Training Control is monitoring for ceasefire after objective completion.""", title="Drill Drone 02", title_color="green")
    yield success

=== khovan_drill_3_confirm_ceasefire ===
    if not drill_3_engine_subsystem_disabled:
        comms_receive(f"""Ceasefire report not accepted yet. Engine subsystem disable is not confirmed.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    drill_3_ceasefire_confirmed = True
    await task_schedule(khovan_reach_try_complete_drill_3)
    comms_receive(f"""Ceasefire confirmed. Training Control is checking the Drill Three completion gate.""", title="Dillon Training Control", title_color="green")
    yield success

=== khovan_reach_try_complete_drill_3 ===
    if drill_3_complete:
        ->END

    if drill_3_drone_destroyed and not drill_3_engine_subsystem_disabled:
        drill_3_result = "failed_overfire"
        log("Drill Three cannot complete: Drone 02 destroyed before Engine subsystem disable confirmation.")
        ->END

    if not drill_3_engine_subsystem_disabled:
        ->END
    if not drill_3_ceasefire_confirmed:
        ->END

    drill_3_complete = True
    drill_3_result = "complete"
    last_checkpoint = "drill_3_complete"

    # TODO: Trigger existing Dillon Clip 7 after clip playback syntax is validated.
    log("GM cue: Play Dillon Clip 7 - Drill Three Complete.")
    log("Drill Three complete: Drone 02 Engine subsystem disabled and ceasefire confirmed. Checkpoint marker set to drill_3_complete.")
    task_schedule(scene_05_new_orders)
    log("Act I drill slice complete. Anderson diversion orders scheduled as Scene 5 text.")
    ->END

//damage/object if has_role(DAMAGE_TARGET_ID, "khovan_drill_3_contact")
    if current_scene != 4:
        ->END

    if not drill_3_captain_authorized:
        drill_3_fire_before_authorized = True
        log("Drill Three observation: Drone 02 was hit before Captain fire authorization was marked. This is a debrief observation, not an automatic runtime blocker.")

    system = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM")
    target_id = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_CRITICAL_HIT")
    ->END if target_id == 0

    set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM", None)
    set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_CRITICAL_HIT", None)

    ->END if target_id != DAMAGE_TARGET_ID
    ->END if system is None
    ->END if target_id is None

    t = to_object(target_id)
    ->END if t is None

    max_damage = t.data_set.get("system_max_damage", system)
    cur = t.data_set.get("system_damage", system)
    if cur < 1:
        cur = 1
    up = cur * 1.35
    t.data_set.set("system_damage", up, system)

    if system == sbs.SHPSYS.ENGINES and up > max_damage:
        drill_3_engine_subsystem_disabled = True
        log("Drill Three trigger: Drone 02 Engine subsystem disabled by manual subsystem damage.")
        await task_schedule(khovan_reach_try_complete_drill_3)
    else:
        log(f"Drill Three subsystem hit recorded on {system.name}; objective remains Engine subsystem disable.")

    ->END

//damage/destroy if has_role(DESTROYED_ID, "khovan_drill_3_contact")
    drill_3_drone_destroyed = True
    if not drill_3_complete:
        drill_3_result = "retry_destroyed"
        drill_3_retry_count += 1
        log(f"Drill Three reset: Drone 02 destroyed. Cleaning up old object and respawning replacement 1 km farther from Tarsis. Retry count: {drill_3_retry_count}.")
        remove_role(DESTROYED_ID, "khovan_drill_3_contact")
        remove_role(DESTROYED_ID, "khovan_drill_drone")
        if artemis_id != 0:
            set_weapons_selection(artemis_id, 0)
            set_science_selection(artemis_id, 0)
            set_comms_selection(artemis_id, 0)
        if drill_3_navproxy_id != 0:
            sim.delete_navproxy_by_id(drill_3_navproxy_id)
            drill_3_navproxy_id = 0
        sbs.delete_object(DESTROYED_ID)
        drill_3_drone_id = 0
        task_schedule(khovan_reach_restart_drill_3_after_destroy)
    ->END

=== khovan_reach_restart_drill_3_after_destroy ===
    await delay_sim(seconds=3)
    if current_scene != 4:
        ->END
    if drill_3_complete:
        ->END
    await task_schedule(scene_04_drill_three_subsystem_targeting)
    ->END

//select/weapons if has_role(WEAPONS_ORIGIN_ID, "__player__")
    if current_scene == 3:
        if drill_2_drone_id == 0:
            ->END

        selected_weapons_target_id = get_weapons_selection(WEAPONS_ORIGIN_ID)
        if selected_weapons_target_id == drill_2_drone_id and not drill_2_weapons_lock_complete:
            drill_2_weapons_lock_complete = True
            log("Scene 3 trigger: Weapons selected/locked Drone 01. TODO: beam frequency tuning and manual subsystem selection APIs are not fully verified; GM marks Weapons ready after observing tuning/subtarget/no-fire discipline.")
            await task_schedule(khovan_reach_refresh_drill_2_step)

    if current_scene == 4:
        if drill_3_drone_id == 0:
            ->END

        selected_weapons_target_id = get_weapons_selection(WEAPONS_ORIGIN_ID)
        if selected_weapons_target_id == drill_3_drone_id and not drill_3_weapons_lock_observed:
            drill_3_weapons_lock_observed = True
            log("Scene 4 observation: Weapons selected/locked Drone 02.")

    ->END
