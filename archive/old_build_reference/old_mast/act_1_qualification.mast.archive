=== khovan_drill_2_report_ready_posture ===
    if current_scene != 3:
        comms_receive(f"""Training Control is not accepting Drill Two ready posture reports at this time.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if drill_2_complete:
        comms_receive(f"""Drill Two is already marked complete. Hold weapons and await further instruction.""", title="Dillon Training Control", title_color="green")
        yield success

    if not drill_2_science_classification_complete:
        comms_receive(f"""Ready posture not accepted. Science classification is not complete.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if not drill_2_comms_hail_complete:
        comms_receive(f"""Ready posture not accepted. Standard-band hail has not been logged.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    dist = sbs.distance_id(artemis_id, drill_2_drone_id)
    selected_weapons_target_id = get_weapons_selection(artemis_id)

    if selected_weapons_target_id != drill_2_drone_id:
        comms_receive(f"""Ready posture not accepted. Weapons must lock Drone 01 before the ready hold begins.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if dist < 1000:
        comms_receive(f"""Ready posture not accepted. Artemis is {dist:.0f} m from Drone 01; hold just outside beam range, at least 1 km.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if dist > 2000:
        comms_receive(f"""Ready posture not accepted. Artemis is {dist:.0f} m from Drone 01; close to the 1-2 km ready band while keeping beams out of auto-fire range.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if not drill_2_engineering_boost_check:
        comms_receive(f"""Ready posture not accepted. Complete the guided Engineering sequence through Comms before reporting ready posture.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    drill_2_captain_posture_check = True
    drill_2_helm_geometry_check = True
    drill_2_weapons_lock_complete = True
    drill_2_weapons_ready_check = True
    drill_2_ready_posture_reported = True

    if not drill_2_authorization_hold_started and not drill_2_fire_authorized_check:
        drill_2_authorization_hold_started = True
        drill_2_authorization_hold_ready = False
        drill_2_authorization_hold_run_id += 1
        task_schedule(khovan_reach_drill_2_authorization_hold, {"authorization_hold_run_id": drill_2_authorization_hold_run_id})

    comms_receive(f"""Ready posture accepted at {dist:.0f} m. Hold Drone 01 lock outside beam range for 15 seconds, then check controlled-fire authorization.""", title="Dillon Training Control", title_color="green")
    task_schedule(khovan_reach_refresh_drill_2_step)
    yield success

=== khovan_reach_drill_2_authorization_hold ===
    default authorization_hold_run_id = drill_2_authorization_hold_run_id
    await delay_sim(seconds=15)

    if current_scene != 3:
        ->END
    if drill_2_complete:
        ->END
    if authorization_hold_run_id != drill_2_authorization_hold_run_id:
        ->END
    if not drill_2_authorization_hold_started:
        ->END
    if drill_2_drone_id == 0:
        drill_2_authorization_hold_started = False
        drill_2_authorization_hold_ready = False
        ->END

    dist = sbs.distance_id(artemis_id, drill_2_drone_id)
    selected_weapons_target_id = get_weapons_selection(artemis_id)
    if selected_weapons_target_id == drill_2_drone_id and dist >= 1000 and dist <= 2000 and not drill_2_fire_before_authorized:
        drill_2_authorization_hold_ready = True
        log(f"Drill Two 15-second ready hold complete at {dist:.0f} m. Comms can now check controlled-fire authorization.")
        await task_schedule(khovan_reach_refresh_drill_2_step)
    else:
        drill_2_ready_posture_reported = False
        drill_2_fire_authorized_check = False
        drill_2_authorization_hold_started = False
        drill_2_authorization_hold_ready = False
        log(f"Drill Two ready hold failed. Range {dist:.0f} m, locked target {selected_weapons_target_id}; report ready posture again from 1-2 km with Drone 01 locked.")

    ->END

=== khovan_drill_2_check_fire_authorization ===
    if current_scene != 3:
        comms_receive(f"""Training Control is not accepting Drill Two fire authorization checks at this time.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if not drill_2_ready_posture_reported:
        comms_receive(f"""Controlled fire is not authorized. Report ready posture first.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if not drill_2_authorization_hold_started:
        comms_receive(f"""Controlled fire is not authorized. Report ready posture to begin the 15-second hold.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if not drill_2_authorization_hold_ready:
        comms_receive(f"""Controlled fire is not authorized yet. Maintain Drone 01 lock at 1-2 km until the 15-second hold completes, then check again.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    dist = sbs.distance_id(artemis_id, drill_2_drone_id)
    selected_weapons_target_id = get_weapons_selection(artemis_id)
    if selected_weapons_target_id != drill_2_drone_id or dist < 1000 or dist > 2000:
        drill_2_ready_posture_reported = False
        drill_2_authorization_hold_started = False
        drill_2_authorization_hold_ready = False
        comms_receive(f"""Controlled fire is not authorized. Ready hold broke before authorization check: range {dist:.0f} m, locked target {selected_weapons_target_id}. Re-establish 1-2 km lock and report ready posture again.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    drill_2_fire_authorized_check = True
    drill_2_authorization_hold_started = False
    drill_2_authorization_hold_ready = False
    comms_receive(f"""Controlled fire authorized. Weapons: load homing torpedoes, close into beam range, and fire only to disable Drone 01's Weapons subsystem. Captain, call ceasefire immediately when Training Control reports Weapons disabled.""", title="Dillon Training Control", title_color="green")
    task_schedule(khovan_reach_refresh_drill_2_step)
    task_schedule(khovan_reach_objective_text, {"banner": "Controlled Fire", "message": "Weapons: load homing torpedoes, close into beam range, and fire only until Drone 01 Weapons is disabled. Captain: call ceasefire as soon as Training Control reports Weapons disabled.", "time": 24})
    yield success

=== khovan_drill_2_confirm_ceasefire ===
    if current_scene != 3:
        comms_receive(f"""Training Control is not accepting Drill Two ceasefire reports at this time.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    if not drill_2_weapons_subsystem_disabled:
        comms_receive(f"""Ceasefire report not accepted yet. Drone 01 Weapons subsystem disable is not confirmed.""", title="Dillon Training Control", title_color="yellow")
        yield fail

    drill_2_ceasefire_check = True
    comms_receive(f"""Ceasefire confirmed. Weapons hold logged. Science and Comms may complete final verification.""", title="Dillon Training Control", title_color="green")
    task_schedule(khovan_reach_refresh_drill_2_step)
    task_schedule(khovan_reach_try_complete_drill_2)
    yield success

=== khovan_drill_2_report_final_verification ===
    if current_scene != 3:
