=== khovan_kestrel_hail ===
    if not kestrel_departure_clearance_granted:
        comms_receive(f"""Artemis, Kestrel Yards Control. You are still inside the refit-yard control zone. Docking and weapon privileges are not available here. Request departure clearance when your crew is ready to release from the yard.""", title="Kestrel Yards Control", title_color="green")
        yield success

    comms_receive(f"""Artemis, Kestrel Yards Control. Departure clearance is logged. Continue outbound and proceed to Tarsis Station for Drill One.""", title="Kestrel Yards Control", title_color="green")
    yield success

=== khovan_kestrel_request_departure_clearance ===
    kestrel_departure_clearance_granted = True
    artemis_object = to_object(artemis_id)
    if artemis_object is not None:
        current_dock_base_id = artemis_object.data_set.get("dock_base_id", 0)
        if current_dock_base_id == kestrel_yards_id:
            artemis_object.data_set.set("dock_base_id", 0, 0)
            artemis_object.data_set.set("dock_state", "undocked", 0)
            artemis_object.data_set.set("playerThrottle", 0, 0)
    comms_receive(f"""Artemis, Kestrel Yards Control. Departure clearance granted. Mooring clamps released. Clear the launch envelope and proceed to Tarsis Station for Drill One.""", title="Kestrel Yards Control", title_color="green")
    await task_schedule(khovan_reach_objective_text, {"banner": "Departure Cleared", "message": "Helm: proceed to Tarsis Station. Comms: select Tarsis Station, use Hail Tarsis Station, then choose Request Docking Clearance. After clearance, dock normally; priority docking is not part of this drill.", "time": 28})
    yield success

//enable/comms if has_roles(COMMS_SELECTED_ID, "tarsis_station")

//comms if has_roles(COMMS_SELECTED_ID, "tarsis_station")
    + "Khovan Dev Jumps" //comms/gamemaster/khovan_dev_jumps if has_roles(COMMS_ORIGIN_ID, "gamemaster")
    + "Hail Tarsis Station" khovan_tarsis_hail
    + "Request Docking Clearance" khovan_tarsis_request_docking_clearance

=== khovan_tarsis_hail ===
    comms_receive(f"""Artemis, Tarsis Station. We read you. Docking Control has the Drill One lane standing by.""", title="Tarsis Station", title_color="green")
    yield success

=== khovan_tarsis_request_docking_clearance ===
    if current_scene != 2:
        comms_receive(f"""Artemis, Tarsis Station. Docking Control is standing by for Drill One.""", title="Tarsis Docking Control", title_color="green")
        yield success

    if not kestrel_departure_clearance_granted:
        comms_receive(f"""Artemis, Tarsis Docking Control. We do not have Kestrel departure clearance in the drill log. Request clearance from Kestrel Yards before entering the Tarsis drill lane.""", title="Tarsis Docking Control", title_color="yellow")
        yield fail

    drill_1_docking_clearance_granted = True
    comms_receive(f"""Artemis, Tarsis Docking Control. Drill traffic is clear. Approach on assigned vector, reduce to maneuvering thrust, and close to 500 meters or less for hard dock.""", title="Tarsis Docking Control", title_color="green")
    await task_schedule(khovan_reach_objective_text, {"banner": "Docking Cleared", "message": "Helm: dock normally with Tarsis Station now. Close to 500 m or less to enter hard-dock range. Drill One completes when Artemis docks after this clearance; do not use priority docking.", "time": 24})
    yield success

=== scene_03_drill_two_threat_identification ===
    if drill_2_complete:
        ->END

    current_scene = 3
    mission_phase = "act_1"
    drill_2_started = True
    drill_2_current_step = 1
    drill_2_waiting_for_tarsis_release = False
    drill_2_sequence_started = True
    drill_2_sequence_step = 1
    drill_2_science_scan_complete = False
    drill_2_science_intel_complete = False
    drill_2_science_bio_complete = False
    drill_2_science_classification_complete = False
    drill_2_comms_hail_complete = False
    drill_2_captain_posture_check = False
    drill_2_helm_geometry_check = False
    drill_2_engineering_boost_check = False
    drill_2_weapons_lock_complete = False
    drill_2_weapons_ready_check = False
    drill_2_ready_posture_reported = False
    drill_2_authorization_hold_started = False
    drill_2_authorization_hold_ready = False
    drill_2_fire_authorized_check = False
    drill_2_weapons_subsystem_disabled = False
    drill_2_ceasefire_check = False
    drill_2_verification_check = False
    drill_2_fire_before_authorized = False
    drill_2_drone_destroyed = False
    drill_2_authorized_damage_count = 0
    drill_2_result = "pending"

    log("Scene 3 armed: Drill Two - guided contact handling and controlled Weapons disable.")
    # TODO: Trigger existing Dillon Clip 4 after clip playback syntax is validated.
    log("GM cue: Play Dillon Clip 4 - Drill Two Intro / Guided Contact Handling.")

    existing_drill_drones = to_object_list(role("khovan_drill_2_contact"))
    if len(existing_drill_drones) > 0:
        drill_2_drone_id = existing_drill_drones[0].id
    else:
        drill_2_spawn_x = 34000 + (drill_2_retry_count * 1000)
        drill_2_drone = npc_spawn(drill_2_spawn_x, 0, 8000, "Unidentified Contact", "khovan_training, neutral, khovan_drill_drone, khovan_drill_2_contact", "tsn_warpster", "behav_npcship")
        drill_2_drone_id = to_id(drill_2_drone)
        drill_2_navproxy = sim.add_navproxy(drill_2_drone_id, "Unidentified Contact", "tsn_warpster", "#FC3")
        drill_2_navproxy_id = to_id(drill_2_navproxy)

    if artemis_id != 0 and drill_2_drone_id != 0:
        link(artemis_id, "extra_scan_source", drill_2_drone_id)
        set_comms_selection(artemis_id, drill_2_drone_id)

    task_schedule(khovan_reach_objective_text, {"banner": "Drill Two Step 1", "message": "Comms: Unidentified Contact is selected. Confirm each Training Control step in order. Step 1: Engineering sets warp output to 150% and impulse output to 50%, presses S, then presses 2 to save preset 2.", "time": 30})

    log(f"Drill Two contact available: Unidentified Contact id {drill_2_drone_id}. Neutral training drone has no attack orders in Scene 3.")
    log("Training Control Step 1: Engineering sets preset 2 with warp 150% and impulse 50%.")
    await delay_sim(seconds=1)
    log("Training Control Step 2: Helm navigates on impulse, then warps heading 060 to 5 km from Tarsis Station.")
    await delay_sim(seconds=1)
    log("Training Control Step 3: Engineering restores balanced output by pressing preset 0.")
    await delay_sim(seconds=1)
    log("Training Control Step 4: Engineering sets sensors to 200% and saves preset 3.")
    await delay_sim(seconds=1)
    log("Training Control Steps 5-6: Science scans Drone 01, then Comms hails on standard bands.")
    await delay_sim(seconds=1)
    log("Training Control Steps 7-14: Engineering completes sensor cooldown, weapons output, torpedo loading observation, DAMCON assignments, overheat/repair management, rest cycle, and heat zeroing.")
    await delay_sim(seconds=1)
    log("Training Control Step 15: Engineering manages systems at Engineer and Captain discretion; Weapons locks Drone 01 and waits for controlled-fire authorization.")
    log("Drill Two objective: disable Drone 01 Weapons subsystem, confirm ceasefire, then complete Science/Comms verification.")
    ->END

//enable/science if has_roles(SCIENCE_SELECTED_ID, "khovan_drill_2_contact") and current_scene == 3

//science if has_roles(SCIENCE_SELECTED_ID, "khovan_drill_2_contact") and current_scene == 3
    + "Initial Scan":
        drill_2_science_scan_complete = True
        drill_2_science_classification_complete = True
        task_schedule(khovan_reach_refresh_drill_2_step)
        if drill_2_sequence_step < 5:
            <scan>
                % Initial scan logged early. Compact TSN-pattern hull, low emissions, weapons cold. This will satisfy the later Training Control scan gate when Comms reaches that step.
        else:
            <scan>
                % Initial scan logged. Compact TSN-pattern hull, low emissions, weapons cold. Transponder masked under training-control protocol.

    + "scan":
        drill_2_science_scan_complete = True
        drill_2_science_classification_complete = True
        task_schedule(khovan_reach_refresh_drill_2_step)
        <scan>
            % Baseline scan logged. Compact TSN-pattern hull, low emissions, weapons cold. This satisfies the Drill Two Science scan gate.

    + "intel":
        if not drill_2_science_scan_complete:
            <scan>
                % Intel package unavailable. Complete Initial Scan first.
        else:
            drill_2_science_intel_complete = True
            if drill_2_science_scan_complete and drill_2_science_intel_complete and drill_2_science_bio_complete:
                drill_2_science_classification_complete = True
                await task_schedule(khovan_reach_refresh_drill_2_step)
            <scan>
                % Classification package: TSN Drill Drone 01. Automated drill-mode controller. Simulated shield profile available for beam tuning. Targetable subsystem for this guided drill: Weapons. No live hostile posture detected.

    + "bio":
        if not drill_2_science_intel_complete:
            <scan>
                % Bio scan routing is not calibrated. Resolve Initial Scan and intel first.
        else:
            drill_2_science_bio_complete = True
            if drill_2_science_scan_complete and drill_2_science_intel_complete and drill_2_science_bio_complete:
                drill_2_science_classification_complete = True
                await task_schedule(khovan_reach_refresh_drill_2_step)
            <scan>
                % Bio scan negative. No crew life signs; contact is an unmanned training platform. Do not fire during Drill Two unless Training Control authorizes escalation.

//enable/comms if has_roles(COMMS_SELECTED_ID, "khovan_drill_2_contact") and current_scene == 3

//comms if has_roles(COMMS_SELECTED_ID, "khovan_drill_2_contact") and current_scene == 3
    + "Khovan Dev Jumps" //comms/gamemaster/khovan_dev_jumps if has_roles(COMMS_ORIGIN_ID, "gamemaster")
    + "Hail on Standard Bands" khovan_drill_2_hail if drill_2_sequence_step == 6 and drill_2_science_scan_complete

=== khovan_drill_2_confirm_preset_2 ===
    drill_2_sequence_step = 2
    comms_receive(f"""Training Control: preset 2 logged. Helm, navigate on impulse, then warp heading zero-six-zero to five kilometers from Tarsis Station.""", title="Dillon Training Control", title_color="green")
    task_schedule(khovan_reach_objective_text, {"banner": "Drill Two Step 2", "message": "Helm: navigate away from Tarsis on impulse, then warp heading 060 until Artemis is 5 km or more from Tarsis Station. Stop Artemis there; Training Control will auto-advance when the position and stop are detected.", "time": 32})
    task_schedule(khovan_drill_2_monitor_helm_transit)
    task_schedule(khovan_reach_refresh_drill_2_comms_menu, {"player_id": COMMS_ORIGIN_ID})
    yield success

=== khovan_drill_2_confirm_helm_transit ===
    drill_2_sequence_step = 3
    drill_2_helm_geometry_check = True
    comms_receive(f"""Training Control: transit logged. Engineering, restore balanced output by pressing preset zero.""", title="Dillon Training Control", title_color="green")
    task_schedule(khovan_reach_objective_text, {"banner": "Drill Two Step 3", "message": "Engineering: press 0 to restore balanced output. Comms confirms when balanced output is restored.", "time": 24})
    task_schedule(khovan_reach_refresh_drill_2_comms_menu, {"player_id": COMMS_ORIGIN_ID})
    yield success

=== khovan_reach_refresh_drill_2_comms_menu ===
    default player_id = artemis_id
    if player_id == 0:
        ->END

    if drill_2_sequence_step == 6 and drill_2_drone_id != 0:
        set_comms_selection(player_id, drill_2_drone_id)
        follow_route_select_comms(player_id, drill_2_drone_id)
        ->END

    if kestrel_yards_id != 0:
        set_comms_selection(player_id, kestrel_yards_id)
        follow_route_select_comms(player_id, kestrel_yards_id)
    ->END

=== khovan_drill_2_monitor_helm_transit ===
    await delay_sim(seconds=1)
    if current_scene != 3:
        ->END
    if drill_2_sequence_step != 2:
        ->END
    if artemis_id == 0 or tarsis_station_id == 0:
        jump khovan_drill_2_monitor_helm_transit

    artemis_object = to_object(artemis_id)
    tarsis_object = to_object(tarsis_station_id)
    if artemis_object is None or tarsis_object is None:
        jump khovan_drill_2_monitor_helm_transit

    dx = artemis_object.pos.x - tarsis_object.pos.x
    dz = artemis_object.pos.z - tarsis_object.pos.z
    flat_distance_sq = dx * dx + dz * dz
    if flat_distance_sq < 1:
        jump khovan_drill_2_monitor_helm_transit

    flat_distance = math.sqrt(flat_distance_sq)
    heading_dot = ((dx * 0.8660254) + (dz * 0.5)) / flat_distance
    throttle = artemis_object.data_set.get("playerThrottle", 0)
    speed = 0
    artemis_engine_object = to_engine_object(artemis_id)
    if artemis_engine_object is not None:
        speed = abs(artemis_engine_object.cur_speed)

    if flat_distance >= 5000 and heading_dot >= 0.90 and throttle <= 0.01 and speed <= 10:
        drill_2_sequence_step = 3
        drill_2_helm_geometry_check = True
        task_schedule(khovan_reach_objective_text, {"banner": "Drill Two Step 3", "message": "Engineering: press 0 to restore balanced output. Comms confirms when balanced output is restored.", "time": 24})
        task_schedule(khovan_reach_refresh_drill_2_comms_menu)
        log(f"Drill Two Step 2 auto-complete: Artemis stopped {flat_distance:.0f} m from Tarsis on the 060 transit vector. Throttle {throttle}, speed {speed}.")
        ->END

    jump khovan_drill_2_monitor_helm_transit

=== khovan_drill_2_confirm_balanced_output ===
    drill_2_sequence_step = 4
    comms_receive(f"""Training Control: balanced output logged. Engineering, set sensors to two hundred percent and save that configuration as preset three.""", title="Dillon Training Control", title_color="green")
    task_schedule(khovan_reach_objective_text, {"banner": "Drill Two Step 4", "message": "Engineering: set sensors to 200%, press S, then press 3 to save preset 3. Comms confirms when sensor preset 3 is saved.", "time": 26})
    task_schedule(khovan_reach_refresh_drill_2_comms_menu, {"player_id": COMMS_ORIGIN_ID})
    yield success

