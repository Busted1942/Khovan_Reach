shared engineering_impulse_zero_warp_200_requested = False
shared engineering_no_motion_validation_requested = False
shared engineering_no_motion_detection_mode = "automatic_playerThrottle_cur_speed_position_delta_observer_engineering_slider_keys_unverified"
shared engineering_no_motion_fallback_available = False
shared engineering_no_motion_observer_status = "not_started"
shared engineering_no_motion_observer_ticks = 0
shared engineering_no_motion_start_x = 0
shared engineering_no_motion_start_z = 0
shared engineering_no_motion_confirmed = False
shared damcon_rest_cycle_detection_mode = "damcon_location_api_unverified_comms_fallback_after_observer_attempt"
shared damcon_rest_cycle_fallback_available = False
shared damcon_rest_cycle_confirmed = False
shared damcon_meal_cycle_detection_mode = "damcon_location_api_unverified_comms_fallback_after_observer_attempt"
shared damcon_meal_cycle_fallback_available = False
shared damcon_meal_cycle_confirmed = False
shared controlled_overload_prompt_run_id = 0
shared controlled_overload_prompt_sent = False
shared controlled_overload_started = False
shared controlled_overload_damage_detection_mode = "automatic_engine_system_damage_observer_with_comms_fallback"
shared controlled_overload_damage_fallback_available = False
shared controlled_overload_damage_observer_status = "not_started"
shared controlled_overload_damage_observer_ticks = 0
shared controlled_overload_initial_engine_damage = 0
shared controlled_overload_damage_detected = False
shared controlled_overload_repair_supervision_started = False
shared controlled_overload_repair_detection_mode = "engineering_captain_comms_confirmation_fallback_until_repair_completion_api_verified"
shared controlled_overload_repair_fallback_available = False
shared controlled_overload_repair_confirmed = False
shared controlled_overload_repaired = False
