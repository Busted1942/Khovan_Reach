=== khovan_engineering_watch_no_motion_validation ===
    if engineering_no_motion_confirmed:
        ->END
    if not engineering_no_motion_validation_requested:
        ->END
    if artemis_id == 0:
        engineering_no_motion_observer_status = "fallback_missing_artemis_id"
        engineering_no_motion_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG NO MOTION FALLBACK] missing Artemis id")
        ->END

    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        engineering_no_motion_observer_status = "fallback_missing_artemis_object"
        engineering_no_motion_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG NO MOTION FALLBACK] missing Artemis object")
        ->END

    engineering_no_motion_start_x = artemis_object.pos.x
    engineering_no_motion_start_z = artemis_object.pos.z
    engineering_no_motion_observer_status = "watching_for_full_throttle_no_motion"
    engineering_no_motion_observer_ticks = 0
    engineering_no_motion_hold_ticks = 0
    await delay_sim(seconds=1)
    jump khovan_engineering_watch_no_motion_validation_tick
    ->END

=== khovan_engineering_watch_no_motion_validation_tick ===
    if engineering_no_motion_confirmed:
        ->END
    if not engineering_no_motion_validation_requested:
        ->END

    engineering_no_motion_observer_ticks = engineering_no_motion_observer_ticks + 1
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        engineering_no_motion_observer_status = "fallback_missing_artemis_object_during_watch"
        engineering_no_motion_fallback_available = True
        ->END

    # Movement is measured PER TICK against a rolling anchor, not against where the
    # observer started (bugfix 2026-08-09). The old code compared to a fixed origin,
    # so once Artemis had moved anywhere the distance term could never come back
    # under the threshold and the gate became unreachable for the rest of the run -
    # live trace showed distance_sq stuck at 1.9 million while the ship sat still.
    dx = artemis_object.pos.x - engineering_no_motion_start_x
    dz = artemis_object.pos.z - engineering_no_motion_start_z
    flat_distance_sq = dx * dx + dz * dz
    engineering_no_motion_start_x = artemis_object.pos.x
    engineering_no_motion_start_z = artemis_object.pos.z
    throttle = artemis_object.data_set.get("playerThrottle", 0)
    speed = 0
    artemis_engine_object = to_engine_object(artemis_id)
    if artemis_engine_object is not None:
        speed = abs(artemis_engine_object.cur_speed)

    # The gate is only meaningful once impulse power is actually zero. Design 8.4
    # runs step 1 (impulse 0 / warp 200) BEFORE step 2 (full impulse) and step 3
    # (validate no motion) - "no motion at full throttle" proves nothing while
    # impulse power is normal. This precondition is only affordable now that the
    # power-preset observer is live-confirmed.
    engineering_no_motion_qualifies = engineering_power_preset_confirmed and throttle >= 0.95 and speed <= 1 and flat_distance_sq <= 25
    if engineering_no_motion_qualifies:
        engineering_no_motion_hold_ticks = engineering_no_motion_hold_ticks + 1
    else:
        engineering_no_motion_hold_ticks = 0

    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG NO MOTION WATCH] tick={engineering_no_motion_observer_ticks} throttle={throttle} speed={speed} tick_distance_sq={flat_distance_sq} preset={engineering_power_preset_confirmed} hold={engineering_no_motion_hold_ticks}")

    # Sustained, not single-sample (bugfix 2026-08-09). A ship accelerating normally
    # from rest satisfies speed<=1 and a small distance delta for ONE tick on its way
    # up, which is exactly how this gate false-passed live: tick 14 read throttle=0,
    # tick 15 read throttle=0.966 speed=0.797 distance_sq=13.7 and confirmed - the
    # first tick of ordinary acceleration, 98 seconds before impulse was set to zero.
    # Holding the condition for several consecutive seconds separates "genuinely
    # pinned at zero" from "caught mid-spin-up".
    if engineering_no_motion_hold_ticks >= 5:
        await task_schedule(khovan_engineering_complete_no_motion_validation, {"completion_source": "automatic_throttle_speed_position_observer"})
        ->END

    # Arm the fallback, then KEEP WATCHING (fix 2026-08-09, from live trace). This
    # label used to return here, so ~24 seconds after the step began the automatic
    # detector was gone for good and Comms confirmation was the only route left, even
    # if Helm produced a clean full-impulse-no-motion result immediately afterwards.
    # Live 20:30 is exactly that case: ticks 1-13 read throttle=0 while the crew were
    # still setting up, and the observer quit at tick 20. Arming the fallback should
    # add an option, not remove the automatic one. The `not ..._fallback_available`
    # condition keeps the player-facing message duplicate-suppressed per AGENTS.md
    # section 4; the guards at the top of this label end the loop once the step is
    # confirmed or no longer requested.
    if engineering_no_motion_observer_ticks >= 20 and not engineering_no_motion_fallback_available:
        engineering_no_motion_observer_status = "fallback_armed_observer_still_watching"
        engineering_no_motion_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG NO MOTION FALLBACK] Comms fallback armed silently, automatic observer still watching")
        # SUPPRESSED 2026-08-09 by operator direction, pending the next live run.
        # The message fired at 20 seconds and told the crew the runtime "cannot read
        # your impulse state" - which is no longer true, and was never true at that
        # moment. It also cannot be right at 20s now: the gate requires
        # engineering_power_preset_confirmed first, and setting impulse 0 / warp 200
        # took ~90 seconds on the 2026-08-09 pass, so this always fires long before
        # the crew could satisfy the gate. Telling them the automation is broken while
        # it is still waiting for them is worse than saying nothing.
        #
        # The FALLBACK ITSELF IS NOT SUPPRESSED. engineering_no_motion_fallback_available
        # is still set above, so the Tarsis Comms route "Confirm Speed 0 at Full
        # Impulse" stays available as the manual escape hatch - the crew simply is not
        # nagged toward it. AGENTS.md section 4 wants a fallback present, not advertised.
        #
        # DELETE THIS BLOCK, and the now-unused engineering_no_motion_fallback_text
        # declaration, once a live run confirms the automatic gate passes cleanly.
        # await task_schedule(khovan_engineering_send_message, {"engineering_message_text": engineering_no_motion_fallback_text, "engineering_message_color": "yellow", "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG NO MOTION FALLBACK] guarded fallback message sent"})

    await delay_sim(seconds=1)
    jump khovan_engineering_watch_no_motion_validation_tick
    ->END

=== khovan_engineering_complete_no_motion_validation ===
    default completion_source = "fallback_confirmation"
    if engineering_no_motion_confirmed:
        ->END

    if not engineering_no_motion_validation_requested:
        engineering_shakedown_status = "no_motion_confirmation_blocked_missing_instruction"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG BLOCKED] no-motion confirmation blocked before impulse zero/warp 200 instruction")
        ->END

    engineering_no_motion_confirmed = True
    engineering_no_motion_fallback_available = False
    engineering_no_motion_observer_status = completion_source
    engineering_shakedown_status = "damcon_crew_quarters_standby"
    engineering_shakedown_last_step = "no_motion_confirmed"
    current_beat = "engineering_no_motion_confirmed"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG 004] no-motion validation confirmed source={completion_source}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "damcon_crew_quarters_standby", "objective_body": "Engineering, stand your DAMCON teams down to crew quarters. Comms, get confirmation from DAMCON Control.", "objective_step": "DAMCON crew quarters standby", "objective_breadcrumb": "[KHOVAN OBJECTIVE 009] objective updated: DAMCON crew quarters standby"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    damcon_buff_run_id = damcon_buff_run_id + 1
    damcon_buff_observer_ticks = 0
    damcon_buff_observer_status = "watching_damcon_buffs"
    task_schedule(khovan_engineering_watch_damcon_rest_cycle, {"damcon_run_id": damcon_buff_run_id})
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": engineering_no_motion_confirmed_text, "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 004A] guarded DAMCON instruction sent"})
    ->END

=== khovan_engineering_confirm_no_motion ===
    await task_schedule(khovan_engineering_complete_no_motion_validation, {"completion_source": "comms_fallback_confirmation"})
    yield success

=== khovan_engineering_watch_damcon_rest_cycle ===
    # Automatic detector for design 8.4 steps 4 and 6, DAMCON rest-cycle and
    # meal-cycle standby. This was Comms-only because DAMCON *location* has no clean
    # accessor - and it still does not. What is readable is the OUTCOME.
    #
    # legendarymissions/ai/grid_ai.py, grid_damcons_handle_idling_boost_finish():
    # a team that idles in a room for one minute (idle_boost_timer) receives a
    # per-room inventory buff, each set to 1.25 with a 10-16 minute timer -
    #   quarters -> rested_speed_coeff   (:141-144)
    #   mess     -> fed_speed_coeff      (:145-148)
    #   gym      -> ripped_speed_coeff   (:137-140)
    # and grid_ai.mast:243-248 resets the value to 1.0 when its timer expires.
    #
    # So "a team is rested" is get_inventory_value(team, "rested_speed_coeff", 1.0)
    # reading above 1.0. This is a BETTER gate than location: earning the buff proves
    # the team actually parked in quarters for a full minute and took the benefit,
    # where a location check would pass for a team merely walking through.
    #
    # Teams carry role "damcons" (grid_ai.mast //spawn/grid hook).
    #
    # [UNPROVEN] as a Khovan gate - read from installed source, not yet exercised
    # live here. The Comms fallback is still armed on the same 8-second schedule as
    # before, so this can only add an automatic path, never remove the manual one.
    default damcon_run_id = damcon_buff_run_id
    if damcon_rest_cycle_confirmed:
        ->END
    if not engineering_no_motion_confirmed:
        ->END
    if damcon_run_id != damcon_buff_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG DAMCON] stale observer suppressed after story-jump seed")
        ->END
    if artemis_id == 0:
        damcon_buff_observer_status = "fallback_missing_artemis_id"
        damcon_rest_cycle_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG DAMCON FALLBACK] missing Artemis id")
        ->END

    damcon_buff_observer_ticks = damcon_buff_observer_ticks + 1
    damcon_teams = to_object_list(grid_objects(artemis_id) & role("damcons"))
    damcon_team_count = len(damcon_teams)
    damcon_rested_team_count = 0
    damcon_fed_team_count = 0
    damcon_ripped_team_count = 0
    # Raw sample from the first team. teams=3 rested=0 fed=0 held for 270 ticks
    # on the 2026-08-09 run, which proves the loop ran and found teams but not
    # whether the read returned 1.0 or nothing at all. Those need different
    # fixes, so log the value rather than only the derived count.
    damcon_sample_rested = -1
    damcon_sample_fed = -1
    damcon_sample_ripped = -1
    # Second-stage diagnostic (2026-08-09). The first stage proved the read
    # returns the default rather than a stored value: the panel showed DC2
    # "rested for 14:00" while sample_rested came back 1.0. Everything about the
    # call is symmetric with the engine's own - grid_ai.mast:286 uses
    # get_inventory_value(SPAWNED_ID, ...) on the same agent id, to_object()
    # documents itself as resolving grid objects, and grid_objects() returns
    # agent ids - so the remaining suspect is that these three agents are not
    # the three DAMCON teams.
    #
    # idle_state is the discriminator. The engine writes it on every DAMCON at
    # grid_ai.mast:291, so:
    #   idle_state reads "idling"/"moving" -> the id is right, and the buff keys
    #       are stored somewhere this call cannot see
    #   idle_state reads "none" as well     -> wrong agents; fix the query, not
    #       the read
    damcon_sample_id = 0
    damcon_sample_idle_state = "unread"
    damcon_sample_timer_rested = False
    damcon_sample_timer_ripped = False
    damcon_sample_name = "unread"
    for damcon_team in damcon_teams:
        # Read the TIMER, not the inventory value.
        #
        # Evidence, 2026-08-09: the inventory read returns the default on a team
        # the Engineering panel is actively showing as "rested for 14:00", while
        # get_inventory_value(team, "idle_state") on the same id reads the
        # engine's own value correctly. So the id and the call both work, and
        # only these three keys come back empty.
        #
        # The engine's own display does not read the inventory value either. It
        # reads the timer (grid_ai.py:51-63):
        #     if not is_timer_finished(_go_id, "rested_speed_coeff"):
        #         rested = f"rested for {format_time_remaining(...)}"
        # and that display demonstrably works on this ship. So read what the
        # working code reads rather than what the writing code writes.
        #
        # is_timer_finished returns True when a timer was never set
        # (sbs_utils/procedural/timers.py:36-48), so "not finished" is a safe
        # test for "buff currently running" - an unbuffed team reads finished.
        team_rested_active = not is_timer_finished(damcon_team.id, "rested_speed_coeff")
        team_fed_active = not is_timer_finished(damcon_team.id, "fed_speed_coeff")
        team_ripped_active = not is_timer_finished(damcon_team.id, "ripped_speed_coeff")
        # Kept only as a comparison signal in the trace. If these ever start
        # agreeing with the timers, the inventory path works on that build and
        # this comment should be revisited.
        team_rested = get_inventory_value(damcon_team.id, "rested_speed_coeff", 1.0)
        team_fed = get_inventory_value(damcon_team.id, "fed_speed_coeff", 1.0)
        team_ripped = get_inventory_value(damcon_team.id, "ripped_speed_coeff", 1.0)
        if damcon_sample_rested < 0:
            damcon_sample_rested = team_rested
            damcon_sample_fed = team_fed
            damcon_sample_ripped = team_ripped
            damcon_sample_id = damcon_team.id
            damcon_sample_idle_state = get_inventory_value(damcon_team.id, "idle_state", "none")
            damcon_sample_timer_rested = team_rested_active
            damcon_sample_timer_ripped = team_ripped_active
            damcon_sample_name = damcon_team.name
        # Either signal counts. The timer is the one observed working; the
        # coefficient stays in the test so a build where it works still passes.
        if team_rested_active or team_rested > 1.0:
            damcon_rested_team_count = damcon_rested_team_count + 1
        if team_fed_active or team_fed > 1.0:
            damcon_fed_team_count = damcon_fed_team_count + 1
        if team_ripped_active or team_ripped > 1.0:
            damcon_ripped_team_count = damcon_ripped_team_count + 1
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG DAMCON WATCH] tick={damcon_buff_observer_ticks} teams={damcon_team_count} rested={damcon_rested_team_count} fed={damcon_fed_team_count} ripped={damcon_ripped_team_count} sample_rested={damcon_sample_rested} sample_fed={damcon_sample_fed} sample_ripped={damcon_sample_ripped} sample_id={damcon_sample_id} sample_name={damcon_sample_name} sample_idle_state={damcon_sample_idle_state} timer_rested={damcon_sample_timer_rested} timer_ripped={damcon_sample_timer_ripped}")

    # Either buff satisfies the step: the player-facing instruction covers quarters
    # and mess together, and both prove the same lesson - a team was parked long
    # enough to take a benefit.
    # Gym counts too. grid_ai.py treats quarters, mess, and gym identically -
    # one minute idling in any of them writes that room's 1.25 coefficient - and
    # the drill's lesson is "a team was parked long enough to take a benefit",
    # which the gym proves as well as the bunk. Leaving it out meant a crew who
    # parked in the gym did the exercise correctly and got no credit.
    if damcon_rested_team_count > 0 or damcon_fed_team_count > 0 or damcon_ripped_team_count > 0:
        damcon_buff_observer_status = "buffed_team_observed"
        await task_schedule(khovan_engineering_complete_damcon_rest_cycle, {"damcon_source": "automatic_damcon_buff_observer"})
        ->END

    # Arm the Comms fallback on the original 8-second schedule, then KEEP WATCHING.
    if damcon_buff_observer_ticks >= 4 and not damcon_rest_cycle_fallback_available:
        damcon_rest_cycle_fallback_available = True
        damcon_buff_observer_status = "fallback_armed_observer_still_watching"
        engineering_shakedown_status = "damcon_crew_quarters_standby_fallback_available"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG DAMCON REST FALLBACK] Comms fallback armed, buff observer still watching")

    await delay_sim(seconds=2)
    jump khovan_engineering_watch_damcon_rest_cycle

=== khovan_engineering_confirm_damcon_rest_cycle ===
    if not engineering_no_motion_confirmed:
        engineering_shakedown_status = "damcon_rest_blocked_before_no_motion"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG BLOCKED] DAMCON rest-cycle confirmation blocked before no-motion validation")
        yield fail

    await task_schedule(khovan_engineering_complete_damcon_rest_cycle, {"damcon_source": "comms_fallback_confirmation"})
    yield success

=== khovan_engineering_complete_damcon_rest_cycle ===
    default damcon_source = "fallback_confirmation"
    # Duplicate-suppressed: this unlocks the controlled-overload step and schedules
    # its delayed prompt, so reaching it twice would double-schedule that prompt.
    if damcon_rest_cycle_confirmed:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG DAMCON] duplicate suppressed")
        ->END
    damcon_rest_cycle_source = damcon_source
    damcon_meal_cycle_source = damcon_source
    damcon_rest_cycle_confirmed = True
    damcon_rest_cycle_fallback_available = False
    damcon_meal_cycle_confirmed = True
    damcon_meal_cycle_fallback_available = False
    engineering_shakedown_status = "controlled_overload_instruction"
    engineering_shakedown_last_step = "damcon_rest_cycle_confirmed"
    current_beat = "damcon_rest_cycle_confirmed"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG 005] DAMCON crew quarters rest-cycle standby confirmed source={damcon_source} rested={damcon_rested_team_count} fed={damcon_fed_team_count}")
    script.write_khovan_startup_trace("[KHOVAN ACT1 ENG 006] DAMCON meal-cycle confirmation retired; controlled-overload step unlocked")
    await task_schedule(khovan_set_current_objective, {"objective_id": "controlled_overload_start", "objective_body": "Helm, all stop. Engineering, run impulse and warp to 300 and let them overload. Captain, hold us still until the damage is logged.", "objective_step": "Controlled overload", "objective_breadcrumb": "[KHOVAN OBJECTIVE 011] objective updated: controlled overload"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": f"{damcon_rest_cycle_text}\n{damcon_mess_instruction_text}", "engineering_message_title": "DAMCON Control", "engineering_message_color": "green", "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 006A] guarded DAMCON message sent"})
    task_schedule(khovan_engineering_deliver_controlled_overload_prompt_after_delay, {"prompt_run_id": controlled_overload_prompt_run_id})
    ->END

