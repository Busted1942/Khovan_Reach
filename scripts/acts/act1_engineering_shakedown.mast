shared engineering_warp_value = -1
shared engineering_power_preset_confirmed_text = "Artemis - Engineering: Impulse zero, warp two hundred. Heat sinks reading clean.\nArtemis - Helm: Now increase impulse power to 100% and ensure your speed stays at 0."

shared engineering_shakedown_start_text = "Artemis - Captain: Cleared for departure. Take her 2 km off the station.\nArtemis - Engineering: On the captain's order, Impulse 0%, Warp 200%. We are validating heat sinks."
shared engineering_no_motion_confirmed_text = "Artemis - Engineering: Good, reset to your standard operating profile.\nArtemis - Engineering: Then, set the rally point for one of your DamCon teams to the crew quarters and then click on them to monitor their status. While they are off duty, they will return to this position.\nArtemis - Engineering: After 1 minute, you will notice that crew assigned to the quarters, mess, or gym will recieve a status boost that will enhance their performance."
shared engineering_no_motion_fallback_text = "Artemis - Engineering: We cannot read your impulse state from here. Full throttle and holding at zero is the result we wanted.\nArtemis - Comms: Raise Tarsis and confirm it on the record."
shared damcon_rest_cycle_text = "Artemis - Engineering: Confirmed."
shared damcon_mess_instruction_text = "Artemis - Engineering: Crews work fastest with real time in quarters, mess, and gym. Injured teams go to sickbay. They will run themselves into the ground, so managing them is on you. Look after them when the pressure is low and they will carry you when it is high."
shared controlled_overload_prompt_text = "Artemis - Engineering: Controlled overload next. Impulse, Warp, and Maneuver to 300%. Watch your heat and how DAMCON responds."
shared controlled_overload_instruction_text = "Artemis - Engineering: Impulse, Warp, and Maneuver to 300% and let them blow. Bleed the heat, track the repair, then return to 100%. Rested, fed, and exercised teams move faster - quarters, mess, and gym each pay separately."
shared controlled_damage_logged_text = "Artemis - Engineering: Damage logged. Repairs are yours. Watch how much faster a rested team crosses the ship.\nArtemis - Comms: Confirm when repairs are complete."
shared repair_complete_text = "Artemis - Engineering: Impulse 100%, Warp 10%, Maneuver 190%. Press S at the bottom left, then 2, to save it as your close-quarters preset. Build one for a fight, a transit, and a tow."
shared navigation_priority_confirmed_text = "Artemis - Comms: Shakedown complete. Confirm when the captain is ready and we will put a training drone in the water."

