shared engineering_shakedown_available = False
shared engineering_shakedown_started = False
shared engineering_shakedown_status = "not_initialized"
shared engineering_shakedown_detection_mode = "automatic_helm_no_motion_and_engine_damage_observers; comms_fallback_for_unverified_engineering_slider_damcon_location_repair_navigation_preset"
