    await task_schedule(khovan_scenario_control_panel_update_overview)
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": engineering_power_preset_confirmed_text, "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG POWER PRESET] guarded confirmation message sent"})
    ->END

