    await delay_sim(seconds=10)
    if prompt_run_id != controlled_overload_prompt_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG OVERLOAD PROMPT] stale delayed prompt suppressed")
        ->END
    if controlled_overload_prompt_sent:
        ->END

    controlled_overload_prompt_sent = True
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": controlled_overload_prompt_text, "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 006B] guarded delayed controlled-overload prompt sent"})
    ->END

=== khovan_engineering_start_controlled_overload ===
    if not damcon_rest_cycle_confirmed:
        engineering_shakedown_status = "overload_blocked_before_damcon_standby"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG BLOCKED] controlled overload blocked before DAMCON standby confirmations")
        yield fail

    controlled_overload_started = True
    controlled_overload_damage_fallback_available = False
    engineering_shakedown_status = "controlled_overload_waiting_for_damage"
    engineering_shakedown_last_step = "controlled_overload_started"
    current_beat = "controlled_overload_started"
    script.write_khovan_startup_trace("[KHOVAN ACT1 ENG 007] controlled 300 percent impulse/warp overload confirmed started by Comms fallback")
    await task_schedule(khovan_set_current_objective, {"objective_id": "controlled_overload_damage", "objective_body": "Hold us steady until the damage is logged, then Engineering take charge of repairs.", "objective_step": "Controlled damage", "objective_breadcrumb": "[KHOVAN OBJECTIVE 012] objective updated: controlled damage"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    task_schedule(khovan_engineering_watch_controlled_overload_damage)
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": "Artemis - Engineering: Overload logged. Stand by for damage confirmation.", "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 007A] guarded overload message sent"})
    yield success

=== khovan_engineering_watch_controlled_overload_damage ===
    if controlled_overload_damage_detected:
        ->END
    if not controlled_overload_started:
        ->END
    if artemis_id == 0:
        controlled_overload_damage_observer_status = "fallback_missing_artemis_id"
        controlled_overload_damage_fallback_available = True
        ->END

    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        controlled_overload_damage_observer_status = "fallback_missing_artemis_object"
        controlled_overload_damage_fallback_available = True
        ->END

    controlled_overload_initial_engine_damage = artemis_object.data_set.get("system_damage", sbs.SHPSYS.ENGINES)
    controlled_overload_damage_observer_status = "watching_engine_system_damage"
    controlled_overload_damage_observer_ticks = 0
    await delay_sim(seconds=1)
    jump khovan_engineering_watch_controlled_overload_damage_tick
    ->END

=== khovan_engineering_watch_controlled_overload_damage_tick ===
    if controlled_overload_damage_detected:
        ->END
    if not controlled_overload_started:
        ->END

    controlled_overload_damage_observer_ticks = controlled_overload_damage_observer_ticks + 1
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        controlled_overload_damage_observer_status = "fallback_missing_artemis_object_during_watch"
        controlled_overload_damage_fallback_available = True
        ->END

    current_engine_damage = artemis_object.data_set.get("system_damage", sbs.SHPSYS.ENGINES)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG DAMAGE WATCH] tick={controlled_overload_damage_observer_ticks} initial={controlled_overload_initial_engine_damage} current={current_engine_damage}")
    if current_engine_damage > controlled_overload_initial_engine_damage:
        await task_schedule(khovan_engineering_complete_controlled_damage, {"completion_source": "automatic_engine_system_damage_observer"})
        ->END

    if controlled_overload_damage_observer_ticks >= 30:
        controlled_overload_damage_observer_status = "fallback_timeout_no_engine_damage_seen"
        controlled_overload_damage_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG DAMAGE FALLBACK] no engine system damage detected; Comms fallback enabled")
        await task_schedule(khovan_engineering_send_message, {"engineering_message_text": "Artemis - Engineering: We are not reading the damage from here. If you saw the overload, confirm over Comms and we will log it.", "engineering_message_color": "yellow", "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG DAMAGE FALLBACK] guarded fallback message sent"})
        ->END

    await delay_sim(seconds=1)
    jump khovan_engineering_watch_controlled_overload_damage_tick
    ->END

=== khovan_engineering_complete_controlled_damage ===
    default completion_source = "fallback_confirmation"
    if controlled_overload_damage_detected:
        ->END

    if not controlled_overload_started:
        engineering_shakedown_status = "damage_confirmation_blocked_before_overload"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG BLOCKED] controlled damage confirmation blocked before overload")
        ->END

    controlled_overload_damage_detected = True
    controlled_overload_damage_fallback_available = False
    controlled_overload_damage_observer_status = completion_source
    controlled_overload_repair_supervision_started = True
    engineering_shakedown_status = "repair_supervision"
    engineering_shakedown_last_step = "controlled_damage_logged"
    current_beat = "controlled_damage_logged"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG 008] controlled overload damage confirmed source={completion_source}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "engineering_repair_supervision", "objective_body": "Engineering, put your repair crews on it and supervise. Comms, confirm when the systems are back.", "objective_step": "Repair supervision", "objective_breadcrumb": "[KHOVAN OBJECTIVE 013] objective updated: repair supervision"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    controlled_overload_repair_fallback_available = True
    controlled_overload_repair_run_id = controlled_overload_repair_run_id + 1
    controlled_overload_repair_observer_ticks = 0
    controlled_overload_peak_damaged_grid_count = 0
    controlled_overload_repair_observer_status = "watching_damaged_grid_objects"
    task_schedule(khovan_engineering_watch_repair_completion, {"repair_run_id": controlled_overload_repair_run_id})
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": controlled_damage_logged_text, "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 008A] guarded repair instruction sent"})
    ->END

=== khovan_engineering_watch_repair_completion ===
    # Automatic detector for design 8.4 step 11, "Runtime detects repair completion if
    # possible". This gate was Comms-only on the belief that no repair-completion API
    # existed. It does - internal_damage.py tracks it per grid object:
    #
    #   grid_damage_grid_object(): add_role(grid_id, "__damaged__")
    #                              remove_role(grid_id, "__undamaged__")   (:475-476)
    #   grid_repair_grid_objects(): remove_role(id, "__damaged__")
    #                               add_role(id, "__undamaged__")          (:742-743)
    #
    # So "repairs complete" is simply: no grid object on Artemis still carries
    # __damaged__.
    #
    # Guarded against a false pass. The overload takes a moment to actually damage
    # anything, so a poll starting the instant the step opens would see zero damaged
    # objects and declare victory before a single hallway blew. The observer therefore
    # requires the count to have RISEN above zero at least once
    # (controlled_overload_peak_damaged_grid_count) before a return to zero counts as
    # a repair. Without that this gate would pass instantly and mean nothing.
    #
    # [UNPROVEN] as a Khovan gate - the role names and the query shape are read from
    # installed sbs_utils source, not yet exercised live here. The Comms fallback stays
    # armed from the moment the step opens.
    default repair_run_id = controlled_overload_repair_run_id
    if controlled_overload_repair_confirmed:
        ->END
    if not controlled_overload_repair_supervision_started:
        ->END
    if repair_run_id != controlled_overload_repair_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG REPAIR] stale observer suppressed after story-jump seed")
        ->END
    if artemis_id == 0:
        controlled_overload_repair_observer_status = "fallback_missing_artemis_id"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG REPAIR FALLBACK] missing Artemis id")
        ->END
    # This None-check is not boilerplate - it closes a false-pass. grid_objects() on a
    # missing ship returns an empty set, which reads as zero damaged objects. With the
    # peak already above zero, that is indistinguishable from "repairs complete", so a
    # despawned or destroyed Artemis would silently satisfy the gate.
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        controlled_overload_repair_observer_status = "fallback_missing_artemis_object"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG REPAIR FALLBACK] missing Artemis object")
        ->END

    controlled_overload_repair_observer_ticks = controlled_overload_repair_observer_ticks + 1
    damaged_grid_objects = grid_objects(artemis_id) & role("__damaged__")
    controlled_overload_damaged_grid_count = len(damaged_grid_objects)
    if controlled_overload_damaged_grid_count > controlled_overload_peak_damaged_grid_count:
        controlled_overload_peak_damaged_grid_count = controlled_overload_damaged_grid_count
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG REPAIR WATCH] tick={controlled_overload_repair_observer_ticks} damaged={controlled_overload_damaged_grid_count} peak={controlled_overload_peak_damaged_grid_count}")

    if controlled_overload_peak_damaged_grid_count > 0 and controlled_overload_damaged_grid_count == 0:
        await task_schedule(khovan_engineering_complete_repair, {"repair_source": "automatic_undamaged_grid_object_observer"})
        ->END

    await delay_sim(seconds=2)
    jump khovan_engineering_watch_repair_completion

=== khovan_engineering_confirm_controlled_damage ===
    await task_schedule(khovan_engineering_complete_controlled_damage, {"completion_source": "comms_fallback_confirmation"})
    yield success

=== khovan_engineering_confirm_repair_complete ===
    if not controlled_overload_damage_detected:
        engineering_shakedown_status = "repair_confirmation_blocked_before_damage"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG BLOCKED] repair confirmation blocked before controlled damage")
        yield fail

    await task_schedule(khovan_engineering_complete_repair, {"repair_source": "comms_fallback_confirmation"})
    yield success

=== khovan_engineering_complete_repair ===
    default repair_source = "fallback_confirmation"
    # Shared completion for the automatic observer and the Comms route. Duplicate-
    # suppressed: this opens the navigation-priority step and starts that observer, so
    # reaching it twice would double-schedule it.
    if controlled_overload_repair_confirmed:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG REPAIR] duplicate suppressed")
        ->END
    controlled_overload_repair_confirmed = True
    controlled_overload_repair_fallback_available = False
    controlled_overload_repaired = True
    controlled_overload_repair_source = repair_source
    controlled_overload_repair_observer_status = "confirmed"
    engineering_shakedown_status = "navigation_priority_preset"
    engineering_shakedown_last_step = "repair_confirmed"
    current_beat = "controlled_overload_repair_confirmed"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG 009] repair completion confirmed source={repair_source} peak_damaged={controlled_overload_peak_damaged_grid_count}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "navigation_priority_preset", "objective_body": "Engineering, set maneuvering 190, warp 10, impulse 100, and save it as a preset. Report ready when it is stored.", "objective_step": "Navigation priority preset", "objective_breadcrumb": "[KHOVAN OBJECTIVE 014] objective updated: navigation priority preset"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    navigation_priority_preset_fallback_available = True
    navigation_priority_run_id = navigation_priority_run_id + 1
    navigation_priority_observer_ticks = 0
    navigation_priority_observer_status = "watching_engineering_values"
    task_schedule(khovan_engineering_watch_navigation_priority, {"navigation_run_id": navigation_priority_run_id})
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": repair_complete_text, "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 009A] guarded navigation instruction sent"})
    yield success

=== khovan_engineering_watch_navigation_priority ===
    # Automatic detector for design 8.4 step 12, "Engineering sets a navigation
    # priority preset". Target config is in repair_complete_text: impulse 100%,
    # warp 10%, maneuver 190%.
    #
    # Uses the same [LIVE] API as khovan_engineering_watch_power_preset - see
    # cookbook 9.3, confirmed 2026-08-09. Observed labels are IMPULSE / WARP /
    # MANEUVER and lookup is case-insensitive. 1.0 means 100%.
    #
    # IMPORTANT SCOPE LIMIT: this detects the live SLIDERS reading the target
    # configuration. It cannot see whether Engineering saved it to a preset slot -
    # the S-then-number binding is not exposed through eng_control_value, which
    # carries live state only (cookbook 9.3, "What this cannot see"). Design step 12
    # asks for a preset to be stored, and the storing half remains unverifiable, so
    # the Comms route stays armed from the moment the step begins rather than only
    # after a timeout. Treat an automatic pass here as "Engineering demonstrated the
    # configuration", not as "a preset exists".
    #
    # Bands are deliberately wide because values ramp and overshoot - a 200% target
    # settled at 2.005 during the 2026-08-09 pass, so equality never matches. Width
    # costs nothing here: no other step in the 8.4 sequence sets warp this low with
    # maneuver this high, so the combination cannot collide with step 1
    # (impulse 0 / warp 200) or step 8 (everything at 300).
    default navigation_run_id = navigation_priority_run_id
    if navigation_priority_preset_set:
        ->END
    if not controlled_overload_repair_confirmed:
        ->END
    if navigation_run_id != navigation_priority_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG NAV PRIORITY] stale observer suppressed after story-jump seed")
        ->END
    if artemis_id == 0:
        navigation_priority_observer_status = "fallback_missing_artemis_id"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG NAV PRIORITY FALLBACK] missing Artemis id")
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        navigation_priority_observer_status = "fallback_missing_artemis_object"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG NAV PRIORITY FALLBACK] missing Artemis object")
        ->END

    navigation_priority_observer_ticks = navigation_priority_observer_ticks + 1
    nav_impulse_raw = get_engineering_value(artemis_id, "Impulse", -1)
    nav_warp_raw = get_engineering_value(artemis_id, "Warp", -1)
    nav_maneuver_raw = get_engineering_value(artemis_id, "Maneuver", -1)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG NAV PRIORITY WATCH] tick={navigation_priority_observer_ticks} impulse_raw={nav_impulse_raw} warp_raw={nav_warp_raw} maneuver_raw={nav_maneuver_raw}")

    if nav_impulse_raw < 0 or nav_warp_raw < 0 or nav_maneuver_raw < 0:
        navigation_priority_observer_status = "fallback_engineering_labels_not_found_on_this_build"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG NAV PRIORITY FALLBACK] labels not found impulse={nav_impulse_raw} warp={nav_warp_raw} maneuver={nav_maneuver_raw}")
        await task_schedule(khovan_engineering_dump_engineering_slots, {"dump_reason": "navigation_priority_labels_missing"})
        ->END

    navigation_impulse_value = nav_impulse_raw
    navigation_warp_value = nav_warp_raw
    navigation_maneuver_value = nav_maneuver_raw
    if navigation_impulse_value > 10:
        navigation_impulse_value = navigation_impulse_value / 100
    if navigation_warp_value > 10:
        navigation_warp_value = navigation_warp_value / 100
    if navigation_maneuver_value > 10:
        navigation_maneuver_value = navigation_maneuver_value / 100

    if navigation_impulse_value >= 0.9 and navigation_impulse_value <= 1.1 and navigation_warp_value <= 0.2 and navigation_maneuver_value >= 1.8:
        await task_schedule(khovan_engineering_complete_navigation_priority, {"nav_priority_source": "automatic_engineering_value_observer"})
        ->END

    await delay_sim(seconds=1)
    jump khovan_engineering_watch_navigation_priority

=== khovan_engineering_confirm_navigation_priority ===
    if not controlled_overload_repair_confirmed:
        engineering_shakedown_status = "navigation_priority_blocked_before_repair"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG BLOCKED] navigation priority confirmation blocked before repair complete")
        yield fail

    await task_schedule(khovan_engineering_complete_navigation_priority, {"nav_priority_source": "comms_fallback_confirmation"})
    yield success

=== khovan_engineering_complete_navigation_priority ===
    default nav_priority_source = "fallback_confirmation"
    # Duplicate-suppressed: the observer and the Comms route can both reach this, and
    # this label completes the whole Engineering shakedown and hands off to Slice 06.
    if navigation_priority_preset_set:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG NAV PRIORITY] duplicate suppressed")
        ->END
    navigation_priority_source = nav_priority_source
    navigation_priority_observer_status = "confirmed"
    navigation_priority_preset_set = True
    navigation_priority_preset_fallback_available = False
    engineering_shakedown_complete = True
    engineering_shakedown_status = "complete"
    engineering_shakedown_last_step = "engineering_shakedown_complete"
    current_beat = "engineering_shakedown_complete"
    last_checkpoint = "engineering_shakedown_complete"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG 010] Engineering shakedown complete source={nav_priority_source} impulse={navigation_impulse_value} warp={navigation_warp_value} maneuver={navigation_maneuver_value}")
    await task_schedule(khovan_act1_drone_contact_fire_prepare_after_engineering)
    await task_schedule(khovan_scenario_control_panel_update_overview)
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": navigation_priority_confirmed_text, "engineering_message_color": "green", "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 010A] guarded completion message sent"})
    yield success
