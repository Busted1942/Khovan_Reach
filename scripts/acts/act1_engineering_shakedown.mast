=== khovan_act1_engineering_shakedown_start ===
    if not generator_governor_cleared or not energy_restored:
        engineering_shakedown_status = "blocked_before_tarsis_handoff"
        engineering_shakedown_last_step = "blocked_before_tarsis_handoff"
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG BLOCKED] Engineering shakedown start blocked before Tarsis handoff")
        await task_schedule(khovan_engineering_send_message, {"engineering_message_text": "Artemis - Engineering: Hold the shakedown until Tarsis finishes resupply and the generator handoff.", "engineering_message_color": "yellow", "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG BLOCKED] guarded hold message sent"})
        yield fail

    if engineering_shakedown_started:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG MSG ORDER] duplicate suppressed Engineering shakedown start")
        yield success

    shakedown_mode = "full"
    engineering_shakedown_available = True
    engineering_shakedown_started = True
    engineering_shakedown_status = "impulse_zero_warp_200_instruction"
    engineering_shakedown_last_step = "impulse_zero_warp_200_instruction"
    engineering_shakedown_start_response_sent = True
    engineering_impulse_zero_warp_200_requested = True
    engineering_no_motion_validation_requested = True
    engineering_no_motion_fallback_available = False
    current_scene = 3
    current_beat = "engineering_shakedown_impulse_zero_warp_200"
    last_checkpoint = "engineering_shakedown_start"
    script.write_khovan_startup_trace("[KHOVAN ACT1 ENG 003] Engineering shakedown started; impulse zero warp 200 instruction sent")
    await task_schedule(khovan_set_current_objective, {"objective_id": "engineering_impulse_zero_warp_200", "objective_body": "Engineering, set impulse 0 and warp 200. Captain, order full impulse; Helm, hold us at zero while Dillon confirms we have not moved.", "objective_step": "Engineering impulse zero / warp 200", "objective_breadcrumb": "[KHOVAN OBJECTIVE 008] objective updated: Engineering impulse zero warp 200"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    task_schedule(khovan_engineering_watch_no_motion_validation)
    engineering_power_preset_run_id = engineering_power_preset_run_id + 1
    engineering_power_preset_observer_ticks = 0
    engineering_power_preset_observer_status = "watching_engineering_values"
    task_schedule(khovan_engineering_watch_power_preset, {"power_preset_run_id": engineering_power_preset_run_id})
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": engineering_shakedown_start_text, "engineering_message_breadcrumb": "[KHOVAN ACT1 ENG 003A] guarded shakedown instruction sent"})
    yield success

=== khovan_engineering_watch_power_preset ===
    # Automatic detector for design 8.4 step 1 (impulse 0 / warp 200).
    #
    # API: get_engineering_value(id, name, default) - sbs_utils/procedural/
    # space_objects.py:353. It walks up to 30 eng_control_label slots on the ship's
    # data set and returns the matching eng_control_value; the match is
    # case-insensitive. The canonical label set is listed in
    # legendarymissions/gamemaster_comms/gamemaster_comms.mast:50 -
    #   ["Beam", "torpedo", "Impulse", "Warp", "Jump", "Maneuver",
    #    "front shield", "rear shield"]
    #
    # [UNPROVEN] in this repo. Proven elsewhere in the install
    # (legendarymissions/collisions/collision.mast:39,
    # legendarymissions/hangar/hangar_comms.mast:19-20) but never used in Khovan, so
    # the label set and the value scale both need first-run confirmation. This is why
    # every tick traces the RAW values - the first live run is also the experiment
    # that pins the scale down.
    #
    # Scale: collision.mast branches on `if shield_power > 1`, so 1.0 means 100% and
    # the design's "warp 200" is 2.0. Whether some builds report 0-300 instead of
    # 0.0-3.0 is not established, so the tick normalises anything above 10 by
    # dividing by 100. That makes the gate correct on either scale without spending a
    # live round trip to find out which one this build uses.
    #
    # A -1 sentinel distinguishes "label not present" from "slider at zero". If the
    # label set is wrong on this build the observer arms the Comms fallback
    # immediately rather than waiting out the timeout on a lookup that will never
    # succeed.
    default power_preset_run_id = engineering_power_preset_run_id
    if engineering_power_preset_confirmed:
        ->END
    if not engineering_impulse_zero_warp_200_requested:
        ->END
    if power_preset_run_id != engineering_power_preset_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG POWER PRESET] stale observer suppressed after story-jump seed")
        ->END
    if artemis_id == 0:
        engineering_power_preset_observer_status = "fallback_missing_artemis_id"
        engineering_power_preset_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG POWER PRESET FALLBACK] missing Artemis id")
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        engineering_power_preset_observer_status = "fallback_missing_artemis_object"
        engineering_power_preset_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG POWER PRESET FALLBACK] missing Artemis object")
        ->END

    engineering_power_preset_observer_ticks = engineering_power_preset_observer_ticks + 1
    impulse_raw = get_engineering_value(artemis_id, "Impulse", -1)
    warp_raw = get_engineering_value(artemis_id, "Warp", -1)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG POWER PRESET WATCH] tick={engineering_power_preset_observer_ticks} impulse_raw={impulse_raw} warp_raw={warp_raw}")
    if engineering_power_preset_observer_ticks == 1:
        await task_schedule(khovan_engineering_dump_engineering_slots, {"dump_reason": "power_preset_first_tick"})

    if impulse_raw < 0 or warp_raw < 0:
        engineering_power_preset_observer_status = "fallback_engineering_labels_not_found_on_this_build"
        engineering_power_preset_fallback_available = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG POWER PRESET FALLBACK] Impulse/Warp labels not found impulse_raw={impulse_raw} warp_raw={warp_raw}")
        ->END

    engineering_impulse_value = impulse_raw
    engineering_warp_value = warp_raw
    if engineering_impulse_value > 10:
        engineering_impulse_value = engineering_impulse_value / 100
    if engineering_warp_value > 10:
        engineering_warp_value = engineering_warp_value / 100

    if engineering_impulse_value <= 0.05 and engineering_warp_value >= 1.95:
        await task_schedule(khovan_engineering_complete_power_preset, {"power_preset_source": "automatic_engineering_value_observer"})
        ->END

    # Arm the fallback, then KEEP WATCHING (fix 2026-08-09, from live trace). The
    # first version returned here, so automatic detection stopped permanently ~30
    # seconds in. Live 20:30 showed the cost: the crew was still working the consoles
    # when the observer quit, so the only remaining route was Comms confirmation even
    # if they set it correctly a moment later. Arming the fallback should widen the
    # options, not close the automatic one. The guards at the top of this label end
    # the loop when the step is confirmed or no longer requested.
    if engineering_power_preset_observer_ticks >= 30 and not engineering_power_preset_fallback_available:
        engineering_power_preset_observer_status = "fallback_armed_observer_still_watching"
        engineering_power_preset_fallback_available = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG POWER PRESET FALLBACK] Comms fallback armed, automatic observer still watching impulse={engineering_impulse_value} warp={engineering_warp_value}")
        await task_schedule(khovan_engineering_dump_engineering_slots, {"dump_reason": "power_preset_timeout"})

    await delay_sim(seconds=1)
    jump khovan_engineering_watch_power_preset

=== khovan_engineering_dump_engineering_slots ===
    default dump_reason = "unspecified"
    # Diagnostic, added 2026-08-09 after the first live run of the power-preset
    # observer. get_engineering_value resolved both labels - no -1 sentinel - but
    # returned impulse_raw=1.0 warp_raw=1.0 unchanged across all 30 ticks while the
    # operator had Engineering set to impulse 0 / warp 200. So the lookup works and
    # the values are simply not tracking the console.
    #
    # Three candidate explanations, and guessing between them costs a live session
    # each: the label-to-slot mapping differs on this build so we are reading some
    # other system's value; eng_control_value holds a base/default rather than the
    # live slider; or console state is not mirrored into this data set server-side.
    #
    # This dumps every populated slot so one run distinguishes them. If a slot shows
    # 0.0 or 2.0 under a name we did not query, the mapping is wrong and the fix is a
    # name change. If every populated slot reads 1.0 while the console is visibly set
    # otherwise, eng_control_value is not the live state and this whole detection
    # approach is dead - fall back to Comms confirmation and record it as an API
    # finding rather than trying more key names.
    #
    # Nothing in the install writes eng_control_value, so it is engine-populated;
    # there is no in-repo example to copy. `for x in range(N)` in MAST is proven in a
    # shipping reference mission (HereThereBeMonsters-main/story.mast:726,738,753).
    # No control-flow escape inside the loop body - only an if-guard - since breaking
    # out of a MAST for loop is not a proven pattern.
    if artemis_id == 0:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG SLOT DUMP] skipped, missing Artemis id")
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        script.write_khovan_startup_trace("[KHOVAN ACT1 ENG SLOT DUMP] skipped, missing Artemis object")
        ->END
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG SLOT DUMP] begin reason={dump_reason}")
    for slot_index in range(30):
        slot_label = artemis_object.data_set.get("eng_control_label", slot_index)
        if slot_label is not None and slot_label != "":
            slot_value = artemis_object.data_set.get("eng_control_value", slot_index)
            script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG SLOT DUMP] index={slot_index} label={slot_label} value={slot_value}")
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 ENG SLOT DUMP] end reason={dump_reason}")
    ->END

