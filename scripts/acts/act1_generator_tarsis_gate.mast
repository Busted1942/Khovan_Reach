# Khovan Reach Slice 04 Act I generator-governor start and Tarsis gate.
# This is the first real progression path after the playable bootstrap.

shared act1_generator_tarsis_gate_initialized = False
shared act1_generator_tarsis_gate_status = "not_initialized"
