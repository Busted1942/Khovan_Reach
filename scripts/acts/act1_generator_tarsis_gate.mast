=== khovan_act1_hold_artemis_at_kestrel_until_clearance ===
    if artemis_id == 0:
        kestrel_departure_hold_status = "stopped_missing_artemis"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000A] Kestrel departure hold stopped missing Artemis id")
        ->END
    if kestrel_yards_id == 0:
        kestrel_departure_hold_status = "stopped_missing_kestrel"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000B] Kestrel departure hold stopped missing Kestrel id")
        ->END

    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        kestrel_departure_hold_status = "stopped_artemis_object_missing"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000C] Kestrel departure hold stopped missing Artemis object")
        ->END

    if kestrel_departure_clearance_granted:
        await task_schedule(khovan_act1_release_kestrel_departure_hold)
        ->END

    artemis_object.pos = Vec3(0, 0, 500)
    artemis_object.data_set.set("dock_base_id", 0, 0)
    artemis_object.data_set.set("dock_state", "undocked", 0)
    artemis_object.data_set.set("playerThrottle", 0, 0)
    if kestrel_departure_hold_status != "active":
        kestrel_departure_hold_status = "active"
        kestrel_departure_hold_release_status = "waiting_for_clearance"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 002] Artemis mechanical hold fallback active at Kestrel pending departure clearance")
    await delay_sim(seconds=1)
    jump khovan_act1_hold_artemis_at_kestrel_until_clearance
    ->END

=== khovan_act1_release_kestrel_departure_hold ===
    artemis_object = to_object(artemis_id)
    if artemis_object is not None:
        artemis_object.data_set.set("dock_base_id", 0, 0)
        artemis_object.data_set.set("dock_state", "undocked", 0)
        artemis_object.data_set.set("playerThrottle", 0, 0)
    if kestrel_departure_hold_status != "released_after_clearance":
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 003] Kestrel departure hold released after clearance")
    kestrel_departure_hold_status = "released_after_clearance"
    kestrel_departure_hold_release_status = "released"
    log("Khovan Act I Kestrel departure hold released after Comms clearance.")
    ->END

=== khovan_act1_record_progression ===
    default action = "unknown"
    default detail = ""
    act1_last_progression_summary = f"{action}: {detail}"
    scenario_control_panel_last_action = f"act1:{action}"
    scenario_control_panel_action_log = f"{scenario_control_panel_action_log} | ACT1 {action}: {detail}"
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

=== khovan_kestrel_hail ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006] Kestrel Hail option selected")
    if not kestrel_departure_clearance_granted:
        comms_receive("Kestrel Yard Control: Artemis is in yard-lock. Comms, request departure clearance when the captain is ready; Helm should hold position until release.", title="Kestrel Yard Control", title_color="green")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006H] Kestrel Hail option response sent")
        yield success

    comms_receive("Kestrel Yard Control: departure clearance is logged. Helm, clear the launch envelope. Comms, confirm once Artemis is outside the yard boundary.", title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006H] Kestrel Hail option response sent")
    yield success

=== khovan_kestrel_request_emergency_homing_reserve ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE 001] emergency homing reserve requested")
    if homing_reserve_status == "loaded_by_kestrel_comms":
        homing_reserve_request_status = "duplicate_suppressed_already_loaded"
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Kestrel emergency homing reserve request")
        script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE 004] emergency homing reserve already loaded; homing remains 2")
        comms_receive("Kestrel Yard Control: emergency homing reserve is already loaded. Artemis remains capped at exactly two homing torpedoes until Tarsis resupply.", title="Kestrel Yard Control", title_color="yellow")
        yield success

    if artemis_id == 0:
        homing_reserve_request_status = "failed_missing_artemis_id"
        script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE BLOCKED] emergency homing reserve not loaded: missing Artemis id")
        comms_receive("Kestrel Yard Control: unable to release emergency homing reserve; Artemis receiver is not confirmed.", title="Kestrel Yard Control", title_color="yellow")
        yield fail
    if kestrel_yards_id == 0:
        homing_reserve_request_status = "failed_missing_kestrel_id"
        script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE BLOCKED] emergency homing reserve not loaded: missing Kestrel id")
        comms_receive("Kestrel Yard Control: unable to release emergency homing reserve; Kestrel range telemetry is not confirmed.", title="Kestrel Yard Control", title_color="yellow")
        yield fail
    homing_reserve_kestrel_range = sbs.distance_id(artemis_id, kestrel_yards_id)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 RESERVE RANGE] Artemis range to Kestrel for reserve request={homing_reserve_kestrel_range:.0f}m limit={kestrel_homing_reserve_max_range_m}m")
    if homing_reserve_kestrel_range > kestrel_homing_reserve_max_range_m:
        homing_reserve_request_status = "blocked_outside_kestrel_reserve_range"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 RESERVE BLOCKED] emergency homing reserve not loaded: Artemis {homing_reserve_kestrel_range:.0f}m from Kestrel")
        comms_receive(f"Kestrel Yard Control: emergency homing reserve requires Artemis within {kestrel_homing_reserve_max_range_m} meters of Kestrel. Current range is {homing_reserve_kestrel_range:.0f} meters.", title="Kestrel Yard Control", title_color="yellow")
        yield fail

    homing_reserve_request_status = "loaded_by_kestrel_comms"
    homing_reserve_status = "loaded_by_kestrel_comms"
    homing_reserve_runtime_apply_status = "kestrel_request_set_homing_2_live_smoke_required"
    homing_reserve_live_inventory_status = "kestrel_request_set_homing_2_live_smoke_required"
    set_data_set_value(artemis_id, "Homing_NUM", homing_reserve_count, 0)
    script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE 002] emergency homing reserve load requested")
    script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE 003] emergency homing reserve applied homing=2")
    await task_schedule(khovan_act1_remove_kestrel_stock_station_role_after_reserve_and_launch)
    comms_receive(kestrel_homing_reserve_request_text, title="Kestrel Yard Control", title_color="green")
    await task_schedule(khovan_act1_record_progression, {"action": "kestrel_homing_reserve_request", "detail": "emergency homing reserve loaded; Homing_NUM set to 2 once"})
    yield success

=== khovan_kestrel_request_departure_clearance ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006A] Kestrel departure-clearance option selected")
    if kestrel_departure_clearance_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Kestrel departure clearance response")
        yield success

    kestrel_departure_clearance_granted = True
    kestrel_homing_reserve_prompt_run_id = kestrel_homing_reserve_prompt_run_id + 1
    kestrel_homing_reserve_prompt_status = "timer_started_after_departure_clearance"
    kestrel_departure_gate_status = "clearance_granted_waiting_launch_envelope"
    current_beat = "kestrel_departure_clearance_granted"
    script.write_khovan_startup_trace("[KHOVAN ACT1 004] Kestrel departure clearance granted")
    await task_schedule(khovan_act1_release_kestrel_departure_hold)
    await task_schedule(khovan_set_current_objective, {"objective_id": "launch_envelope", "objective_body": "Helm, clear the launch envelope: take us at least 1 km off Kestrel. Comms, confirm when we are out.", "objective_step": "Launch envelope", "objective_breadcrumb": "[KHOVAN OBJECTIVE 003] objective updated: launch envelope (1 km minimum)"})
    await task_schedule(khovan_act1_record_progression, {"action": "kestrel_departure_clearance", "detail": "departure clearance granted; waiting for launch envelope confirmation; energy remains at source-authorized start value until Tarsis handoff"})
    kestrel_departure_clearance_response_sent = True
    task_schedule(khovan_act1_deliver_homing_reserve_prompt_after_departure_clearance, {"prompt_run_id": kestrel_homing_reserve_prompt_run_id})
    comms_receive("Kestrel Yard Control: departure clearance granted. Helm, clear the launch envelope by moving at least 1 km from Kestrel. Comms, confirm once Artemis is outside the yard boundary.", title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG KESTREL 002] departure clearance packet sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006D] Kestrel departure-clearance option response sent")
    yield success

=== khovan_kestrel_report_launch_envelope_clear ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006B] Kestrel launch-envelope option selected")
    if not kestrel_departure_clearance_granted:
        comms_receive("Kestrel Yard Control: departure clearance is not in the log. Comms, request departure clearance before reporting launch-envelope exit.", title="Kestrel Yard Control", title_color="yellow")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006E] Kestrel launch-envelope option rejected before clearance")
        yield fail

    if kestrel_launch_envelope_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Kestrel launch-envelope response")
        yield success
    if artemis_id == 0 or kestrel_yards_id == 0:
        kestrel_departure_gate_status = "launch_envelope_blocked_missing_range_ids"
        script.write_khovan_startup_trace("[KHOVAN ACT1 LAUNCH BLOCKED] launch envelope not cleared: missing Artemis or Kestrel id")
        comms_receive("Kestrel Yard Control: launch-envelope telemetry is not confirmed. Hold the report until Artemis and Kestrel range data are available.", title="Kestrel Yard Control", title_color="yellow")
        yield fail
    launch_envelope_kestrel_range = sbs.distance_id(artemis_id, kestrel_yards_id)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 LAUNCH RANGE] Artemis range to Kestrel for launch-envelope report={launch_envelope_kestrel_range:.0f}m minimum={kestrel_launch_envelope_min_range_m}m")
    if launch_envelope_kestrel_range < kestrel_launch_envelope_min_range_m:
        kestrel_departure_gate_status = "launch_envelope_blocked_inside_1km"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 LAUNCH BLOCKED] launch envelope not cleared: Artemis {launch_envelope_kestrel_range:.0f}m from Kestrel")
        comms_receive(f"Kestrel Yard Control: Artemis must be at least {kestrel_launch_envelope_min_range_m} meters from Kestrel before we can clear the launch envelope. Current range is {launch_envelope_kestrel_range:.0f} meters.", title="Kestrel Yard Control", title_color="yellow")
        yield fail

    launch_envelope_cleared = True
    kestrel_departure_gate_status = "launch_envelope_cleared"
    kestrel_generator_advisory_status = "removed_by_operator_no_packet_sent"
    current_beat = "launch_envelope_cleared_proceed_to_tarsis"
    kestrel_generator_advisory_run_id = kestrel_generator_advisory_run_id + 1
    script.write_khovan_startup_trace("[KHOVAN ACT1 005] launch envelope clear confirmed; Kestrel advisory packet removed by operator")
    await task_schedule(khovan_set_current_objective, {"objective_id": "tarsis_requests", "objective_body": "Come about for Tarsis. Comms, request generator support and docking clearance before we approach.", "objective_step": "Tarsis requests", "objective_breadcrumb": "[KHOVAN OBJECTIVE 005] objective updated: Tarsis requests"})
    await task_schedule(khovan_act1_record_progression, {"action": "launch_envelope_cleared", "detail": "distance-verified Kestrel launch envelope clear; proceed directly to Tarsis requests"})
    await task_schedule(khovan_act1_remove_kestrel_stock_station_role_after_reserve_and_launch)
    await task_schedule(khovan_act1_send_training_speed_power_reminder)
    kestrel_launch_envelope_response_sent = True
    comms_receive("Kestrel Yard Control logs Artemis clear of the launch envelope. Proceed to Tarsis Station for the required Comms requests.", title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG KESTREL 003] launch-envelope packet sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006E] Kestrel launch-envelope option response sent")
    yield success

=== khovan_act1_remove_kestrel_stock_station_role_after_reserve_and_launch ===
    if kestrel_stock_station_role_status == "stock_production_still_active_behavior_swap_unproven":
        ->END
    if not launch_envelope_cleared:
        kestrel_stock_station_role_status = "waiting_for_launch_envelope"
        ->END
    if artemis_id == 0:
        kestrel_stock_station_role_status = "waiting_for_artemis_inventory"
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        kestrel_stock_station_role_status = "waiting_for_artemis_inventory"
        ->END
    kestrel_homing_inventory = artemis_object.data_set.get("Homing_NUM", 0)
    if kestrel_homing_inventory < homing_reserve_count:
        kestrel_stock_station_role_status = "waiting_for_two_homing_torpedoes"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 KESTREL STOCK] retained Station role: Homing_NUM={kestrel_homing_inventory} reserve={homing_reserve_count}")
        ->END
    if kestrel_yards_id == 0:
        kestrel_stock_station_role_status = "waiting_for_kestrel_id"
        ->END
    kestrel_stock_station_range = sbs.distance_id(artemis_id, kestrel_yards_id)
    if kestrel_stock_station_range <= kestrel_stock_station_disable_range_m:
        kestrel_stock_station_role_status = "waiting_for_2km_kestrel_separation"
        kestrel_stock_station_disable_run_id = kestrel_stock_station_disable_run_id + 1
        task_schedule(khovan_act1_watch_kestrel_stock_station_disable, {"stock_disable_run_id": kestrel_stock_station_disable_run_id})
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 KESTREL STOCK] retaining station behavior until Artemis exceeds {kestrel_stock_station_disable_range_m}m; current_range={kestrel_stock_station_range:.0f}m")
        ->END
    kestrel_yards_object = to_object(kestrel_yards_id)
    if kestrel_yards_object is None:
        kestrel_stock_station_role_status = "waiting_for_kestrel_object"
        ->END
    # API UNCERTAINTY - cookbook section 12 (raised 2026-08-09 after a live crash).
    #
    # This line used to be:
    #     kestrel_yards_object.set_behavior("behav_playership")
    # It crashed the server the first time a player confirmed launch-envelope exit:
    #     'Npc' object has no attribute 'set_behavior'
    #
    # Two independent faults, both found by reading the sbs_utils source rather
    # than guessing again:
    #   1. set_behavior() is defined on space_object
    #      (sbs_utils/proxies/space_object.py:55), not on the Npc proxy that
    #      to_object() returns for an NPC. Wrong receiver.
    #   2. Its documented argument set is "nebula, npcship, asteroid, playership,
    #      station" - with no behav_ prefix. So "behav_playership" was also wrong,
    #      and would have failed even on the right object.
    #
    # What this was trying to do: stop Kestrel's stock station production loop
    # after the crew has departed, since roles alone do not control it.
    #
    # Deliberately NOT replaced with another guess. There is no proven pattern in
    # the cookbook for changing an existing object's behavior after spawn, and the
    # previous guess cost a live session and a server crash. Kestrel keeps running
    # its stock production loop after departure; that is cosmetic, and a crash is
    # not. Do not reintroduce a behavior swap here without a spike that proves the
    # call shape on a throwaway object first.
    kestrel_stock_station_role_status = "stock_production_still_active_behavior_swap_unproven"
    script.write_khovan_startup_trace("[KHOVAN ACT1 KESTREL STOCK] behavior swap skipped: no proven API to change behavior post-spawn; stock production remains active after departure")
    ->END

=== khovan_act1_watch_kestrel_stock_station_disable ===
    default stock_disable_run_id = kestrel_stock_station_disable_run_id
    await delay_sim(seconds=1)
    if stock_disable_run_id != kestrel_stock_station_disable_run_id:
        ->END
    await task_schedule(khovan_act1_remove_kestrel_stock_station_role_after_reserve_and_launch)
    ->END

=== khovan_act1_send_training_speed_power_reminder ===
    if training_speed_power_reminder_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Dillon speed-power reminder")
        ->END
    if not launch_envelope_cleared:
        ->END

    training_speed_power_reminder_sent = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] Dillon speed-power reminder sent after launch-envelope clearance")
    await task_schedule(khovan_reach_send_safe_startup_message, {"startup_sender": "Dillon", "startup_text": training_speed_power_reminder_text, "startup_title_color": "cyan", "startup_sender_id": kestrel_yards_id, "startup_player_id": artemis_id, "startup_breadcrumb": "[KHOVAN ACT1 MSG TRAINING 001] Dillon speed-power reminder sent"})
    ->END

=== khovan_tarsis_hail ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008] Tarsis Hail option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS HAIL] Tarsis hail selected")
    if current_scene < 2:
        current_scene = 2
    current_beat = "tarsis_gate_active"
    await task_schedule(khovan_tarsis_update_gate_status)
    script.write_khovan_startup_trace("[KHOVAN ACT1 007] Tarsis hailed; gate active")
    comms_receive(tarsis_hail_text, title="Tarsis Station", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 001] hail response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008H] Tarsis Hail option response sent")
    yield success

=== khovan_tarsis_request_generator_support ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008B] Tarsis generator-acceptance option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS GENERATOR] generator support requested")
    if tarsis_generator_support_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Tarsis generator-support response")
        yield success

    tarsis_generator_support_requested = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 009] Tarsis generator-support request marked")
    await task_schedule(khovan_tarsis_update_gate_status)
    await task_schedule(khovan_act1_record_progression, {"action": "tarsis_generator_support", "detail": "generator acceptance/support requested"})
    tarsis_generator_support_response_sent = True
    comms_receive(tarsis_generator_support_text, title="Tarsis Generator Acceptance", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 003] generator support response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008G] Tarsis generator-acceptance option response sent")
    yield success

=== khovan_tarsis_request_docking_clearance ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008C] Tarsis docking-clearance option selected")
    if tarsis_docking_clearance_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Tarsis docking-clearance response")
        yield success

    if not tarsis_generator_support_requested:
        tarsis_docking_clearance_requested = False
        script.write_khovan_startup_trace("[KHOVAN ACT1 010] Tarsis docking clearance blocked by missing request")
        script.write_khovan_startup_trace("[KHOVAN ACT1 010A] governor remains held; Tarsis required requests incomplete")
        await task_schedule(khovan_tarsis_update_gate_status)
        await task_schedule(khovan_act1_record_progression, {"action": "tarsis_docking_clearance_blocked", "detail": "generator support must be logged first"})
        comms_receive("Tarsis Docking Control: hold docking request. Complete generator support before requesting docking clearance.", title="Tarsis Docking Control", title_color="yellow")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008I] Tarsis docking-clearance option rejected before prerequisites")
        yield fail

    tarsis_docking_clearance_requested = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 011] Tarsis docking-clearance request marked")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS CLEARANCE] docking clearance requested/granted")
    await task_schedule(khovan_tarsis_update_gate_status)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DOCK 004R] Tarsis requests complete={tarsis_required_requests_complete} status={tarsis_gate_status}")
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004D] Tarsis docking clearance granted; enabling docking setup")
    await task_schedule(khovan_tarsis_enable_docking_after_clearance)
    await task_schedule(khovan_set_current_objective, {"objective_id": "tarsis_docking_resupply", "objective_body": "Helm, bring us alongside and dock. Resupply and the generator handoff complete once we are hard docked.", "objective_step": "Tarsis docking/resupply", "objective_breadcrumb": "[KHOVAN OBJECTIVE 006] objective updated: Tarsis docking/resupply"})
    await task_schedule(khovan_act1_record_progression, {"action": "tarsis_docking_clearance", "detail": "docking clearance requested/granted after required prior requests"})
    tarsis_docking_clearance_response_sent = True
    comms_receive(tarsis_docking_clearance_text, title="Tarsis Docking Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 004] docking clearance response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008I] Tarsis docking-clearance option response sent")
    yield success

=== khovan_tarsis_enable_docking_after_clearance ===
    if not tarsis_docking_clearance_requested:
        tarsis_docking_gate_status = "enable_blocked_missing_clearance"
        script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003B] Tarsis docking setup enable blocked before clearance")
        ->END

    if tarsis_station_id == 0:
        tarsis_docking_gate_status = "enable_failed_missing_tarsis_station"
        script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003C] Tarsis docking setup enable failed missing station id")
        ->END

    add_role(tarsis_station_id, "station")
    add_role(tarsis_station_id, "Station")
    tarsis_docking_setup_role_status = "station_and_Station_roles_restored_after_clearance"
    tarsis_mechanical_dock_observed = False
    tarsis_docking_observer_status = "watching_after_clearance"
    tarsis_docking_observer_last_snapshot = "not_checked"
    tarsis_roles_after_clearance = to_object(tarsis_station_id).get_roles()
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DOCK 004S] Tarsis stock Station role restored after clearance for mechanical docking affordance roles={tarsis_roles_after_clearance}")
    await task_schedule(docking_standard_player_station)
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004U] standard friendly station docking helper rerun for Tarsis after clearance")
    for player_id in role("__player__"):
        tarsis_docking_player = to_object(player_id)
        if tarsis_docking_player is not None:
            tarsis_docking_player.data_set.set("dock_base_id", 0, 0)
            tarsis_docking_player.data_set.set("dock_state", "undocked", 0)
            script.write_khovan_startup_trace(f"[KHOVAN ACT1 DOCK 004N] normalized Artemis dock_state=undocked dock_base_id=0 before Tarsis docking setup player_id={player_id}")
        link(player_id, "extra_scan_source", tarsis_station_id)
        docking_set_docking_logic(player_id, tarsis_station_id, khovan_tarsis_normal_docking_resupply_after_clearance)
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DOCK 004P] Tarsis normal docking/resupply wrapper set player_id={player_id} tarsis_station_id={tarsis_station_id} artemis_id={artemis_id}")
    tarsis_docking_gate_status = "enabled_after_docking_clearance"
    tarsis_docking_resupply_status = "docking_enabled_after_clearance_resupply_unproven"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004] Tarsis docking setup enabled after clearance")
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004B] Tarsis docking setup awaiting dock signal after clearance")
    task_schedule(khovan_tarsis_watch_mechanical_docking_after_clearance)
    ->END

=== khovan_tarsis_watch_mechanical_docking_after_clearance ===
    if tarsis_mechanical_dock_observed:
        ->END
    if not tarsis_docking_clearance_requested:
        tarsis_docking_observer_status = "stopped_clearance_not_granted"
        ->END
    if tarsis_station_id == 0:
        tarsis_docking_observer_status = "stopped_missing_tarsis_station"
        script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004W] Tarsis dock-state observer stopped missing station id")
        ->END

    for player_id in role("__player__"):
        observed_player = to_object(player_id)
        if observed_player is not None:
            observed_dock_state = observed_player.data_set.get("dock_state", "unknown")
            observed_dock_base_id = observed_player.data_set.get("dock_base_id", 0)
            observer_snapshot = f"player={player_id} state={observed_dock_state} base={observed_dock_base_id} tarsis={tarsis_station_id}"
            if observer_snapshot != tarsis_docking_observer_last_snapshot:
                tarsis_docking_observer_last_snapshot = observer_snapshot
                script.write_khovan_startup_trace(f"[KHOVAN ACT1 DOCK 004T] Tarsis dock-state observer {observer_snapshot}")
            if observed_dock_base_id == tarsis_station_id and observed_dock_state == "docked":
                tarsis_mechanical_dock_observed = True
                tarsis_docking_observer_status = "dock_state_observed_after_clearance"
                tarsis_docking_resupply_status = "mechanical_dock_state_observed_resupply_scheduled"
                script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004A] Tarsis dock signal observed after clearance; normal station resupply scheduled")
                script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004C] Tarsis dock-state observer confirmed docked state after clearance")
                await task_schedule(khovan_tarsis_complete_mechanical_docking_and_resupply, {"ship_id": player_id, "completion_source": "dock_state_observer"})
                ->END

    await delay_sim(seconds=1)
    jump khovan_tarsis_watch_mechanical_docking_after_clearance
    ->END

=== khovan_tarsis_update_gate_status ===
    if tarsis_generator_support_requested and tarsis_docking_clearance_requested:
        tarsis_required_requests_complete = True
        tarsis_gate_status = "requests_complete_waiting_for_docking_resupply"
    elif tarsis_generator_support_requested:
        tarsis_required_requests_complete = False
        tarsis_gate_status = "waiting_for_docking_clearance_request"
    else:
        tarsis_required_requests_complete = False
        tarsis_gate_status = "waiting_for_generator_support_and_docking_clearance"
    ->END

=== khovan_tarsis_report_gate_status ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008E] Tarsis status-report option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS STATUS] Tarsis gate status requested")
    await task_schedule(khovan_tarsis_update_gate_status)
    if generator_governor_active:
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 011A] governor remains held; tarsis_gate_status={tarsis_gate_status}")

    generator_status_text = "not received"
    if tarsis_generator_support_requested:
        generator_status_text = "received"
    docking_status_text = "not granted"
    if tarsis_docking_clearance_requested:
        docking_status_text = "granted"

    if tarsis_required_requests_complete:
        tarsis_gate_status_text = "Tarsis gate status: all required traffic complete. Docking/resupply handoff may proceed."
    else:
        tarsis_gate_status_text = f"Tarsis gate status: generator support {generator_status_text}, docking clearance {docking_status_text}. Complete both before docking/resupply handoff."

    comms_receive(tarsis_gate_status_text, title="Tarsis Station", title_color="cyan")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 006] gate status response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008K] Tarsis status-report option response sent")
    yield success

=== khovan_tarsis_confirm_docking_and_resupply ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008D] hidden fallback docking/resupply confirmation attempted")
    comms_receive("Tarsis Docking Control: use normal Helm docking after clearance. Resupply will complete when Artemis is mechanically docked.", title="Tarsis Station", title_color="yellow")
    yield fail

=== khovan_tarsis_complete_mechanical_docking_and_resupply ===
    default ship_id = artemis_id
    default completion_source = "mechanical_docking"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS TARSIS RESUPPLY] mechanical docking/resupply completion source={completion_source}")
    if tarsis_governor_clear_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Tarsis governor-clear response")
        ->END

    if not tarsis_required_requests_complete:
        await task_schedule(khovan_tarsis_update_gate_status)
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 011B] governor remains held; mechanical docking/resupply blocked status={tarsis_gate_status}")
        ->END

    tarsis_resupply_confirmed = True
    generator_governor_active = False
    generator_governor_cleared = True
    energy_restored = True
    if ship_id != 0:
        set_data_set_value(ship_id, "energy", tarsis_resupply_energy, 0)
        set_data_set_value(ship_id, "Homing_NUM", tarsis_resupply_homing_torpedoes, 0)
        set_data_set_value(ship_id, "Nuke_NUM", tarsis_resupply_nukes, 0)
        set_data_set_value(ship_id, "EMP_NUM", tarsis_resupply_emps, 0)
        set_data_set_value(ship_id, "Mine_NUM", tarsis_resupply_mines, 0)
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 012A] Tarsis resupply restored energy={tarsis_resupply_energy}")
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 012B] Tarsis resupply restored ordnance homing={tarsis_resupply_homing_torpedoes} nuke={tarsis_resupply_nukes} emp={tarsis_resupply_emps} mine={tarsis_resupply_mines}")
    else:
        script.write_khovan_startup_trace("[KHOVAN ACT1 012A] Tarsis resupply restore skipped missing ship id")
    tarsis_gate_status = "resupply_confirmed_governor_cleared"
    current_scene = 2
    current_beat = "tarsis_resupply_governor_cleared"
    last_checkpoint = "tarsis_resupply_governor_cleared"
    tarsis_governor_clear_response_sent = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 012] Tarsis resupply confirmed; generator governor cleared")
    await task_schedule(khovan_act1_engineering_shakedown_prepare_after_tarsis)
    await task_schedule(khovan_set_current_objective, {"objective_id": "engineering_shakedown_ready", "objective_body": "Resupply complete. Stand by for Dillon to begin the Engineering shakedown.", "objective_step": "Engineering shakedown ready", "objective_breadcrumb": "[KHOVAN OBJECTIVE 007] objective updated: Engineering shakedown ready"})
    await task_schedule(khovan_act1_record_progression, {"action": "tarsis_resupply_governor_cleared", "detail": "required Tarsis requests complete; normal Tarsis docking resupply cleared governor and restored full energy/armament"})
    await task_schedule(khovan_reach_send_safe_startup_message, {"startup_sender": "Tarsis Station", "startup_text": tarsis_resupply_text, "startup_title_color": "green", "startup_sender_id": tarsis_station_id, "startup_player_id": ship_id, "startup_breadcrumb": "[KHOVAN ACT1 MSG TARSIS 005] docking/resupply response sent"})
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 005] docking/resupply response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008J] Tarsis mechanical docking/resupply completion response sent")
    ->END
