=== khovan_act1_story_jump_seed_post_tarsis_handoff ===
    mission_phase = "act_1"
    current_scene = 2
    current_beat = "await_next_shakedown_instruction"
    last_checkpoint = "tarsis_resupply_governor_cleared"
    transition_held = False
    kestrel_departure_clearance_granted = True
    kestrel_departure_gate_status = "launch_envelope_cleared"
    kestrel_departure_hold_status = "released_after_clearance"
    kestrel_departure_hold_release_status = "released"
    kestrel_departure_clearance_response_sent = True
    kestrel_launch_envelope_response_sent = True
    launch_envelope_cleared = True
    kestrel_generator_packet_sent = True
    kestrel_generator_advisory_status = "delivered"
    kestrel_generator_advisory_run_id = kestrel_generator_advisory_run_id + 1
    kestrel_generator_advisory_sent = True
    kestrel_homing_reserve_prompt_run_id = kestrel_homing_reserve_prompt_run_id + 1
    kestrel_homing_reserve_prompt_status = "not_applicable_post_tarsis"
    kestrel_homing_reserve_prompt_sent = False
    training_speed_power_reminder_sent = True
    shakedown_prompt_sent = False
    homing_reserve_status = "superseded_by_tarsis_resupply"
    homing_reserve_request_status = "story_jump_skipped_or_superseded"
    homing_reserve_live_inventory_status = "superseded_by_tarsis_full_resupply"
    tarsis_generator_support_requested = True
    tarsis_docking_clearance_requested = True
    tarsis_required_requests_complete = True
    tarsis_resupply_confirmed = True
    tarsis_generator_support_response_sent = True
    tarsis_docking_clearance_response_sent = True
    tarsis_governor_clear_response_sent = True
    tarsis_gate_status = "resupply_confirmed_governor_cleared"
    tarsis_docking_resupply_status = "story_jump_seeded_post_tarsis_handoff"
    tarsis_docking_gate_status = "enabled_after_docking_clearance"
    generator_governor_active = False
    generator_governor_cleared = True
    energy_restored = True
    act1_last_progression_summary = "Admin jump seeded post-Tarsis handoff; generator governor clear and full resupply requested."
    script.write_khovan_startup_trace("[KHOVAN JUMP ACT1 POST TARSIS] post-resupply handoff seed requested")
    await task_schedule(khovan_act1_setup_kestrel_and_tarsis_contacts)
    await task_schedule(khovan_tarsis_enable_docking_after_clearance)
    tarsis_mechanical_dock_observed = True
    tarsis_docking_observer_status = "story_jump_seeded_docked_after_clearance"
    tarsis_docking_observer_last_snapshot = "story_jump_seeded"
    tarsis_docking_resupply_status = "story_jump_seeded_post_tarsis_handoff"
    if artemis_id != 0:
        set_data_set_value(artemis_id, "energy", tarsis_resupply_energy, 0)
        set_data_set_value(artemis_id, "Homing_NUM", tarsis_resupply_homing_torpedoes, 0)
        set_data_set_value(artemis_id, "Nuke_NUM", tarsis_resupply_nukes, 0)
        set_data_set_value(artemis_id, "EMP_NUM", tarsis_resupply_emps, 0)
        set_data_set_value(artemis_id, "Mine_NUM", tarsis_resupply_mines, 0)
        artemis_object = to_object(artemis_id)
        if artemis_object is not None:
            artemis_object.pos = Vec3(18000, 0, 500)
            artemis_object.data_set.set("dock_base_id", tarsis_station_id, 0)
            artemis_object.data_set.set("dock_state", "docked", 0)
            artemis_object.data_set.set("playerThrottle", 0, 0)
            script.write_khovan_startup_trace("[KHOVAN JUMP ACT1 POST TARSIS] Artemis positioned at Tarsis with docked state for admin smoke setup")
        script.write_khovan_startup_trace(f"[KHOVAN JUMP ACT1 POST TARSIS] resources seeded energy={tarsis_resupply_energy} homing={tarsis_resupply_homing_torpedoes} nuke={tarsis_resupply_nukes} emp={tarsis_resupply_emps} mine={tarsis_resupply_mines}")
    await task_schedule(khovan_act1_engineering_shakedown_prepare_after_tarsis)
    await task_schedule(khovan_set_current_objective, {"objective_id": "engineering_shakedown_ready", "objective_body": "Resupply complete. Stand by for Dillon to begin the Engineering shakedown.", "objective_step": "Engineering shakedown ready", "objective_breadcrumb": "[KHOVAN OBJECTIVE 007] objective updated: Engineering shakedown ready"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    log("Khovan admin jump seeded Slice 04 post-Tarsis handoff.")
    ->END

=== khovan_act1_apply_source_authorized_start_state ===
    generator_governor_active = True
    starting_homing_torpedoes = 0
    homing_reserve_count = 2
    artemis_start_energy = 0
    artemis_start_energy_runtime_apply_status = "pending_visible_zero_energy_apply"
    if artemis_id == 0:
        artemis_start_condition_status = "skipped_missing_artemis_id"
        artemis_start_energy_runtime_apply_status = "skipped_missing_artemis_id"
        artemis_start_ordnance_runtime_apply_status = "skipped_missing_artemis_id"
        script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting energy not set: missing Artemis id")
        script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting ordnance not set: missing Artemis id")
        script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE FINAL] energy=unknown homing=unknown nuke=unknown emp=unknown mine=unknown missing_artemis_id")
        ->END

    set_data_set_value(artemis_id, "energy", artemis_start_energy, 0)
    set_data_set_value(artemis_id, "Homing_NUM", artemis_start_homing_torpedoes, 0)
    set_data_set_value(artemis_id, "Nuke_NUM", artemis_start_nukes, 0)
    set_data_set_value(artemis_id, "EMP_NUM", artemis_start_emps, 0)
    set_data_set_value(artemis_id, "Mine_NUM", artemis_start_mines, 0)
    homing_reserve_status = "held_by_kestrel_pending_request"
    homing_reserve_runtime_apply_status = "fresh_load_zero_requested_live_smoke_required"
    homing_reserve_live_inventory_status = "fresh_load_zero_requested_live_smoke_required"
    artemis_start_condition_status = "visible_zero_energy_generator_governor_zero_homing_until_kestrel_reserve"
    artemis_start_energy_runtime_apply_status = "requested_visible_energy_0"
    artemis_start_ordnance_runtime_apply_status = "requested_homing_0_nuke_0_emp_0_mine_0"
    script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting energy intentionally set to 0 with generator governor active")
    script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting ordnance set to Homing=0 Nuke=0 EMP=0 Mine=0")
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 START STATE FINAL] energy={artemis_start_energy} homing={artemis_start_homing_torpedoes} nuke={artemis_start_nukes} emp={artemis_start_emps} mine={artemis_start_mines} reserve=held_by_kestrel")
    ->END

=== khovan_act1_setup_kestrel_and_tarsis_contacts ===
    existing_kestrel_yards = to_object_list(role("kestrel_yards"))
    if len(existing_kestrel_yards) > 0:
        kestrel_yards_id = existing_kestrel_yards[0].id
    else:
        kestrel_yards = npc_spawn(0, 0, 0, "Kestrel Yards", "tsn, station, kestrel_yards, khovan_origin", "starbase_command", "behav_station")
        kestrel_yards_id = to_id(kestrel_yards)
        set_face(kestrel_yards_id, random_terran(civilian=True))
        sim.add_navproxy(kestrel_yards_id, "Kestrel Yards", "starbase_command", "#4A7")
    add_role(kestrel_yards_id, "Station")
    # Kestrel starts as a mechanical hold, not a Legendary docking transition.
    remove_role(kestrel_yards_id, "station")
    add_role(kestrel_yards_id, "kestrel_yards")
    kestrel_roles = to_object(kestrel_yards_id).get_roles()
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS 003] Kestrel standard station setup complete roles={kestrel_roles}")

    existing_tarsis_station = to_object_list(role("tarsis_station"))
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 004A] Tarsis Station spawn attempted")
    if len(existing_tarsis_station) > 0:
        tarsis_station_id = existing_tarsis_station[0].id
    else:
        tarsis_station = npc_spawn(18000, 0, 0, "Tarsis Station", "tsn, station, tarsis_station, khovan_drill_resupply", "starbase_command", "behav_station")
        tarsis_station_id = to_id(tarsis_station)
        set_face(tarsis_station_id, random_terran(civilian=True))
        sim.add_navproxy(tarsis_station_id, "Tarsis Station", "starbase_command", "#4A7")
    add_role(tarsis_station_id, "Station")
    remove_role(tarsis_station_id, "station")
    add_role(tarsis_station_id, "tarsis_station")
    tarsis_roles = to_object(tarsis_station_id).get_roles()
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS 004B] Tarsis Station spawned id={tarsis_station_id}")
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS 004] Tarsis standard station setup complete roles={tarsis_roles}")
    script.write_khovan_startup_trace("[KHOVAN ACT1 SCAN 001] Tarsis contact available for Slice 04 Comms; Science scan remains observational only")

    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 001] docking setup scheduled")
    kestrel_start_docking_helper_status = "skipped_startup_hold_uses_mechanical_fallback"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 001K] Kestrel Legendary docking helper skipped for startup mechanical hold fallback")
    kestrel_yard_lock_visual_status = "attempted_mechanical_fallback"
    script.write_khovan_startup_trace("[KHOVAN ACT1 VISUAL 001] Kestrel yard-lock visual setup attempted")
    await task_schedule(docking_standard_player_station)
    if kestrel_yards_id != 0:
        # ROOT CAUSE, confirmed live 2026-08-09. Kestrel rendered no Khovan Comms
        # routes in the right-hand panel while Tarsis rendered its four correctly.
        #
        # The [KHOVAN ACT1 COMMS 003C-ROLES] trace showed Kestrel finishing setup
        # holding the stock lowercase 'station' role, while Tarsis finished without
        # it. A station-roled object gets the stock station Comms panel, which owns
        # the right-hand list and shows a generic "Options" entry under an
        # "unknown" sender - exactly what the operator saw. Khovan's own //comms
        # block was evaluating the whole time ([KHOVAN ACT1 COMMS KESTREL OPTIONS]
        # fired on every click); its output was simply not what the panel showed.
        #
        # Two role facts this proved, both contradicting cookbook 8.2:
        #   1. Role names are case-insensitive. add_role("Station") immediately
        #      after add_role("station") is a no-op - the post-restore trace shows
        #      'station' and never 'Station'.
        #   2. Therefore remove_role("Station") strips lowercase 'station' too,
        #      which is precisely how the Tarsis branch below ends up clean.
        #
        # Kestrel does not need the stock station role: its departure hold is the
        # mechanical fallback, not Legendary docking (see DOCK 001K above), so the
        # stock station panel buys nothing and costs the Khovan routes.
        add_role(kestrel_yards_id, "station")
        remove_role(kestrel_yards_id, "Station")
        add_role(kestrel_yards_id, "kestrel_yards")
        kestrel_comms_options_status = "stock_station_role_cleared_kestrel_yards_retained_for_khovan_comms"
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 003B] Kestrel stock station role cleared; kestrel_yards retained for Khovan Comms options")
        kestrel_roles_final = to_object(kestrel_yards_id).get_roles()
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS 003C-ROLES] Kestrel post-restore roles={kestrel_roles_final}")
    if tarsis_station_id != 0:
        add_role(tarsis_station_id, "station")
        remove_role(tarsis_station_id, "Station")
        tarsis_comms_options_status = "station_role_restored_after_docking_helper_pass"
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 004D] Tarsis station role restored and stock Station role removed after docking helper pass for Khovan Comms options")
    for player_id in role("__player__"):
        if kestrel_yards_id != 0:
            science_set_scan_data(player_id, kestrel_yards_id, "Kestrel Yards is Artemis' launch yard and active departure-control contact.")
            link(player_id, "extra_scan_source", kestrel_yards_id)
        if tarsis_station_id != 0:
            science_set_scan_data(player_id, tarsis_station_id, "Tarsis Station is the Kestrel generator handoff and resupply contact for Artemis.")
            link(player_id, "extra_scan_source", tarsis_station_id)
            docking_set_docking_logic(player_id, tarsis_station_id, khovan_tarsis_docking_rejected_before_clearance)
    tarsis_docking_gate_status = "blocked_until_docking_clearance"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 002] docking setup applied or failed/stubbed")
    if artemis_id != 0 and kestrel_yards_id != 0:
        kestrel_departure_hold_status = "scheduled"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 001] Kestrel departure hold scheduled")
        artemis_object = to_object(artemis_id)
        if artemis_object is not None:
            artemis_object.pos = Vec3(0, 0, 500)
            artemis_object.data_set.set("dock_base_id", 0, 0)
            artemis_object.data_set.set("dock_state", "undocked", 0)
            artemis_object.data_set.set("playerThrottle", 0, 0)
            kestrel_departure_hold_status = "active"
            kestrel_departure_hold_release_status = "waiting_for_clearance"
            script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 002] Artemis mechanical hold fallback active at Kestrel pending departure clearance")
            await task_schedule(khovan_current_objective_init)
            await task_schedule(khovan_reach_stub_dillon_clip_1)
            await task_schedule(khovan_act1_show_kestrel_yard_lock_visual_fallback)
            task_schedule(khovan_act1_hold_artemis_at_kestrel_until_clearance)
        else:
            kestrel_departure_hold_status = "stopped_artemis_object_missing"
            script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000C] Kestrel departure hold stopped missing Artemis object")
    else:
        kestrel_departure_hold_status = "not_scheduled_missing_artemis_or_kestrel"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000] Kestrel departure hold not scheduled missing Artemis or Kestrel id")
    tarsis_docking_resupply_status = "preclearance_docking_blocked_resupply_unproven"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DOCK 002A] Tarsis pre-clearance docking blocker installed id={tarsis_station_id}; mechanical docking/resupply remains live-smoke only")
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003] Tarsis docking setup held behind docking clearance")
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003A] Premature Tarsis docking uses Khovan clearance-denied handler until clearance; dock-button visibility requires live proof")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 003A] Kestrel marked known to player ships for departure Comms")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 004C] Tarsis Slice 04 Comms contact available without hard Science-scan gate")
    script.write_khovan_startup_trace("[KHOVAN ACT1 003] Kestrel/Tarsis contacts initialized")
    script.write_khovan_startup_trace("[KHOVAN ACT1 003C] Kestrel/Tarsis use reference-backed standard station primitives")
    script.write_khovan_startup_trace("[KHOVAN ACT1 003D] Khovan station presentation polish deferred until standard Comms/docking path is proven")
    log(f"Khovan Act I contacts initialized: Kestrel id {kestrel_yards_id}, Tarsis id {tarsis_station_id}.")
    ->END

=== khovan_tarsis_docking_rejected_before_clearance ===
metadata: ``` yaml
distance: 600
```
+++ enable
    yield fail if DOCKING_NPC_ID == 0
    yield fail if tarsis_docking_clearance_requested
    yield fail if DOCKING_NPC_ID != tarsis_station_id

+++ docking
    tarsis_docking_gate_status = "preclearance_docking_rejected_missing_clearance"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK BLOCKED] Tarsis docking rejected: clearance not granted")
    with comms_override(DOCKING_NPC_ID, DOCKING_PLAYER_ID, from_name="Tarsis Docking Control"):
        <<[yellow,black] "Docking Clearance Required"
            % {tarsis_docking_rejection_text}
    yield fail

=== khovan_tarsis_normal_docking_resupply_after_clearance ===
metadata: ``` yaml
distance: 600
```
+++ enable
    yield fail if DOCKING_NPC_ID == 0
    yield fail if DOCKING_NPC_ID != tarsis_station_id
    yield fail if not tarsis_required_requests_complete

+++ docking
    set_weapons_selection(DOCKING_PLAYER_ID, 0)
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004X] Tarsis normal docking wrapper accepted docking attempt after clearance")
    yield success

+++ docked
    set_weapons_selection(DOCKING_PLAYER_ID, 0)
    grid_restore_damcons(DOCKING_PLAYER_ID)
    start_counter(DOCKING_PLAYER_ID, "refuel")
    start_counter(DOCKING_PLAYER_ID, "torps")
    start_counter(DOCKING_PLAYER_ID, "shields")
    start_counter(DOCKING_PLAYER_ID, "interior")
    tarsis_mechanical_dock_observed = True
    tarsis_docking_observer_status = "normal_docking_wrapper_docked_after_clearance"
    tarsis_docking_resupply_status = "normal_docking_wrapper_resupply_scheduled"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004A] Tarsis dock signal observed after clearance; normal station resupply scheduled")
    task_schedule(khovan_tarsis_complete_mechanical_docking_and_resupply, {"ship_id": DOCKING_PLAYER_ID, "completion_source": "normal_docking_wrapper"})

+++ refit
    set_weapons_selection(DOCKING_PLAYER_ID, 0)
    DOCKING_PLAYER.data_set.set("energy", tarsis_resupply_energy, 0)
    DOCKING_PLAYER.data_set.set("Homing_NUM", tarsis_resupply_homing_torpedoes, 0)
    DOCKING_PLAYER.data_set.set("Nuke_NUM", tarsis_resupply_nukes, 0)
    DOCKING_PLAYER.data_set.set("EMP_NUM", tarsis_resupply_emps, 0)
    DOCKING_PLAYER.data_set.set("Mine_NUM", tarsis_resupply_mines, 0)

+++ throttle
    DOCKING_PLAYER.data_set.set("playerThrottle", 0, 0)

=== khovan_act1_deliver_homing_reserve_prompt_after_departure_clearance ===
    default prompt_run_id = kestrel_homing_reserve_prompt_run_id
    await delay_sim(seconds=10)
    if prompt_run_id != kestrel_homing_reserve_prompt_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed stale Kestrel homing-reserve prompt timer")
        ->END
    if not kestrel_departure_clearance_granted:
        ->END
    if homing_reserve_status == "loaded_by_kestrel_comms" or kestrel_homing_reserve_prompt_sent:
        kestrel_homing_reserve_prompt_status = "not_sent_reserve_already_requested"
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] Kestrel homing-reserve prompt skipped because reserve is already loaded")
        ->END
    kestrel_homing_reserve_prompt_sent = True
    kestrel_homing_reserve_prompt_status = "sent_after_departure_clearance"
    script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE PROMPT] 10-second departure-clearance reminder sent")
    await task_schedule(khovan_reach_send_safe_startup_message, {"startup_sender": "Kestrel Yard Control", "startup_text": kestrel_homing_reserve_prompt_text, "startup_title_color": "yellow", "startup_sender_id": kestrel_yards_id, "startup_player_id": artemis_id, "startup_breadcrumb": "[KHOVAN ACT1 MSG KESTREL 002A] homing-reserve prompt sent"})
    ->END

=== khovan_act1_show_kestrel_yard_lock_visual_fallback ===
    if kestrel_yard_lock_message_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Kestrel yard-lock startup message")
        ->END

    kestrel_yard_lock_message_sent = True
    kestrel_yard_lock_visual_status = "fallback_active_mechanical_yard_lock_overlay"
