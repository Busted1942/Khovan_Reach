    tarsis_docking_setup_role_status = "not_enabled"
    tarsis_mechanical_dock_observed = False
    tarsis_docking_observer_status = "not_started"
    tarsis_docking_observer_last_snapshot = "not_checked"
    kestrel_departure_clearance_granted = False
    kestrel_departure_gate_status = "waiting_for_clearance"
    kestrel_departure_hold_status = "waiting_for_contact_setup"
    kestrel_departure_hold_release_status = "not_released"
    kestrel_start_docking_helper_status = "not_initialized"
    kestrel_yard_lock_visual_status = "pending_contact_setup"
    kestrel_yard_lock_message_sent = False
    kestrel_departure_clearance_response_sent = False
    kestrel_launch_envelope_response_sent = False
    launch_envelope_cleared = False
    kestrel_generator_packet_sent = False
    kestrel_generator_advisory_status = "pending_launch_envelope"
    kestrel_generator_advisory_run_id = 0
    kestrel_generator_advisory_sent = False
    kestrel_homing_reserve_prompt_run_id = 0
    kestrel_homing_reserve_prompt_status = "pending_departure_clearance"
    kestrel_homing_reserve_prompt_sent = False
    kestrel_stock_station_role_status = "active_until_launch_envelope_reserve_and_2km"
    kestrel_stock_station_disable_run_id = kestrel_stock_station_disable_run_id + 1
    training_speed_power_reminder_sent = False
    shakedown_prompt_sent = False
    tarsis_gate_status = "waiting_for_kestrel_departure"
    tarsis_generator_support_requested = False
    tarsis_docking_clearance_requested = False
    tarsis_required_requests_complete = False
    tarsis_resupply_confirmed = False
    tarsis_docking_resupply_status = "blocked_until_docking_clearance"
    tarsis_station_visibility_status = "known_for_slice04_comms_no_hard_science_gate"
    tarsis_docking_gate_status = "waiting_for_comms_clearance"
    tarsis_comms_options_status = "waiting_for_known_state"
    tarsis_generator_support_response_sent = False
    tarsis_docking_clearance_response_sent = False
    tarsis_governor_clear_response_sent = False
    act1_last_progression_summary = "Generator governor active; fresh load requests zero homing until Kestrel reserve is requested."
    script.write_khovan_startup_trace("[KHOVAN ACT1 001] generator governor initialized active")
    script.write_khovan_startup_trace("[KHOVAN ACT1 002] homing reserve held at Kestrel pending Comms request count=2")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 001] Kestrel route registered")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 002] Tarsis route registered")
    await task_schedule(khovan_act1_apply_source_authorized_start_state)
    await task_schedule(khovan_act1_setup_kestrel_and_tarsis_contacts)
    await task_schedule(khovan_scenario_control_panel_update_overview)
    log("Khovan Slice 04 Act I generator/Tarsis gate initialized. Source-authorized starting ordnance set requested; live smoke must verify the Weapons UI.")
    ->END

