=== khovan_act1_apply_source_authorized_start_state ===
    generator_governor_active = True
    starting_homing_torpedoes = 2
    homing_reserve_count = 2
    artemis_start_energy_runtime_apply_status = "not_overridden_zero_energy_not_source_authorized"
    if artemis_id == 0:
        artemis_start_condition_status = "skipped_missing_artemis_id"
        artemis_start_ordnance_runtime_apply_status = "skipped_missing_artemis_id"
        script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting energy set to Cosmos default with generator governor active; zero-energy start not source-authorized")
        script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting ordnance not set: missing Artemis id")
        ->END

    set_data_set_value(artemis_id, "Homing_NUM", artemis_start_homing_torpedoes, 0)
    set_data_set_value(artemis_id, "Nuke_NUM", artemis_start_nukes, 0)
    set_data_set_value(artemis_id, "EMP_NUM", artemis_start_emps, 0)
    set_data_set_value(artemis_id, "Mine_NUM", artemis_start_mines, 0)
    homing_reserve_status = "runtime_set_requested"
    homing_reserve_runtime_apply_status = "runtime_set_requested_live_smoke_required"
    homing_reserve_live_inventory_status = "runtime_set_requested_live_smoke_required"
    artemis_start_condition_status = "source_authorized_generator_governor_two_homing_no_other_ordnance"
    artemis_start_ordnance_runtime_apply_status = "requested_homing_2_nuke_0_emp_0_mine_0"
    script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting energy set to Cosmos default with generator governor active; zero-energy start not source-authorized")
    script.write_khovan_startup_trace("[KHOVAN ACT1 START STATE] Artemis starting ordnance set to Homing=2 Nuke=0 EMP=0 Mine=0")
    ->END

=== khovan_act1_setup_kestrel_and_tarsis_contacts ===
    existing_kestrel_yards = to_object_list(role("kestrel_yards"))
    if len(existing_kestrel_yards) > 0:
        kestrel_yards_id = existing_kestrel_yards[0].id
    else:
        kestrel_yards = npc_spawn(0, 0, 0, "Kestrel Yards", "tsn, station, kestrel_yards, khovan_origin", "starbase_command", "behav_station")
        kestrel_yards_id = to_id(kestrel_yards)
        set_face(kestrel_yards_id, random_terran(civilian=True))
        sim.add_navproxy(kestrel_yards_id, "Kestrel Yards", "starbase_command", "#4A7")
    add_role(kestrel_yards_id, "Station")
    # Kestrel starts as a mechanical hold, not a Legendary docking transition.
    remove_role(kestrel_yards_id, "station")
    add_role(kestrel_yards_id, "kestrel_yards")
    kestrel_roles = to_object(kestrel_yards_id).get_roles()
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS 003] Kestrel standard station setup complete roles={kestrel_roles}")

    existing_tarsis_station = to_object_list(role("tarsis_station"))
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 004A] Tarsis Station spawn attempted")
    if len(existing_tarsis_station) > 0:
        tarsis_station_id = existing_tarsis_station[0].id
    else:
        tarsis_station = npc_spawn(18000, 0, 0, "Tarsis Station", "tsn, station, tarsis_station, khovan_drill_resupply", "starbase_command", "behav_station")
        tarsis_station_id = to_id(tarsis_station)
        set_face(tarsis_station_id, random_terran(civilian=True))
        sim.add_navproxy(tarsis_station_id, "Tarsis Station", "starbase_command", "#4A7")
    add_role(tarsis_station_id, "Station")
    remove_role(tarsis_station_id, "station")
    add_role(tarsis_station_id, "tarsis_station")
    tarsis_roles = to_object(tarsis_station_id).get_roles()
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS 004B] Tarsis Station spawned id={tarsis_station_id}")
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 COMMS 004] Tarsis standard station setup complete roles={tarsis_roles}")
    script.write_khovan_startup_trace("[KHOVAN ACT1 SCAN 001] Tarsis contact available for Slice 04 Comms; Science scan remains observational only")

    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 001] docking setup scheduled")
    kestrel_start_docking_helper_status = "skipped_startup_hold_uses_mechanical_fallback"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 001K] Kestrel Legendary docking helper skipped for startup mechanical hold fallback")
    kestrel_yard_lock_visual_status = "attempted_mechanical_fallback"
    script.write_khovan_startup_trace("[KHOVAN ACT1 VISUAL 001] Kestrel yard-lock visual setup attempted")
    await task_schedule(docking_standard_player_station)
    if tarsis_station_id != 0:
        add_role(tarsis_station_id, "station")
        remove_role(tarsis_station_id, "Station")
        tarsis_comms_options_status = "station_role_restored_after_docking_helper_pass"
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 004D] Tarsis station role restored and stock Station role removed after docking helper pass for Khovan Comms options")
    for player_id in role("__player__"):
        if kestrel_yards_id != 0:
            science_set_scan_data(player_id, kestrel_yards_id, "Kestrel Yards is Artemis' launch yard and active departure-control contact.")
            link(player_id, "extra_scan_source", kestrel_yards_id)
        if tarsis_station_id != 0:
            science_set_scan_data(player_id, tarsis_station_id, "Tarsis Station is the Kestrel generator handoff and resupply contact for Artemis.")
            link(player_id, "extra_scan_source", tarsis_station_id)
            docking_set_docking_logic(player_id, tarsis_station_id, khovan_tarsis_docking_rejected_before_clearance)
    tarsis_docking_gate_status = "blocked_until_docking_clearance"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 002] docking setup applied or failed/stubbed")
    if artemis_id != 0 and kestrel_yards_id != 0:
        kestrel_departure_hold_status = "scheduled"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 001] Kestrel departure hold scheduled")
        artemis_object = to_object(artemis_id)
        if artemis_object is not None:
            artemis_object.pos = Vec3(0, 0, 500)
            artemis_object.data_set.set("dock_base_id", 0, 0)
            artemis_object.data_set.set("dock_state", "undocked", 0)
            artemis_object.data_set.set("playerThrottle", 0, 0)
            kestrel_departure_hold_status = "active"
            kestrel_departure_hold_release_status = "waiting_for_clearance"
            script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 002] Artemis mechanical hold fallback active at Kestrel pending departure clearance")
            await task_schedule(khovan_reach_stub_dillon_clip_1)
            await task_schedule(khovan_act1_show_kestrel_yard_lock_visual_fallback)
            task_schedule(khovan_act1_hold_artemis_at_kestrel_until_clearance)
        else:
            kestrel_departure_hold_status = "stopped_artemis_object_missing"
            script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000C] Kestrel departure hold stopped missing Artemis object")
    else:
        kestrel_departure_hold_status = "not_scheduled_missing_artemis_or_kestrel"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000] Kestrel departure hold not scheduled missing Artemis or Kestrel id")
    tarsis_docking_resupply_status = "preclearance_docking_blocked_resupply_unproven"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DOCK 002A] Tarsis pre-clearance docking blocker installed id={tarsis_station_id}; mechanical docking/resupply remains live-smoke only")
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003] Tarsis docking setup held behind docking clearance")
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003A] Premature Tarsis docking uses Khovan clearance-denied handler until clearance; dock-button visibility requires live proof")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 003A] Kestrel marked known to player ships for departure Comms")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 004C] Tarsis Slice 04 Comms contact available without hard Science-scan gate")
    script.write_khovan_startup_trace("[KHOVAN ACT1 003] Kestrel/Tarsis contacts initialized")
    script.write_khovan_startup_trace("[KHOVAN ACT1 003C] Kestrel/Tarsis use reference-backed standard station primitives")
    script.write_khovan_startup_trace("[KHOVAN ACT1 003D] Khovan station presentation polish deferred until standard Comms/docking path is proven")
    log(f"Khovan Act I contacts initialized: Kestrel id {kestrel_yards_id}, Tarsis id {tarsis_station_id}.")
    ->END

=== khovan_tarsis_docking_rejected_before_clearance ===
metadata: ``` yaml
distance: 600
```
+++ enable
    yield fail if DOCKING_NPC_ID == 0
    yield fail if tarsis_docking_clearance_requested
    yield fail if DOCKING_NPC_ID != tarsis_station_id

+++ docking
    tarsis_docking_gate_status = "preclearance_docking_rejected_missing_clearance"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK BLOCKED] Tarsis docking rejected: clearance not granted")
    with comms_override(DOCKING_NPC_ID, DOCKING_PLAYER_ID, from_name="Tarsis Docking Control"):
        <<[yellow,black] "Docking Clearance Required"
            % {tarsis_docking_rejection_text}
    yield fail

=== khovan_act1_show_kestrel_yard_lock_visual_fallback ===
    if kestrel_yard_lock_message_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Kestrel yard-lock startup message")
        ->END

    kestrel_yard_lock_message_sent = True
    kestrel_yard_lock_visual_status = "fallback_active_mechanical_yard_lock_overlay"
    script.write_khovan_startup_trace("[KHOVAN ACT1 VISUAL 002] Kestrel mechanical yard-lock visual fallback active")
    await task_schedule(khovan_reach_send_safe_startup_message, {"startup_sender": "Kestrel Yard Control", "startup_text": kestrel_yard_lock_visual_text, "startup_title_color": "green", "startup_sender_id": kestrel_yards_id, "startup_player_id": artemis_id, "startup_breadcrumb": "[KHOVAN ACT1 MSG KESTREL 001] Kestrel yard-lock message sent"})
    ->END

=== khovan_act1_hold_artemis_at_kestrel_until_clearance ===
    if artemis_id == 0:
        kestrel_departure_hold_status = "stopped_missing_artemis"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000A] Kestrel departure hold stopped missing Artemis id")
        ->END
    if kestrel_yards_id == 0:
        kestrel_departure_hold_status = "stopped_missing_kestrel"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000B] Kestrel departure hold stopped missing Kestrel id")
        ->END

    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        kestrel_departure_hold_status = "stopped_artemis_object_missing"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 000C] Kestrel departure hold stopped missing Artemis object")
        ->END

    if kestrel_departure_clearance_granted:
        await task_schedule(khovan_act1_release_kestrel_departure_hold)
        ->END

    artemis_object.pos = Vec3(0, 0, 500)
    artemis_object.data_set.set("dock_base_id", 0, 0)
    artemis_object.data_set.set("dock_state", "undocked", 0)
    artemis_object.data_set.set("playerThrottle", 0, 0)
    if kestrel_departure_hold_status != "active":
        kestrel_departure_hold_status = "active"
        kestrel_departure_hold_release_status = "waiting_for_clearance"
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 002] Artemis mechanical hold fallback active at Kestrel pending departure clearance")
    await delay_sim(seconds=1)
    jump khovan_act1_hold_artemis_at_kestrel_until_clearance
    ->END

=== khovan_act1_release_kestrel_departure_hold ===
    artemis_object = to_object(artemis_id)
    if artemis_object is not None:
        artemis_object.data_set.set("dock_base_id", 0, 0)
        artemis_object.data_set.set("dock_state", "undocked", 0)
        artemis_object.data_set.set("playerThrottle", 0, 0)
    if kestrel_departure_hold_status != "released_after_clearance":
        script.write_khovan_startup_trace("[KHOVAN ACT1 HOLD 003] Kestrel departure hold released after clearance")
    kestrel_departure_hold_status = "released_after_clearance"
    kestrel_departure_hold_release_status = "released"
    log("Khovan Act I Kestrel departure hold released after Comms clearance.")
    ->END

=== khovan_act1_record_progression ===
    default action = "unknown"
    default detail = ""
    act1_last_progression_summary = f"{action}: {detail}"
    scenario_control_panel_last_action = f"act1:{action}"
    scenario_control_panel_action_log = f"{scenario_control_panel_action_log} | ACT1 {action}: {detail}"
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

=== khovan_kestrel_hail ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006] Kestrel Hail option selected")
    if not kestrel_departure_clearance_granted:
        comms_receive("Artemis, Kestrel Yard Control. You are inside the refit-yard control zone. Request departure clearance when your crew is ready to release from the yard.", title="Kestrel Yard Control", title_color="green")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006H] Kestrel Hail option response sent")
        yield success

    comms_receive("Artemis, Kestrel Yard Control. Departure clearance is logged. Report launch-envelope clear once Helm is outside the yard control zone.", title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006H] Kestrel Hail option response sent")
    yield success

=== khovan_kestrel_review_emergency_homing_reserve ===
    homing_reserve_review_status = "status_packet_sent"
    script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE 001] emergency homing reserve status requested")
    comms_receive(kestrel_homing_reserve_review_text, title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 RESERVE BLOCKED] mechanical conversion API unproven; status-only packet sent")
    await task_schedule(khovan_act1_record_progression, {"action": "kestrel_homing_reserve_review", "detail": "status-only emergency homing reserve packet sent; mechanical conversion API unproven"})
    yield success

=== khovan_kestrel_request_departure_clearance ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006A] Kestrel departure-clearance option selected")
    if kestrel_departure_clearance_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Kestrel departure clearance response")
        yield success

    kestrel_departure_clearance_granted = True
    kestrel_departure_gate_status = "clearance_granted_waiting_launch_envelope"
    current_beat = "kestrel_departure_clearance_granted"
    script.write_khovan_startup_trace("[KHOVAN ACT1 004] Kestrel departure clearance granted")
    await task_schedule(khovan_act1_release_kestrel_departure_hold)
    await task_schedule(khovan_act1_record_progression, {"action": "kestrel_departure_clearance", "detail": "departure clearance granted; waiting for launch envelope confirmation"})
    kestrel_departure_clearance_response_sent = True
    comms_receive("Kestrel Yard Control: departure clearance granted. Helm may clear the launch envelope.", title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG KESTREL 002] departure clearance packet sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006D] Kestrel departure-clearance option response sent")
    yield success

=== khovan_kestrel_report_launch_envelope_clear ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006B] Kestrel launch-envelope option selected")
    if not kestrel_departure_clearance_granted:
        comms_receive("Artemis, Kestrel Yard Control. Departure clearance is not in the log. Request clearance before reporting launch-envelope clear.", title="Kestrel Yard Control", title_color="yellow")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006E] Kestrel launch-envelope option rejected before clearance")
        yield fail

    if kestrel_launch_envelope_response_sent:
        if kestrel_generator_advisory_sent:
            script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] advisory timer ignored because already sent after duplicate launch-envelope confirmation")
        else:
            script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Kestrel launch-envelope response")
        yield success

    launch_envelope_cleared = True
    kestrel_departure_gate_status = "launch_envelope_cleared"
    kestrel_generator_advisory_status = "timer_started"
    current_beat = "launch_envelope_cleared_generator_advisory_timer"
    kestrel_generator_advisory_run_id = kestrel_generator_advisory_run_id + 1
    script.write_khovan_startup_trace("[KHOVAN ACT1 005] launch envelope clear confirmed; Kestrel advisory timer started")
    await task_schedule(khovan_act1_record_progression, {"action": "launch_envelope_cleared", "detail": "temporary Comms confirmation started 10-second advisory timer"})
    task_schedule(khovan_act1_deliver_kestrel_generator_advisory_after_delay, {"advisory_run_id": kestrel_generator_advisory_run_id})
    kestrel_launch_envelope_response_sent = True
    comms_receive("Kestrel Yard Control logs Artemis clear of the launch envelope. Advisory packet will follow after yard telemetry catches up.", title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG KESTREL 003] launch-envelope packet sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006E] Kestrel launch-envelope option response sent")
    yield success

=== khovan_act1_deliver_kestrel_generator_advisory_after_delay ===
    default advisory_run_id = kestrel_generator_advisory_run_id
    await delay_sim(seconds=10)
    if advisory_run_id != kestrel_generator_advisory_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed stale Kestrel advisory timer")
        ->END
    if not launch_envelope_cleared:
        ->END
    if kestrel_generator_packet_sent or kestrel_generator_advisory_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] advisory timer ignored because already sent")
        ->END

    kestrel_generator_packet_sent = True
    kestrel_generator_advisory_sent = True
    kestrel_generator_advisory_status = "delivered"
    act1_comms_archive_status = "trace_and_action_log_stub; Comms archive UI not separately proven"
    current_beat = "kestrel_generator_advisory_delivered"
    script.write_khovan_startup_trace("[KHOVAN ACT1 006] Kestrel advisory delivered after 10-second timer")
    await task_schedule(khovan_reach_send_safe_startup_message, {"startup_sender": "Kestrel Yard Control", "startup_text": kestrel_generator_advisory_text, "startup_title_color": "green", "startup_sender_id": kestrel_yards_id, "startup_player_id": artemis_id, "startup_breadcrumb": "[KHOVAN ACT1 MSG KESTREL 004] generator advisory packet sent"})
    await task_schedule(khovan_act1_record_progression, {"action": "kestrel_generator_advisory", "detail": "delivered by guarded text packet; archive represented by Comms response/trace/action log"})
    await task_schedule(khovan_act1_send_training_speed_power_reminder)
    log("Khovan Act I Kestrel generator advisory delivered after launch-envelope timer.")
    ->END

=== khovan_act1_send_training_speed_power_reminder ===
    if training_speed_power_reminder_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Training Control speed-power reminder")
        ->END
    if not kestrel_generator_advisory_sent:
        ->END

    training_speed_power_reminder_sent = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] Training Control speed-power reminder sent after advisory")
    await task_schedule(khovan_reach_send_safe_startup_message, {"startup_sender": "Training Control", "startup_text": training_speed_power_reminder_text, "startup_title_color": "cyan", "startup_sender_id": kestrel_yards_id, "startup_player_id": artemis_id, "startup_breadcrumb": "[KHOVAN ACT1 MSG TRAINING 001] Training speed-power reminder sent"})
    ->END

=== khovan_kestrel_resend_generator_advisory ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006C] Kestrel resend-advisory option selected")
    if not kestrel_generator_packet_sent or not kestrel_generator_advisory_sent:
        comms_receive("Kestrel Yard Control has not issued the generator advisory yet.", title="Kestrel Yard Control", title_color="yellow")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006F] Kestrel resend-advisory option rejected before advisory")
        yield fail

    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] Kestrel advisory resend did not restart timer")
    comms_receive(kestrel_generator_advisory_text, title="Kestrel Yard Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 006F] Kestrel resend-advisory option response sent")
    yield success

=== khovan_tarsis_hail ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008] Tarsis Hail option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS HAIL] Tarsis hail selected")
    if current_scene < 2:
        current_scene = 2
    current_beat = "tarsis_gate_active"
    await task_schedule(khovan_tarsis_update_gate_status)
    script.write_khovan_startup_trace("[KHOVAN ACT1 007] Tarsis hailed; gate active")
    comms_receive(tarsis_hail_text, title="Tarsis Station", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 001] hail response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008H] Tarsis Hail option response sent")
    yield success

=== khovan_tarsis_request_homing_priority ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008A] Tarsis homing-priority option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS HOMING] homing priority requested")
    if tarsis_homing_priority_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Tarsis homing-priority response")
        yield success

    tarsis_homing_priority_requested = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 008] Tarsis homing-priority request marked")
    await task_schedule(khovan_tarsis_update_gate_status)
    await task_schedule(khovan_act1_record_progression, {"action": "tarsis_homing_priority", "detail": "homing torpedo production priority requested"})
    tarsis_homing_priority_response_sent = True
    comms_receive(tarsis_homing_priority_text, title="Tarsis Production Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 002] homing priority response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008F] Tarsis homing-priority option response sent")
    yield success

=== khovan_tarsis_request_generator_support ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008B] Tarsis generator-acceptance option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS GENERATOR] generator support requested")
    if tarsis_generator_support_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Tarsis generator-support response")
        yield success

    tarsis_generator_support_requested = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 009] Tarsis generator-support request marked")
    await task_schedule(khovan_tarsis_update_gate_status)
    await task_schedule(khovan_act1_record_progression, {"action": "tarsis_generator_support", "detail": "generator acceptance/support requested"})
    tarsis_generator_support_response_sent = True
    comms_receive(tarsis_generator_support_text, title="Tarsis Generator Acceptance", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 003] generator support response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008G] Tarsis generator-acceptance option response sent")
    yield success

=== khovan_tarsis_request_docking_clearance ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008C] Tarsis docking-clearance option selected")
    if tarsis_docking_clearance_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Tarsis docking-clearance response")
        yield success

    if not tarsis_homing_priority_requested or not tarsis_generator_support_requested:
        tarsis_docking_clearance_requested = False
        script.write_khovan_startup_trace("[KHOVAN ACT1 010] Tarsis docking clearance blocked by missing request")
        script.write_khovan_startup_trace("[KHOVAN ACT1 010A] governor remains held; Tarsis required requests incomplete")
        await task_schedule(khovan_tarsis_update_gate_status)
        await task_schedule(khovan_act1_record_progression, {"action": "tarsis_docking_clearance_blocked", "detail": "homing priority and generator support must be logged first"})
        comms_receive("Tarsis Docking Control: hold docking request. We need homing production priority and generator acceptance logged before clearing the yard-lock lane.", title="Tarsis Docking Control", title_color="yellow")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008I] Tarsis docking-clearance option rejected before prerequisites")
        yield fail

    tarsis_docking_clearance_requested = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 011] Tarsis docking-clearance request marked")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS CLEARANCE] docking clearance requested/granted")
    await task_schedule(khovan_tarsis_update_gate_status)
    await task_schedule(khovan_tarsis_enable_docking_after_clearance)
    await task_schedule(khovan_act1_record_progression, {"action": "tarsis_docking_clearance", "detail": "docking clearance requested/granted after required prior requests"})
    tarsis_docking_clearance_response_sent = True
    comms_receive(tarsis_docking_clearance_text, title="Tarsis Docking Control", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 004] docking clearance response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008I] Tarsis docking-clearance option response sent")
    yield success

=== khovan_tarsis_enable_docking_after_clearance ===
    if not tarsis_docking_clearance_requested:
        tarsis_docking_gate_status = "enable_blocked_missing_clearance"
        script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003B] Tarsis docking setup enable blocked before clearance")
        ->END

    if tarsis_station_id == 0:
        tarsis_docking_gate_status = "enable_failed_missing_tarsis_station"
        script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 003C] Tarsis docking setup enable failed missing station id")
        ->END

    add_role(tarsis_station_id, "station")
    for player_id in role("__player__"):
        link(player_id, "extra_scan_source", tarsis_station_id)
        docking_set_docking_logic(player_id, tarsis_station_id, docking_dock_with_friendly_station)
    tarsis_docking_gate_status = "enabled_after_docking_clearance"
    tarsis_docking_resupply_status = "docking_enabled_after_clearance_resupply_unproven"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DOCK 004] Tarsis docking setup enabled after clearance")
    ->END

=== khovan_tarsis_update_gate_status ===
    if tarsis_homing_priority_requested and tarsis_generator_support_requested and tarsis_docking_clearance_requested:
        tarsis_required_requests_complete = True
        tarsis_gate_status = "requests_complete_waiting_for_docking_resupply"
    elif tarsis_homing_priority_requested and tarsis_generator_support_requested:
        tarsis_required_requests_complete = False
        tarsis_gate_status = "waiting_for_docking_clearance_request"
    elif tarsis_homing_priority_requested:
        tarsis_required_requests_complete = False
        tarsis_gate_status = "waiting_for_generator_support_and_docking_clearance"
    elif tarsis_generator_support_requested:
        tarsis_required_requests_complete = False
        tarsis_gate_status = "waiting_for_homing_priority_and_docking_clearance"
    else:
        tarsis_required_requests_complete = False
        tarsis_gate_status = "waiting_for_three_required_requests"
    ->END

=== khovan_tarsis_report_gate_status ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008E] Tarsis status-report option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS STATUS] Tarsis gate status requested")
    await task_schedule(khovan_tarsis_update_gate_status)
    if generator_governor_active:
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 011A] governor remains held; tarsis_gate_status={tarsis_gate_status}")

    homing_status_text = "not set"
    if tarsis_homing_priority_requested:
        homing_status_text = "set"
    generator_status_text = "not received"
    if tarsis_generator_support_requested:
        generator_status_text = "received"
    docking_status_text = "not granted"
    if tarsis_docking_clearance_requested:
        docking_status_text = "granted"

    if tarsis_required_requests_complete:
        tarsis_gate_status_text = "Tarsis gate status: all required traffic complete. Docking/resupply handoff may proceed."
    else:
        tarsis_gate_status_text = f"Tarsis gate status: homing priority {homing_status_text}, generator support {generator_status_text}, docking clearance {docking_status_text}. Complete all three before docking/resupply handoff."

    comms_receive(tarsis_gate_status_text, title="Tarsis Station", title_color="cyan")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 006] gate status response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008K] Tarsis status-report option response sent")
    yield success

=== khovan_tarsis_confirm_docking_and_resupply ===
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008D] Tarsis docking/resupply confirmation option selected")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS TARSIS RESUPPLY] docking/resupply confirmed")
    if tarsis_governor_clear_response_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Tarsis governor-clear response")
        yield success

    if not tarsis_required_requests_complete:
        await task_schedule(khovan_tarsis_update_gate_status)
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 011B] governor remains held; docking/resupply confirmation blocked status={tarsis_gate_status}")
        comms_receive(f"Tarsis cannot clear the generator governor yet. Gate status: {tarsis_gate_status}.", title="Tarsis Station", title_color="yellow")
        script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008J] Tarsis docking/resupply confirmation option rejected before prerequisites")
        yield fail

    tarsis_resupply_confirmed = True
    generator_governor_active = False
    generator_governor_cleared = True
    tarsis_gate_status = "resupply_confirmed_governor_cleared"
    current_scene = 2
    current_beat = "tarsis_resupply_governor_cleared"
    last_checkpoint = "tarsis_resupply_governor_cleared"
    tarsis_governor_clear_response_sent = True
    script.write_khovan_startup_trace("[KHOVAN ACT1 012] Tarsis resupply confirmed; generator governor cleared")
    await task_schedule(khovan_act1_record_progression, {"action": "tarsis_resupply_governor_cleared", "detail": "all three requests complete; temporary Comms confirmation cleared governor"})
    comms_receive(tarsis_resupply_text, title="Tarsis Station", title_color="green")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG TARSIS 005] docking/resupply response sent")
    script.write_khovan_startup_trace("[KHOVAN ACT1 COMMS 008J] Tarsis docking/resupply confirmation option response sent")
    yield success
