# Operator decision 2026-08-16: one confirmed hit, reduced from three.
#
# The three-hit gate was written before the stock crit mechanic was read from
# source. legendarymissions/consoles/manual_weapons.mast:187 rolls
# random.randint(1,20) == 20 once per PRESS of a subsystem button, so three
# confirmed hits is ~60 button presses, and manual_weapons.mast:169-173 clears
# an armed critical whenever the player switches subsystem. One successful
# critical teaches the lesson the drill exists for; the other two taught
# patience with a d20.
#
# FINDING for the operator, not for the build side to close: design
# 10_mast_requirements.md section 8.5 gate 9 still reads "three confirmed
# hits". The doc is design authority and AGENTS.md section 2 forbids editing
# docs/01_design/ from implementation work - the operator authorized this
# runtime change and owns the matching doc edit.
shared drone_01_required_weapons_hits = 1
# Subsystem-damage observer. Replaces the MANUAL_SYSTEM inventory read that used
# to drive hit counting - see khovan_drone_01_watch_weapons_subsystem_damage.
shared drone_01_weapons_damage_baseline = 0
shared drone_01_weapons_damage_run_id = 0
shared drone_01_weapons_damage_observer_status = "not_started"
shared drone_01_science_report_request_sent = False
shared drone_01_weapons_disabled = False
shared drone_01_ceasefire_confirmed = False
shared drone_01_destroyed_in_error = False
shared drone_01_cleanup_in_progress = False
shared drone_01_destruction_source = "not_observed"
shared drone_01_scan_fallback_available = False
shared drone_01_hail_fallback_available = False
shared drone_01_shield_relay_fallback_available = False
shared drone_01_weapons_lock_fallback_available = False
shared drone_01_range_fallback_available = False
shared drone_01_stationary_hold_fallback_available = False
shared drone_01_subsystem_hit_fallback_available = False
shared drone_01_ceasefire_fallback_available = False
shared drone_01_instruction_sent = False
shared drone_01_reset_message_sent = False
shared drone_01_hail_response_text = "Training drone acknowledges. Transponder reads TSN training contact. Stand by for further instructions."
shared drone_01_known_scan_text = "Drone 01: TSN training contact. Transponder active."
# Comms-channel acknowledgements for every drone drill gate, automatic or
# fallback. Design principle (source_index.md section 8): every microachievement
# gets a Comms confirmation, not just the current-objective (blue text) update -
# see the proven pattern in act1_generator_tarsis_gate.mast's Kestrel/Tarsis
# handlers, every one of which pairs a comms_receive with any objective change.
shared drone_01_scan_confirmed_text = "Artemis - Science: Scan confirmed. Drone 01 reads as a TSN training contact."
shared drone_01_shield_relay_confirmed_text = "Artemis - Science: Weak shield frequency relayed to Weapons."
shared drone_01_weapons_lock_next_step_text = "Artemis - Weapons: Lock beams on Drone 01.\nArtemis - Helm: Bring us between 1 and 2 kilometres and hold stationary for fifteen seconds."
shared drone_01_weapons_lock_confirmed_text = "Artemis - Weapons: Beam lock confirmed on Drone 01."
shared drone_01_range_confirmed_text = "Artemis - Helm: Range confirmed, one to two kilometres from Drone 01."
shared drone_01_stationary_hold_confirmed_text = "Artemis - Helm: Stationary hold confirmed."
shared drone_01_fire_authorized_confirmed_text = "Artemis - Captain: Fire clearance issued for the controlled disable."
shared drone_01_weapons_disabled_confirmed_text = "Artemis - Weapons: Drone 01's weapons array is disabled."
shared drone_01_ceasefire_confirmed_text = "Artemis - Weapons: Ceasefire confirmed on Drone 01."
shared drone_02_destroyed_confirmed_text = "Artemis - Weapons: Drone 02 destroyed."
# Coaching lines. Both describe the STOCK manual-targeting mechanic exactly as
# legendarymissions/consoles/manual_weapons.mast implements it - do not reword
# these into "more beam hits means more critical chance", which is the intuitive
# reading and is wrong for this engine:
#
#   manual_weapons_shoot (manual_weapons.mast:163-193) runs once per PRESS of a
#   subsystem button on the Manual Weapons console, and rolls
#   random.randint(1,20) == 20. Only on that 1-in-20 does it arm MANUAL_SYSTEM +
#   MANUAL_CRITICAL_HIT and broadcast "Potential Critical hit" in yellow. Beam
#   rate does not enter the roll at all - it only decides how fast an already
#   armed critical gets consumed by the next hit.
#
#   Lines 169-173: pressing a DIFFERENT subsystem button clears the armed
#   critical and broadcasts "Lost Critical hit, chance". Alternating between
#   weapons and engines therefore destroys progress rather than doubling it.
shared drone_01_science_report_request_text = "Artemis - Science: Report the drone's shield status and any subsystem damage now, and after every confirmed hit. Weapons is shooting blind until you call it."
shared drone_01_weapons_crit_technique_text = "Artemis - Weapons: Manual targeting does not damage a subsystem on every hit. Each press of the subsystem button is its own chance at a critical, so keep pressing the same one. When the critical warning comes up, your next beam hit carries it - switch subsystems before it lands and you throw it away."
shared drone_01_known_marked = False
shared drone_01_hull_restore_count = 0

