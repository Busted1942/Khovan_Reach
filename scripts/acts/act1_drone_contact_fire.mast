=== khovan_subsys_control_build_grid ===
    # UNWIRED 2026-08-16 and deliberately left unreachable. The operator saw
    # their OWN DAMCON teams respond to a grid call aimed at an NPC, and
    # grid_apply_system_damage ends with explode_player_ship(). The grid
    # helpers behave as player-ship APIs. Do not add a menu entry back.
    # It is also pointless: the panel reads system_damage, and a grid build
    # RESETS that key to 0, which is the opposite of what is wanted.
    # Separates "does an interior exist" from "does damaging it move the panel".
    control_object = to_object(subsys_control_target_id)
    if control_object is None:
        subsys_control_status = "grid_skipped_no_target"
        ->END
    grid_rebuild_grid_objects(subsys_control_target_id)
    subsys_control_node_count = len(grid_objects(subsys_control_target_id))
    subsys_control_status = f"grid_built_nodes_{subsys_control_node_count}"
    script.write_khovan_startup_trace(f"[KHOVAN SUBSYS CONTROL] grid built nodes={subsys_control_node_count}")
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Subsystem Control"):
        comms_receive(f"Interior built. node_count {subsys_control_node_count}\n\nZero means this hull has no interior, so grid damage cannot apply to it.", title="Khovan Subsystem Control", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_subsys_control")
    ->END

=== khovan_subsys_control_force_grid_damage ===
    # UNWIRED 2026-08-16 and deliberately left unreachable. The operator saw
    # their OWN DAMCON teams respond to a grid call aimed at an NPC, and
    # grid_apply_system_damage ends with explode_player_ship(). The grid
    # helpers behave as player-ship APIs. Do not add a menu entry back.
    # It is also pointless: the panel reads system_damage, and a grid build
    # RESETS that key to 0, which is the opposite of what is wanted.
    # Damages a real weapon node using the stock built-in, no shooting required.
    # The cleanest possible test of "does grid damage move the panel".
    control_object = to_object(subsys_control_target_id)
    if control_object is None:
        ->END
    control_landed = grid_damage_system(subsys_control_target_id, sbs.SHPSYS.WEAPONS)
    subsys_control_status = f"forced_grid_damage_landed_{control_landed}"
    script.write_khovan_startup_trace(f"[KHOVAN SUBSYS CONTROL] forced grid damage landed={control_landed}")
    await task_schedule(khovan_subsys_control_report)
    ->END

=== khovan_subsys_control_force_blob_write ===
    # Writes system_damage directly, which is exactly what the stock critical does,
    # with no console and no beam involved. If the panel does not move for this
    # either, the panel does not read this key and the question is settled.
    control_object = to_object(subsys_control_target_id)
    if control_object is None:
        ->END
    subsys_control_forced_damage = subsys_control_forced_damage + 1
    set_data_set_value(subsys_control_target_id, "system_damage", subsys_control_forced_damage, sbs.SHPSYS.WEAPONS)
    subsys_control_status = f"forced_blob_write_{subsys_control_forced_damage}"
    script.write_khovan_startup_trace(f"[KHOVAN SUBSYS CONTROL] forced blob write system_damage={subsys_control_forced_damage}")
    await task_schedule(khovan_subsys_control_report)
    ->END

=== khovan_subsys_control_report ===
    # Prints engine state so it can be read against the panel in the same instant.
    # That pairing is the measurement every earlier conclusion was missing.
    control_object = to_object(subsys_control_target_id)
    if control_object is None:
        with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Subsystem Control"):
            comms_receive("Control target is gone.", title="Khovan Subsystem Control", title_color="yellow")
        comms_navigate("//comms/gamemaster/khovan_subsys_control")
        ->END
    control_weap = control_object.data_set.get("system_damage", sbs.SHPSYS.WEAPONS)
    control_weap_max = control_object.data_set.get("system_max_damage", sbs.SHPSYS.WEAPONS)
    control_nodes = len(grid_objects(subsys_control_target_id))
    subsys_control_last_reading = f"system_damage {control_weap} of {control_weap_max}, grid nodes {control_nodes}"
    script.write_khovan_startup_trace(f"[KHOVAN SUBSYS CONTROL] {subsys_control_variant} blob {subsys_control_last_reading}")
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Subsystem Control"):
        comms_receive(f"{subsys_control_variant}\n\nENGINE SAYS\n{subsys_control_last_reading}\n\nNow read the Science panel for this contact. If the engine shows damage and the panel still reads 100 percent, the panel does not report NPC subsystem damage.", title="Khovan Subsystem Control", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_subsys_control")
    ->END

=== khovan_subsys_control_cleanup ===
    if subsys_control_target_id != 0:
        sbs.delete_object(subsys_control_target_id)
    subsys_control_target_id = 0
    subsys_control_active = False
    subsys_control_forced_damage = 0
    subsys_control_node_count = 0
    subsys_control_status = "cleaned_up"
    script.write_khovan_startup_trace("[KHOVAN SUBSYS CONTROL] cleaned up")
    ->END

=== khovan_drone_contact_fire_spawn_target_spike ===
    if drone_target_spike_active:
        await task_schedule(khovan_drone_contact_fire_report_target_spike)
        yield success

    await task_schedule(khovan_drone_contact_fire_reset_target_spike_flags)
    drone_target_spike_spawn_count = drone_target_spike_spawn_count + 1
    drone_contact_sequence_status = "target_spike_spawn_requested"
    drone_contact_last_step = "target_spike_spawn"
    drone_target_spike_status = "spawn_requested"
    # GM-only stock baseline: no Khovan object roles, nav proxy, scan link, or
    # forced player selection. Add only the stock raider role observed on a
    # known-good GM cruiser to expose the engine's normal Kralien Comms route.
    drone_target_spike_target = npc_spawn(32000, 0, 12000, "Kralien Cruiser", "kralien, raider", "kralien_cruiser", "behav_npcship")
    drone_target_spike_target_id = to_id(drone_target_spike_target)
    drone_target_spike_active = True
    drone_target_spike_status = "spawned_stock_kralien_cruiser"

    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE SPAWN] target_id={drone_target_spike_target_id} spawn_count={drone_target_spike_spawn_count}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "slice06_target_spike", "objective_body": "GM target spike active. Science scan, Comms hail, Weapons select, then test subsystem damage/destruction evidence.", "objective_step": "Slice 06 target spike", "objective_breadcrumb": "[KHOVAN OBJECTIVE 016S] objective updated: Slice 06 target spike"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    # EXPERIMENTAL (2026-08-08, unproven): live smoke confirmed the bare comms_receive()
    # call below never rendered visibly for the GM across 3+ sessions, on every GM-only
    # route in this file, while the same bare comms_receive() shape DID render correctly
    # for the player-facing Comms hail response at khovan_drone_contact_fire_hail_
    # spike_target. The cookbook's [LIVE] tag for bare comms_receive() (section 6.2) was
    # written for a player-facing case and does not appear to hold for GM-only routes.
    # Every OTHER proven-live comms_receive() call in this codebase wraps it in
    # comms_override(sender_id, player_id, from_name=...); this is the only proven shape
    # left untried. COMMS_ORIGIN_ID is guaranteed valid here since the route itself
    # requires has_roles(COMMS_ORIGIN_ID, "gamemaster") to match. Needs a live re-test
    # before this can be trusted; if it also fails, escalate as an API-uncertainty finding
    # rather than trying further variations blind.
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Slice 06 Spike"):
        comms_receive("Slice 06 target spike spawned as a neutral training target. Live-smoke Science scan, Comms hail, Weapons target selection, subsystem damage, destruction, and unwanted stock-menu behavior.", title="Khovan Slice 06 Spike", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_drone_contact_fire_spike")
    ->END

