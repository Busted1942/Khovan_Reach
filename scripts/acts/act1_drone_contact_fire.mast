//comms/gamemaster/khovan_drone_contact_fire_spike if has_roles(COMMS_ORIGIN_ID, "gamemaster") and test_mode_enabled
    + "Back" //comms/gamemaster/khovan_scenario_control_panel
    + "Spawn Target Spike" khovan_drone_contact_fire_spawn_target_spike if not drone_target_spike_active
    + "Select Target Spike" khovan_drone_contact_fire_select_target_spike if drone_target_spike_active
    + "Read Target Spike Status" khovan_drone_contact_fire_report_target_spike
    + "Cleanup Target Spike" khovan_drone_contact_fire_cleanup_target_spike if drone_target_spike_active or drone_target_spike_destroyed_observed
    + "Cleanup Drone 02" khovan_drone_02_cleanup if drone_02_active

=== khovan_act1_initialize_drone_contact_fire ===
    drone_contact_fire_initialized = True
    drone_contact_sequence_status = "phase_a_spike_ready"
    drone_contact_last_step = "initialized"
    drone_target_spike_available = True
    drone_target_spike_active = False
    drone_target_spike_status = "ready"
    drone_contact_sequence_run_id = drone_contact_sequence_run_id + 1
    drone_contact_production_available = False
    drone_contact_act2_ready = False
    drone_contact_act2_handoff_status = "not_ready"
    drone_contact_cultural_packet_sent = False
    script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 001] Slice 06 target subsystem-damage spike initialized")
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

=== khovan_act1_drone_contact_fire_prepare_after_engineering ===
    drone_contact_fire_initialized = True
    drone_contact_sequence_run_id = drone_contact_sequence_run_id + 1
    drone_contact_sequence_status = "drone_01_ready_after_engineering"
    drone_contact_last_step = "drone_01_ready_after_engineering"
    drone_contact_production_available = True
    drone_contact_profile_route = "full_or_compressed_runs_drone_02; direct_bypasses"
    drone_target_spike_available = True
    if drone_target_spike_status == "not_started":
        drone_target_spike_status = "ready"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 002] Drone 01 production sequence ready after Engineering shakedown")
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_ready", "objective_body": "Drone 01 training contact ready. Science scan, Comms hail, relay shield frequencies, then establish the controlled firing window.", "objective_step": "Drone 01 controlled disable", "objective_breadcrumb": "[KHOVAN OBJECTIVE 016] objective updated: Drone 01 ready"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

=== khovan_drone_contact_fire_reset_target_spike_flags ===
    drone_target_spike_scan_observed = False
    drone_target_spike_hail_observed = False
    drone_target_spike_weapons_selected = False
    drone_target_spike_damage_observed = False
    drone_target_spike_manual_subsystem_hit_observed = False
    drone_target_spike_manual_subsystem = "none"
    drone_target_spike_manual_critical_hit_observed = False
    drone_target_spike_weapons_damage_value = 0
    drone_target_spike_engines_damage_value = 0
    drone_target_spike_destroyed_observed = False
    drone_target_spike_destruction_source = "not_observed"
    drone_target_spike_cleanup_in_progress = False
    drone_target_spike_result = "unproven"
    drone_target_spike_blocker = "live_smoke_required"
    ->END

=== khovan_drone_contact_fire_spawn_target_spike ===
    if drone_target_spike_active:
        await task_schedule(khovan_drone_contact_fire_report_target_spike)
        yield success

    await task_schedule(khovan_drone_contact_fire_reset_target_spike_flags)
    drone_target_spike_spawn_count = drone_target_spike_spawn_count + 1
    drone_contact_sequence_status = "target_spike_spawn_requested"
    drone_contact_last_step = "target_spike_spawn"
    drone_target_spike_status = "spawn_requested"
    # API uncertainty / GM-only scan spike (2026-08-08): a hostile Kralien hull is
    # expected to expose the engine's normal shield-frequency scan data.  The
    # playership behavior has no NPC AI driver, so this active NPC should remain
    # stationary and cannot fire or repair itself without a client.  Live Cosmos
    # must confirm both observations; no production Drone behavior depends on it.
    drone_target_spike_target = npc_spawn(32000, 0, 12000, "Slice 06 Spike Target", "kralien, khovan_training, khovan_slice06_spike_target, khovan_drone_spike_target", "kralien_cruiser", "behav_playership")
    drone_target_spike_target_id = to_id(drone_target_spike_target)
    drone_target_spike_navproxy = sim.add_navproxy(drone_target_spike_target_id, "Slice 06 Spike Target", "kralien_cruiser", "#FC3")
    drone_target_spike_navproxy_id = to_id(drone_target_spike_navproxy)
    drone_target_spike_active = True
    drone_target_spike_status = "spawned_inert_hostile_scan_target"

    if artemis_id != 0 and drone_target_spike_target_id != 0:
        link(artemis_id, "extra_scan_source", drone_target_spike_target_id)
        set_science_selection(artemis_id, drone_target_spike_target_id)
        set_comms_selection(artemis_id, drone_target_spike_target_id)

    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE SPAWN] target_id={drone_target_spike_target_id} spawn_count={drone_target_spike_spawn_count}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "slice06_target_spike", "objective_body": "GM target spike active. Science scan, Comms hail, Weapons select, then test subsystem damage/destruction evidence.", "objective_step": "Slice 06 target spike", "objective_breadcrumb": "[KHOVAN OBJECTIVE 016S] objective updated: Slice 06 target spike"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    # EXPERIMENTAL (2026-08-08, unproven): live smoke confirmed the bare comms_receive()
    # call below never rendered visibly for the GM across 3+ sessions, on every GM-only
    # route in this file, while the same bare comms_receive() shape DID render correctly
    # for the player-facing Comms hail response at khovan_drone_contact_fire_hail_
    # spike_target. The cookbook's [LIVE] tag for bare comms_receive() (section 6.2) was
    # written for a player-facing case and does not appear to hold for GM-only routes.
    # Every OTHER proven-live comms_receive() call in this codebase wraps it in
    # comms_override(sender_id, player_id, from_name=...); this is the only proven shape
    # left untried. COMMS_ORIGIN_ID is guaranteed valid here since the route itself
    # requires has_roles(COMMS_ORIGIN_ID, "gamemaster") to match. Needs a live re-test
    # before this can be trusted; if it also fails, escalate as an API-uncertainty finding
    # rather than trying further variations blind.
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Slice 06 Spike"):
        comms_receive("Slice 06 target spike spawned as a neutral training target. Live-smoke Science scan, Comms hail, Weapons target selection, subsystem damage, destruction, and unwanted stock-menu behavior.", title="Khovan Slice 06 Spike", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_drone_contact_fire_spike")
    ->END

=== khovan_drone_contact_fire_select_target_spike ===
    if not drone_target_spike_active or drone_target_spike_target_id == 0:
        with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Slice 06 Spike"):
            comms_receive("Slice 06 target spike is not active.", title="Khovan Slice 06 Spike", title_color="yellow")
        comms_navigate("//comms/gamemaster/khovan_drone_contact_fire_spike")
        yield fail

    if artemis_id != 0:
        set_science_selection(artemis_id, drone_target_spike_target_id)
        set_comms_selection(artemis_id, drone_target_spike_target_id)
        set_weapons_selection(artemis_id, drone_target_spike_target_id)

    drone_target_spike_status = "selected_for_science_comms_weapons"
    drone_contact_last_step = "target_spike_selected"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE SELECT] target_id={drone_target_spike_target_id}")
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Slice 06 Spike"):
        comms_receive("Slice 06 target spike selected for Science, Comms, and Weapons where available.", title="Khovan Slice 06 Spike", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_drone_contact_fire_spike")
    ->END

=== khovan_drone_contact_fire_report_target_spike ===
    drone_target_spike_report = f"SLICE 06 TARGET SPIKE\nactive. {drone_target_spike_active}\ntarget_id. {drone_target_spike_target_id}\nstatus. {drone_target_spike_status}\nscan_observed. {drone_target_spike_scan_observed}\nhail_observed. {drone_target_spike_hail_observed}\nweapons_selected. {drone_target_spike_weapons_selected}\ndamage_observed. {drone_target_spike_damage_observed}\nmanual_subsystem_hit. {drone_target_spike_manual_subsystem_hit_observed}\nmanual_subsystem. {drone_target_spike_manual_subsystem}\nmanual_critical_hit. {drone_target_spike_manual_critical_hit_observed}\nweapons_damage. {drone_target_spike_weapons_damage_value}\nengines_damage. {drone_target_spike_engines_damage_value}\ndestroyed_observed. {drone_target_spike_destroyed_observed}\ndestruction_source. {drone_target_spike_destruction_source}\nstock_comms_menu. {drone_target_spike_stock_comms_menu_observation}\ntraining_safe. {drone_target_spike_training_safe_observation}\nresult. {drone_target_spike_result}\nblocker. {drone_target_spike_blocker}"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE STATUS] status_read requested target_id={drone_target_spike_target_id} active={drone_target_spike_active} result={drone_target_spike_result}")
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Slice 06 Spike"):
        comms_receive(drone_target_spike_report, title="Khovan Slice 06 Spike", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_drone_contact_fire_spike")
    ->END

=== khovan_drone_contact_fire_cleanup_target_spike ===
    if drone_target_spike_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_target_spike_navproxy_id)
        drone_target_spike_navproxy_id = 0
    if drone_target_spike_target_id != 0:
        if artemis_id != 0:
            set_science_selection(artemis_id, 0)
            set_comms_selection(artemis_id, 0)
            set_weapons_selection(artemis_id, 0)
        # Destroy-hook guard setup (2026-08-08, bugfix 2026-08-08 live): sbs.delete_object()
        # fires the same //damage/destroy hook a genuine Weapons kill fires (confirmed
        # live). Set this flag immediately before the call so the destroy handler can
        # attribute the event to cleanup rather than combat. Confirmed live (reproduced
        # across 4 independent cleanup events, pre- and post-fix) that the CLEANUP trace
        # line always logs BEFORE the resulting DAMAGE/DESTROY events - the destroy hook
        # is deferred/queued, not synchronous within this call. An earlier version of this
        # fix cleared the flag immediately after sbs.delete_object() as a same-build
        # "fallback," which was backwards: it cleared the flag before the destroy handler
        # ever got to read it, so the guard reported unattributed_zero_damage on every
        # cleanup instead of gm_cleanup. Do NOT clear the flag here. It is consumed
        # (read and cleared) inside the destroy handler once the deferred hook actually
        # fires. If sbs.delete_object() ever fails to trigger the hook at all, the flag
        # is still cleared safely by khovan_drone_contact_fire_reset_target_spike_flags
        # on the next spawn.
        drone_target_spike_cleanup_in_progress = True
        sbs.delete_object(drone_target_spike_target_id)
    drone_target_spike_target_id = 0
    drone_target_spike_active = False
    drone_target_spike_cleanup_count = drone_target_spike_cleanup_count + 1
    drone_target_spike_status = "cleaned_up"
    drone_contact_sequence_status = "target_spike_cleaned_up"
    drone_contact_last_step = "target_spike_cleanup"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE CLEANUP] cleanup_count={drone_target_spike_cleanup_count}")
    await task_schedule(khovan_scenario_control_panel_update_overview)
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Slice 06 Spike"):
        comms_receive("Slice 06 target spike cleaned up.", title="Khovan Slice 06 Spike", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_drone_contact_fire_spike")
    ->END

//enable/comms if has_roles(COMMS_SELECTED_ID, "khovan_slice06_spike_target")

//comms if has_roles(COMMS_SELECTED_ID, "khovan_slice06_spike_target")
    + "Khovan: Hail Spike Target" khovan_drone_contact_fire_hail_spike_target

=== khovan_drone_contact_fire_hail_spike_target ===
    drone_target_spike_hail_observed = True
    drone_target_spike_status = "comms_hail_observed"
    drone_contact_last_step = "target_spike_hail"
    drone_target_spike_stock_comms_menu_observation = "custom_khovan_route_visible_live_check_stock_menus"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE HAIL] hail observed target_id={COMMS_SELECTED_ID}")
    comms_receive("Training target acknowledges hail. Continue assigned contact procedures.", title="Slice 06 Spike Target", title_color="green")
    ->END

//select/weapons if has_role(WEAPONS_ORIGIN_ID, "__player__")
    if drone_target_spike_active and drone_target_spike_target_id != 0:
        selected_weapons_target_id = get_weapons_selection(WEAPONS_ORIGIN_ID)
        if selected_weapons_target_id == drone_target_spike_target_id:
            drone_target_spike_weapons_selected = True
            drone_target_spike_status = "weapons_selection_observed"
            drone_contact_last_step = "target_spike_weapons_selected"
            script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE WEAPONS SELECT] origin={WEAPONS_ORIGIN_ID} target_id={selected_weapons_target_id}")
    if drone_01_active and drone_01_target_id != 0:
        selected_weapons_target_id = get_weapons_selection(WEAPONS_ORIGIN_ID)
        if selected_weapons_target_id == drone_01_target_id:
            drone_01_weapons_lock_active = True
            drone_01_status = "weapons_lock_active"
            script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 WEAPONS LOCK] origin={WEAPONS_ORIGIN_ID} target_id={selected_weapons_target_id}")
            task_schedule(khovan_drone_01_watch_stationary_hold, {"hold_run_id": drone_01_stationary_hold_run_id})
    ->END

//damage/object if has_role(DAMAGE_TARGET_ID, "khovan_slice06_spike_target")
    drone_target_spike_damage_observed = True
    drone_target_spike_status = "damage_observed"
    drone_contact_last_step = "target_spike_damage"
    system = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM")
    target_id = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_CRITICAL_HIT")
    spike_target = to_object(DAMAGE_TARGET_ID)
    if spike_target is not None:
        # Bugfix (2026-08-08, confirmed live): data_set.get(key, default) is a flat key
        # lookup where the second argument is a fallback DEFAULT VALUE, not a subsystem
        # selector (proven pattern: artemis_object.data_set.get("playerThrottle", 0),
        # cookbook section 8). The prior code passed sbs.SHPSYS.WEAPONS/ENGINES as that
        # default, which is nonsensical for a damage float and was never reached anyway
        # since "system_damage" is always present. There is no proven per-subsystem
        # data_set key yet, so weapons/engines damage both read the same generic
        # "system_damage" total until one is proven live. Do not treat these two fields
        # as independently reliable per-subsystem values before that is proven.
        drone_target_spike_weapons_damage_value = spike_target.data_set.get("system_damage", 0)
        drone_target_spike_engines_damage_value = spike_target.data_set.get("system_damage", 0)
    # Bugfix (2026-08-08, confirmed live): previously required MANUAL_CRITICAL_HIT to
    # match DAMAGE_TARGET_ID AND MANUAL_SYSTEM to be non-None in the same event before
    # recording a subsystem hit. Live smoke 2026-08-08 showed MANUAL_SYSTEM fired
    # (SHPSYS.WEAPONS) on an event where MANUAL_CRITICAL_HIT was None, and the AND
    # discarded that real signal. Track subsystem-lock (MANUAL_SYSTEM) and critical-hit
    # (MANUAL_CRITICAL_HIT) independently until live evidence justifies requiring both.
    if system is not None:
        drone_target_spike_manual_subsystem_hit_observed = True
        drone_target_spike_manual_subsystem = system.name
        drone_target_spike_result = "manual_subsystem_hit_observed_live_unverified_until_operator_confirms"
        drone_target_spike_blocker = "none_if_live_operator_confirms_values"
    if target_id is not None and target_id != 0:
        drone_target_spike_manual_critical_hit_observed = True
    set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM", None)
    set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_CRITICAL_HIT", None)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE DAMAGE] target_id={DAMAGE_TARGET_ID} manual_target={target_id} manual_system={system} weapons_damage={drone_target_spike_weapons_damage_value} engines_damage={drone_target_spike_engines_damage_value}")
    ->END

//damage/destroy if has_role(DESTROYED_ID, "khovan_slice06_spike_target")
    drone_target_spike_destroyed_observed = True
    drone_target_spike_active = False
    drone_target_spike_status = "destroyed_observed"
    drone_contact_last_step = "target_spike_destroyed"
    # Destroy-hook guard (2026-08-08, confirmed workable on live trace data):
    # sbs.delete_object() in cleanup fires this same hook a genuine Weapons kill fires.
    # Primary signal: drone_target_spike_cleanup_in_progress, set by the cleanup handler
    # immediately before its delete_object() call and consumed (read + cleared) here.
    # Fallback signal, used only if cleanup_in_progress is False: a real kill leaves a
    # nonzero value in weapons/engines damage; a destroy with neither signal present is
    # unattributed and should not be assumed genuine without further investigation.
    if drone_target_spike_cleanup_in_progress:
        drone_target_spike_destruction_source = "gm_cleanup"
        drone_target_spike_result = "destruction_observed_gm_cleanup_not_a_kill"
        drone_target_spike_cleanup_in_progress = False
    elif drone_target_spike_weapons_damage_value > 0 or drone_target_spike_engines_damage_value > 0:
        drone_target_spike_destruction_source = "genuine_weapons_kill"
        drone_target_spike_result = "destruction_observed_genuine_weapons_kill"
    else:
        drone_target_spike_destruction_source = "unattributed_zero_damage"
        drone_target_spike_result = "destruction_observed_unattributed_needs_investigation"
    drone_target_spike_blocker = "none_if_live_operator_confirms_destruction_event"
    if drone_target_spike_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_target_spike_navproxy_id)
        drone_target_spike_navproxy_id = 0
    remove_role(DESTROYED_ID, "khovan_slice06_spike_target")
    remove_role(DESTROYED_ID, "khovan_drone_spike_target")
    if artemis_id != 0:
        set_science_selection(artemis_id, 0)
        set_comms_selection(artemis_id, 0)
        set_weapons_selection(artemis_id, 0)
    drone_target_spike_target_id = 0
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE SPIKE DESTROY] destroyed_id={DESTROYED_ID} destruction_source={drone_target_spike_destruction_source}")
    ->END

# Phase B production controls. Their player-facing acknowledgement is always the
# current-objective broadcast; GM-only comms_receive rendering is deliberately not used.
//comms if has_roles(COMMS_SELECTED_ID, "tarsis_station") and drone_contact_production_available
    + "Khovan: Deploy Drone 01" khovan_drone_01_spawn if not drone_01_active and not drone_01_weapons_disabled and not drone_contact_act2_ready
    + "Khovan: Confirm Drone 01 Ceasefire" khovan_drone_01_confirm_ceasefire if drone_01_weapons_disabled and not drone_01_ceasefire_confirmed
    + "Khovan: Fallback Scan" khovan_drone_01_fallback_scan if drone_01_scan_fallback_available
    + "Khovan: Fallback Hail" khovan_drone_01_fallback_hail if drone_01_hail_fallback_available
    + "Khovan: Fallback Shield Relay" khovan_drone_01_fallback_shield_relay if drone_01_shield_relay_fallback_available
    + "Khovan: Fallback Weapons Lock" khovan_drone_01_fallback_weapons_lock if drone_01_weapons_lock_fallback_available
    + "Khovan: Fallback Range" khovan_drone_01_fallback_range if drone_01_range_fallback_available
    + "Khovan: Fallback Stationary Hold" khovan_drone_01_fallback_stationary_hold if drone_01_stationary_hold_fallback_available
    + "Khovan: Fallback Weapons Hit" khovan_drone_01_fallback_weapons_hit if drone_01_subsystem_hit_fallback_available
    + "Khovan: Fallback Ceasefire" khovan_drone_01_fallback_ceasefire if drone_01_ceasefire_fallback_available

=== khovan_drone_01_reset_flags ===
    drone_01_scan_complete = False
    drone_01_hail_complete = False
    drone_01_shield_frequency_relay_complete = False
    drone_01_weapons_lock_active = False
    drone_01_range_band_active = False
    drone_01_stationary_hold_active = False
    drone_01_stationary_hold_run_id = drone_01_stationary_hold_run_id + 1
    drone_01_stationary_hold_seconds = 0
    drone_01_fire_authorized = False
    drone_01_manual_system = "none"
    drone_01_weapons_hit_count = 0
    drone_01_weapons_disabled = False
    drone_01_ceasefire_confirmed = False
    drone_01_destroyed_in_error = False
    drone_01_cleanup_in_progress = False
    drone_01_destruction_source = "not_observed"
    drone_01_scan_fallback_available = False
    drone_01_hail_fallback_available = False
    drone_01_shield_relay_fallback_available = False
    drone_01_weapons_lock_fallback_available = False
    drone_01_range_fallback_available = False
    drone_01_stationary_hold_fallback_available = False
    drone_01_subsystem_hit_fallback_available = False
    drone_01_ceasefire_fallback_available = False
    drone_01_reset_message_sent = False
    ->END

=== khovan_drone_01_spawn ===
    if shakedown_mode == "direct":
        drone_contact_sequence_status = "direct_scenario_drone_drills_bypassed"
        drone_contact_profile_route = "direct_bypass_no_failure_states"
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_drills_bypassed", "objective_body": "Direct Scenario selected: Drone drills are marked bypassed with no failure state.", "objective_step": "Act I drills bypassed", "objective_breadcrumb": "[KHOVAN ACT1 DRONE BYPASS] direct scenario"})
        ->END
    if drone_01_active:
        ->END
    if tarsis_station_id == 0:
        drone_01_status = "blocked_missing_tarsis_training_beacon"
        drone_01_range_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 BLOCKED] missing Tarsis Training Beacon id")
        ->END
    beacon = to_object(tarsis_station_id)
    if beacon is None:
        drone_01_status = "blocked_missing_tarsis_training_beacon_object"
        drone_01_range_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 BLOCKED] missing Tarsis Training Beacon object")
        ->END
    await task_schedule(khovan_drone_01_reset_flags)
    drone_01_spawn_count = drone_01_spawn_count + 1
    drone_01_target = npc_spawn(beacon.pos.x + drone_01_spawn_offset_m, beacon.pos.y, beacon.pos.z, "Drone 01", "khovan_training, neutral, khovan_drone_01", "tsn_warpster", "behav_npcship")
    drone_01_target_id = to_id(drone_01_target)
    if drone_01_target_id == 0:
        drone_01_status = "spawn_failed"
        drone_01_range_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 BLOCKED] npc_spawn returned id 0")
        ->END
    drone_01_navproxy = sim.add_navproxy(drone_01_target_id, "Drone 01", "tsn_warpster", "#FC3")
    drone_01_navproxy_id = to_id(drone_01_navproxy)
    drone_01_active = True
    drone_01_status = "spawned_passive_at_training_beacon_offset"
    # GM/Comms confirmations are final fallbacks for every automatic production gate.
    drone_01_scan_fallback_available = True
    drone_01_hail_fallback_available = True
    drone_01_shield_relay_fallback_available = True
    drone_01_weapons_lock_fallback_available = True
    drone_01_range_fallback_available = True
    drone_01_stationary_hold_fallback_available = True
    drone_contact_sequence_status = "drone_01_active"
    drone_contact_last_step = "drone_01_spawn"
    if artemis_id != 0:
        link(artemis_id, "extra_scan_source", drone_01_target_id)
        set_science_selection(artemis_id, drone_01_target_id)
        set_comms_selection(artemis_id, drone_01_target_id)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 SPAWN] target_id={drone_01_target_id} offset_m={drone_01_spawn_offset_m} spawn_count={drone_01_spawn_count}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_scan", "objective_body": "Drone 01 deployed. Science scan the contact; Comms hail it and relay its weak shield frequency to Weapons.", "objective_step": "Drone 01 scan and hail", "objective_breadcrumb": "[KHOVAN OBJECTIVE 017] Drone 01 deployed"})
    ->END

=== khovan_drone_01_reset ===
    default reset_reason = "unknown"
    if drone_01_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_01_navproxy_id)
        drone_01_navproxy_id = 0
    if drone_01_target_id != 0:
        drone_01_cleanup_in_progress = True
        sbs.delete_object(drone_01_target_id)
    drone_01_active = False
    drone_01_target_id = 0
    drone_01_reset_count = drone_01_reset_count + 1
    drone_01_reset_reason = reset_reason
    drone_01_spawn_offset_m = drone_01_spawn_offset_m + 5000
    drone_contact_sequence_run_id = drone_contact_sequence_run_id + 1
    if reset_reason == "unauthorized_damage":
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_reset", "objective_body": "Training Control: unauthorized hit detected. Target reset. Reacquire, reestablish range, and wait for clearance.", "objective_step": "Drone 01 reset", "objective_breadcrumb": "[KHOVAN ACT1 DRONE 01 RESET] unauthorized-hit reset message"})
    else:
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_reset", "objective_body": "Training Control: target destroyed. Drill objective was controlled subsystem disable. Target reset for repeat.", "objective_step": "Drone 01 reset", "objective_breadcrumb": "[KHOVAN ACT1 DRONE 01 RESET] premature-destruction reset message"})
    task_schedule(khovan_drone_01_reset_respawn, {"reset_run_id": drone_contact_sequence_run_id})
    ->END

=== khovan_drone_01_reset_respawn ===
    default reset_run_id = drone_contact_sequence_run_id
    # delete_object() dispatches //damage/destroy asynchronously; yield so the
    # production destroy guard consumes cleanup_in_progress before reset flags clear it.
    await delay_sim(seconds=1)
    # Run-ID guard, cookbook section 5.1. The yield above is a window a story
    # jump can land in: the jump seeds bump drone_contact_sequence_run_id
    # (see khovan_act1_drone_contact_fire_init and
    # khovan_act1_drone_contact_fire_prepare_after_engineering), so a reset
    # scheduled before the jump must not spawn Drone 01 into the scene the
    # jump landed in. Incrementing the counter in the reset label is not by
    # itself a guard - nothing re-read it after the delay before this label
    # existed.
    if reset_run_id != drone_contact_sequence_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 RESET] stale respawn suppressed after story-jump seed")
        ->END
    # Precondition still true: a reset respawn is pointless once the drill has
    # handed off to Act II.
    if drone_contact_act2_ready:
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 RESET] respawn suppressed after Act II handoff")
        ->END
    # Not-already-done: something else may have deployed Drone 01 during the yield.
    if drone_01_active:
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 RESET] respawn suppressed drone already active")
        ->END
    await task_schedule(khovan_drone_01_spawn)
    ->END

//enable/science if has_roles(SCIENCE_SELECTED_ID, "khovan_drone_01")

//science if has_roles(SCIENCE_SELECTED_ID, "khovan_drone_01")
    + "Initial Scan":
        drone_01_scan_complete = True
        drone_01_status = "science_scan_complete"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 SCAN] target_id={SCIENCE_SELECTED_ID}")
        <scan>
            % Drone 01 is a neutral training contact. Weak shield-frequency relay data is available for Weapons.
    + "scan":
        drone_01_scan_complete = True
        drone_01_status = "science_scan_complete"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 SCAN] target_id={SCIENCE_SELECTED_ID}")
        <scan>
            % Drone 01 is a neutral training contact. Weak shield-frequency relay data is available for Weapons.
    + "Relay Weak Shield Frequency":
        drone_01_shield_frequency_relay_complete = True
        drone_01_status = "shield_frequency_relay_complete"
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_weapons_lock", "objective_body": "Weapons lock beams on Drone 01. Helm establish 1-2 km range and hold stationary for 15 seconds.", "objective_step": "Drone 01 lock and range", "objective_breadcrumb": "[KHOVAN OBJECTIVE 018] shield relay complete"})

//enable/comms if has_roles(COMMS_SELECTED_ID, "khovan_drone_01")

//comms if has_roles(COMMS_SELECTED_ID, "khovan_drone_01")
    + "Khovan: Hail Drone 01" khovan_drone_01_hail

=== khovan_drone_01_hail ===
    drone_01_hail_complete = True
    drone_01_status = "comms_hail_complete"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 HAIL] target_id={COMMS_SELECTED_ID}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_relay", "objective_body": "Drone 01 acknowledges training status. Science relay the weak shield frequency to Weapons.", "objective_step": "Drone 01 shield relay", "objective_breadcrumb": "[KHOVAN OBJECTIVE 017A] Drone 01 hail complete"})
    ->END

=== khovan_drone_01_watch_stationary_hold ===
    default hold_run_id = drone_01_stationary_hold_run_id
    if hold_run_id != drone_01_stationary_hold_run_id or not drone_01_active:
        ->END
    if artemis_id == 0 or drone_01_target_id == 0:
        drone_01_range_fallback_available = True
        drone_01_stationary_hold_fallback_available = True
        drone_01_status = "fallback_missing_range_or_artemis_id"
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        drone_01_range_fallback_available = True
        drone_01_stationary_hold_fallback_available = True
        drone_01_status = "fallback_missing_artemis_object"
        ->END
    drone_range = sbs.distance_id(artemis_id, drone_01_target_id)
    if drone_range < 1000 or drone_range > 2000:
        drone_01_range_band_active = False
        drone_01_stationary_hold_active = False
        drone_01_stationary_hold_seconds = 0
        drone_01_stationary_last_x = artemis_object.pos.x
        drone_01_stationary_last_z = artemis_object.pos.z
        await delay_sim(seconds=1)
        jump khovan_drone_01_watch_stationary_hold
    drone_01_range_band_active = True
    dx = artemis_object.pos.x - drone_01_stationary_last_x
    dz = artemis_object.pos.z - drone_01_stationary_last_z
    movement_sq = dx * dx + dz * dz
    speed = 0
    artemis_engine_object = to_engine_object(artemis_id)
    if artemis_engine_object is not None:
        speed = abs(artemis_engine_object.cur_speed)
    drone_01_stationary_last_x = artemis_object.pos.x
    drone_01_stationary_last_z = artemis_object.pos.z
    if speed <= 1 and movement_sq <= 25:
        drone_01_stationary_hold_seconds = drone_01_stationary_hold_seconds + 1
    else:
        drone_01_stationary_hold_seconds = 0
    if drone_01_stationary_hold_seconds >= 15:
        drone_01_stationary_hold_active = True
        await task_schedule(khovan_drone_01_authorize_fire)
        ->END
    await delay_sim(seconds=1)
    jump khovan_drone_01_watch_stationary_hold

=== khovan_drone_01_authorize_fire ===
    if not drone_01_active or not drone_01_scan_complete or not drone_01_hail_complete or not drone_01_shield_frequency_relay_complete or not drone_01_weapons_lock_active or not drone_01_range_band_active or not drone_01_stationary_hold_active:
        drone_01_status = "fire_authorization_blocked_missing_gate"
        ->END
    drone_01_fire_authorized = True
    drone_01_status = "fire_authorized_weapons_disable_only"
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_fire_authorized", "objective_body": "Training Control authorizes fire. Weapons use manual targeting on Drone 01 Weapons array only; disable it in three confirmed hits, then cease fire.", "objective_step": "Drone 01 Weapons disable", "objective_breadcrumb": "[KHOVAN OBJECTIVE 019] Drone 01 fire authorized"})
    ->END

//damage/object if has_role(DAMAGE_TARGET_ID, "khovan_drone_01")
    manual_system = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM")
    if not drone_01_fire_authorized:
        drone_01_status = "unauthorized_damage_reset"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 RESET] unauthorized damage target_id={DAMAGE_TARGET_ID}")
        await task_schedule(khovan_drone_01_reset, {"reset_reason": "unauthorized_damage"})
        ->END
    if manual_system is None:
        drone_01_subsystem_hit_fallback_available = True
        drone_01_status = "subsystem_hit_fallback_available"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 DAMAGE] target_id={DAMAGE_TARGET_ID} manual_system=None")
        ->END
    drone_01_manual_system = manual_system.name
    set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM", None)
    if drone_01_manual_system != "WEAPONS":
        drone_01_status = "non_weapons_manual_subsystem_hit"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 DAMAGE] target_id={DAMAGE_TARGET_ID} manual_system={drone_01_manual_system}")
        ->END
    drone_01_weapons_hit_count = drone_01_weapons_hit_count + 1
    drone_01_status = "weapons_subsystem_hit_confirmed"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 HIT] count={drone_01_weapons_hit_count} target_id={DAMAGE_TARGET_ID}")
    if drone_01_weapons_hit_count >= 3:
        drone_01_weapons_disabled = True
        drone_01_status = "weapons_array_disabled_awaiting_ceasefire"
        drone_01_ceasefire_fallback_available = True
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_ceasefire", "objective_body": "Drone 01 Weapons array disabled. Captain call ceasefire; Comms confirm it with Training Control.", "objective_step": "Drone 01 ceasefire", "objective_breadcrumb": "[KHOVAN OBJECTIVE 020] Drone 01 Weapons disabled"})
    ->END

//damage/destroy if has_role(DESTROYED_ID, "khovan_drone_01")
    drone_01_active = False
    if drone_01_cleanup_in_progress:
        drone_01_destruction_source = "cleanup_or_reset"
        drone_01_cleanup_in_progress = False
        ->END
    if not drone_01_weapons_disabled:
        drone_01_destroyed_in_error = True
        drone_01_destruction_source = "premature_destroyed_reset"
        drone_01_status = "premature_destruction_reset"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 RESET] premature destruction target_id={DESTROYED_ID}")
        await task_schedule(khovan_drone_01_reset, {"reset_reason": "premature_destruction"})
        ->END
    drone_01_destruction_source = "destroyed_after_disable_unexpected"
    drone_01_status = "destroyed_after_disable_before_ceasefire"
    ->END

=== khovan_drone_01_confirm_ceasefire ===
    if not drone_01_weapons_disabled:
        drone_01_ceasefire_fallback_available = True
        ->END
    drone_01_ceasefire_confirmed = True
    drone_01_ceasefire_fallback_available = False
    drone_01_status = "controlled_disable_complete"
    if drone_01_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_01_navproxy_id)
        drone_01_navproxy_id = 0
    if drone_01_target_id != 0:
        drone_01_cleanup_in_progress = True
        sbs.delete_object(drone_01_target_id)
    drone_01_active = False
    drone_01_target_id = 0
    await task_schedule(khovan_drone_02_spawn)
    ->END

=== khovan_drone_02_spawn ===
    if shakedown_mode == "direct":
        ->END
    if tarsis_station_id == 0:
        drone_02_status = "blocked_missing_tarsis_training_beacon"
        ->END
    beacon = to_object(tarsis_station_id)
    if beacon is None:
        drone_02_status = "blocked_missing_tarsis_training_beacon_object"
        ->END
    drone_02_target = npc_spawn(beacon.pos.x + 10000, beacon.pos.y, beacon.pos.z, "Drone 02", "khovan_training, neutral, khovan_drone_02", "tsn_warpster", "behav_npcship")
    drone_02_target_id = to_id(drone_02_target)
    if drone_02_target_id == 0:
        drone_02_status = "spawn_failed"
        ->END
    drone_02_navproxy = sim.add_navproxy(drone_02_target_id, "Drone 02", "tsn_warpster", "#F93")
    drone_02_navproxy_id = to_id(drone_02_navproxy)
    drone_02_active = True
    drone_02_status = "spawned_training_safe_at_10km"
    drone_contact_sequence_status = "drone_02_active"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 02 SPAWN] target_id={drone_02_target_id} offset_m=10000")
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_02_live_fire", "objective_body": "Drone 02 live-fire target deployed at ten kilometres. Captain: engage and destroy the target. Coordinate as standard.", "objective_step": "Drone 02 destruction", "objective_breadcrumb": "[KHOVAN OBJECTIVE 021] Drone 02 deployed"})
    ->END

=== khovan_drone_02_cleanup ===
    if drone_02_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_02_navproxy_id)
        drone_02_navproxy_id = 0
    if drone_02_target_id != 0:
        drone_02_cleanup_in_progress = True
        sbs.delete_object(drone_02_target_id)
    drone_02_active = False
    drone_02_target_id = 0
    drone_02_status = "cleaned_up_not_a_completion"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 02 CLEANUP] cleanup requested")
    ->END

//damage/destroy if has_role(DESTROYED_ID, "khovan_drone_02")
    drone_02_active = False
    if drone_02_cleanup_in_progress:
        drone_02_destruction_source = "cleanup"
        drone_02_cleanup_in_progress = False
        ->END
    drone_02_destruction_source = "genuine_destruction"
    drone_02_destroyed = True
    drone_02_status = "destroyed_act2_ready"
    drone_contact_act2_ready = True
    drone_contact_act2_handoff_status = "ready_for_slice07_pivot"
    drone_contact_sequence_status = "act2_ready"
    if drone_02_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_02_navproxy_id)
        drone_02_navproxy_id = 0
    await task_schedule(khovan_drone_contact_fire_send_cultural_packet)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 02 DESTROY] target_id={DESTROYED_ID} act2_ready=True")
    ->END

=== khovan_drone_contact_fire_send_cultural_packet ===
    if drone_contact_cultural_packet_sent:
        ->END
    drone_contact_cultural_packet_sent = True
    await task_schedule(khovan_set_current_objective, {"objective_id": "act2_ready", "objective_body": "Training Control note for Comms: hostile contact handling is not only tone control. Different species, fleets, and political groups value different things. Cultural knowledge can help you diffuse a situation, pressure a contact, or detect a false identity. When a contact's claimed culture and actual conduct do not match, report it. Stand by for orders.", "objective_step": "Act II ready", "objective_breadcrumb": "[KHOVAN OBJECTIVE 022] cultural packet sent; Act II ready"})
    ->END

