# Operator decision 2026-08-16: one confirmed hit, reduced from three.
#
# The three-hit gate was written before the stock crit mechanic was read from
# source. legendarymissions/consoles/manual_weapons.mast:187 rolls
# random.randint(1,20) == 20 once per PRESS of a subsystem button, so three
# confirmed hits is ~60 button presses, and manual_weapons.mast:169-173 clears
# an armed critical whenever the player switches subsystem. One successful
# critical teaches the lesson the drill exists for; the other two taught
# patience with a d20.
#
# FINDING for the operator, not for the build side to close: design
# 10_mast_requirements.md section 8.5 gate 9 still reads "three confirmed
# hits". The doc is design authority and AGENTS.md section 2 forbids editing
# docs/01_design/ from implementation work - the operator authorized this
# runtime change and owns the matching doc edit.
shared drone_01_required_weapons_hits = 1
