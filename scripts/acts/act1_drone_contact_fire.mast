# Khovan Reach Slice 06 Drone contact/fire.
# Phase A spike remains GM-only evidence. Phase B production state is isolated below.

shared drone_contact_fire_initialized = False
shared drone_contact_sequence_status = "not_initialized"
shared drone_contact_detection_mode = "phase_a_spike_only_live_cosmos_proof_required"
shared drone_contact_last_step = "none"
shared drone_contact_source_decision = "Drone 01 proves Weapons subsystem disable; Drone 02 completes on destruction by user decision after source ambiguity review."
shared drone_contact_sequence_run_id = 0
shared drone_contact_production_available = False
shared drone_contact_profile_route = "not_started"
shared drone_contact_act2_ready = False
shared drone_contact_act2_handoff_status = "not_ready"
shared drone_contact_cultural_packet_sent = False

shared drone_01_active = False
shared drone_01_target_id = 0
shared drone_01_navproxy_id = 0
shared drone_01_spawn_offset_m = 15000
shared drone_01_spawn_count = 0
shared drone_01_reset_count = 0
shared drone_01_reset_reason = "none"
shared drone_01_status = "not_started"
shared drone_01_scan_complete = False
shared drone_01_hail_complete = False
shared drone_01_shield_frequency_relay_complete = False
shared drone_01_weapons_lock_active = False
shared drone_01_range_band_active = False
shared drone_01_stationary_hold_active = False
shared drone_01_stationary_hold_run_id = 0
shared drone_01_stationary_hold_seconds = 0
shared drone_01_stationary_last_x = 0
shared drone_01_stationary_last_z = 0
shared drone_01_fire_authorized = False
shared drone_01_manual_system = "none"
shared drone_01_weapons_hit_count = 0
shared drone_01_weapons_disabled = False
shared drone_01_ceasefire_confirmed = False
shared drone_01_destroyed_in_error = False
shared drone_01_cleanup_in_progress = False
shared drone_01_destruction_source = "not_observed"
shared drone_01_scan_fallback_available = False
shared drone_01_hail_fallback_available = False
shared drone_01_shield_relay_fallback_available = False
shared drone_01_weapons_lock_fallback_available = False
shared drone_01_range_fallback_available = False
shared drone_01_stationary_hold_fallback_available = False
shared drone_01_subsystem_hit_fallback_available = False
shared drone_01_ceasefire_fallback_available = False
shared drone_01_instruction_sent = False
shared drone_01_reset_message_sent = False

shared drone_02_active = False
shared drone_02_target_id = 0
shared drone_02_navproxy_id = 0
shared drone_02_status = "not_started"
shared drone_02_destroyed = False
shared drone_02_cleanup_in_progress = False
shared drone_02_destruction_source = "not_observed"
shared drone_02_instruction_sent = False

shared drone_target_spike_available = False
shared drone_target_spike_active = False
shared drone_target_spike_target_id = 0
shared drone_target_spike_navproxy_id = 0
shared drone_target_spike_spawn_count = 0
shared drone_target_spike_cleanup_count = 0
shared drone_target_spike_status = "not_started"
shared drone_target_spike_scan_observed = False
shared drone_target_spike_hail_observed = False
shared drone_target_spike_weapons_selected = False
shared drone_target_spike_damage_observed = False
shared drone_target_spike_manual_subsystem_hit_observed = False
shared drone_target_spike_manual_subsystem = "none"
shared drone_target_spike_manual_critical_hit_observed = False
shared drone_target_spike_weapons_damage_value = 0
shared drone_target_spike_engines_damage_value = 0
shared drone_target_spike_destroyed_observed = False
shared drone_target_spike_destruction_source = "not_observed"
shared drone_target_spike_cleanup_in_progress = False
shared drone_target_spike_stock_comms_menu_observation = "live_smoke_required"
shared drone_target_spike_training_safe_observation = "live_smoke_required"
shared drone_target_spike_result = "unproven"
shared drone_target_spike_blocker = "live_smoke_required"
