=== khovan_drone_01_spawn ===
    if shakedown_mode == "direct":
        drone_contact_sequence_status = "direct_scenario_drone_drills_bypassed"
        drone_contact_profile_route = "direct_bypass_no_failure_states"
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_drills_bypassed", "objective_body": "Captain has elected to skip the gunnery drills. Nothing is held against the crew for it. Stand by for orders.", "objective_step": "Act I drills bypassed", "objective_breadcrumb": "[KHOVAN ACT1 DRONE BYPASS] direct scenario"})
        ->END
    if drone_01_active:
        ->END
    if tarsis_station_id == 0:
        drone_01_status = "blocked_missing_tarsis_training_beacon"
        drone_01_range_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 BLOCKED] missing Tarsis Training Beacon id")
        ->END
    beacon = to_object(tarsis_station_id)
    if beacon is None:
        drone_01_status = "blocked_missing_tarsis_training_beacon_object"
        drone_01_range_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 BLOCKED] missing Tarsis Training Beacon object")
        ->END
    await task_schedule(khovan_drone_01_reset_flags)
    drone_01_spawn_count = drone_01_spawn_count + 1
    # Behavior key (2026-08-09): behav_npcship, matching the GM Spike Target.
    # The production drone keeps its Khovan-specific role only for drill-state
    # observation and cleanup; its hull, enemy-side roles, and behavior are otherwise
    # the same stock Kralien cruiser configuration as the Spike.
    #
    # The `kralien` role is what makes this contact an enemy side, and enemy side is
    # what makes the stock Science route match (legendarymissions/science_scans/
    # science.mast:144, side_are_enemies) and render the shield-frequency panel. Do
    # not swap it for `neutral` to stop the shooting - that trades away the scan the
    # whole drill is built on. `raider` is only a targeting tag used by autoplay
    # selection helpers, not an AI driver, so it is harmless here and left in place.
    #
    drone_01_target = npc_spawn(beacon.pos.x + drone_01_spawn_offset_m, beacon.pos.y, beacon.pos.z, "Drone 01", "kralien, raider, khovan_drone_01", "kralien_cruiser", "behav_npcship")
    drone_01_target_id = to_id(drone_01_target)
    if drone_01_target_id == 0:
        drone_01_status = "spawn_failed"
        drone_01_range_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 BLOCKED] npc_spawn returned id 0")
        ->END
    # Spike parity (2026-08-09): the GM Spike Target renders the engine's normal
    # Kralien Science return - including shield frequencies - because it is spawned
    # bare: no nav proxy, no extra_scan_source link, no forced Science/Comms
    # selection, no Khovan //science route. Drone 01 had all four and showed the
    # Khovan override text instead. Keep this spawn bare so both contacts behave
    # identically. The nav proxy is the least likely contributor and the most
    # visible loss - restore the two lines removed here only after live smoke
    # proves the stock scan return survives it.
    drone_01_active = True
    drone_01_status = "spawned_non_attacking_kralien_cruiser_at_training_beacon_offset"
    # GM/Comms confirmations are final fallbacks for every automatic production gate.
    drone_01_scan_fallback_available = True
    drone_01_hail_fallback_available = True
    drone_01_shield_relay_fallback_available = True
    drone_01_weapons_lock_fallback_available = True
    drone_01_range_fallback_available = True
    drone_01_stationary_hold_fallback_available = True
    drone_contact_sequence_status = "drone_01_active"
    drone_contact_last_step = "drone_01_spawn"
    await task_schedule(khovan_drone_01_mark_scan_known)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 SPAWN] target_id={drone_01_target_id} offset_m={drone_01_spawn_offset_m} spawn_count={drone_01_spawn_count}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_scan", "objective_body": "Drone away. Science, scan the contact. Wait for further instruction.", "objective_step": "Drone 01 scan and hail", "objective_breadcrumb": "[KHOVAN OBJECTIVE 017] Drone 01 deployed"})
    task_schedule(khovan_drone_01_deliver_deploy_prompt_after_delay, {"deploy_prompt_run_id": drone_contact_sequence_run_id})
    ->END

=== khovan_drone_01_test_authorize_fire ===
    # GM/test-mode only, added 2026-08-09 so the subsystem-damage mechanic can be
    # exercised without flying the full seven-gate chain on every iteration. This is
    # a diagnostic shortcut, NOT a fallback and NOT a gameplay path - it lives behind
    # the gamemaster + test_mode_enabled route and is deliberately absent from the
    # Tarsis player Comms menu. Do not treat a pass reached through this route as
    # evidence that the gate chain itself works; that still needs its own run.
    if not drone_01_active:
        ->END
    # Invalidate any running stationary-hold watcher first. It ticks once a second
    # and clears range_band_active/stationary_hold_active whenever Artemis is outside
    # the 1-2 km band, so without this bump it would race the flags set below and
    # khovan_drone_01_authorize_fire would find a gate already cleared and refuse.
    drone_01_stationary_hold_run_id = drone_01_stationary_hold_run_id + 1
    drone_01_scan_complete = True
    drone_01_hail_complete = True
    drone_01_shield_frequency_relay_complete = True
    drone_01_weapons_lock_active = True
    drone_01_range_band_active = True
    drone_01_stationary_hold_active = True
    drone_01_scan_fallback_available = False
    drone_01_hail_fallback_available = False
    drone_01_shield_relay_fallback_available = False
    drone_01_weapons_lock_fallback_available = False
    drone_01_range_fallback_available = False
    drone_01_stationary_hold_fallback_available = False
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 TEST AUTHORIZE] all gates forced by GM test route target_id={drone_01_target_id}")
    await task_schedule(khovan_drone_01_authorize_fire)
    comms_navigate("//comms/gamemaster/khovan_drone_contact_fire_spike")
    ->END

=== khovan_drone_01_mark_scan_known ===
    # Why this exists (2026-08-09, root cause read out of installed sbs_utils v1.3.0):
    # sbs_utils/procedural/comms.py set_buttons() gates the entire Khovan Comms route
    # behind the Science known state -
    #     unk = science_is_unknown(oo, so)
    #     if unk:
    #         ...send_comms_selection_info(origin_id, "", "white", "unknown")
    #         return          # returns BEFORE the button loop
    # and science.py science_is_unknown() is True while data_set["scan"] is None, "",
    # "no data", or "Default Scan". A freshly spawned NPC is exactly that, so Drone 01
    # rendered as "unknown" with no hail button - the live symptom reported 2026-08-09.
    #
    # This was previously masked: the removed <scan> block wrote scan text on panel
    # render, which made the drone known as a side effect. Tarsis and Kestrel get the
    # same effect on purpose via science_set_scan_data() at
    # act1_generator_tarsis_gate.mast:421-425.
    #
    # Neither sbs_utils helper is usable here. science_set_scan_data() ends with
    # target_blob.set("scan_type_list", scan_tabs, 0) where scan_tabs is "" for a plain
    # string, and science_update_scan_data() sets scan_type_list to "scan" whenever it
    # is currently unset. Either write collapses the stock tab strip - scan/status/
    # intel/bio plus the A-E frequency bars - which is the thing the previous two
    # commits recovered. An absent scan_type_list is what makes the engine render its
    # own full panel, so it must stay absent.
    #
    # So write only the scan key and leave scan_type_list alone. This is the same call
    # sbs_utils itself makes internally (science.py: so.data_set.set(tab, info, oo.side)).
    #
    # UNPROVEN in this repo: data_set.set() from MAST. Only data_set.get() is cookbook-
    # proven (section 8). If this call errors or the drone is still "unknown" on Comms,
    # do NOT reach for science_set_scan_data as a quick fix - it costs the frequency
    # panel. Use the Kestrel Comms "Khovan: Fallback Hail" route and raise an
    # API-uncertainty finding instead.
    if artemis_id == 0 or drone_01_target_id == 0:
        drone_01_hail_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 KNOWN] skipped, missing artemis or drone id")
        ->END
    artemis_object = to_object(artemis_id)
    drone_object = to_object(drone_01_target_id)
    if artemis_object is None or drone_object is None:
        drone_01_hail_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 KNOWN] skipped, missing artemis or drone object")
        ->END
    drone_object.data_set.set("scan", drone_01_known_scan_text, artemis_object.side)
    drone_01_known_marked = True
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 KNOWN] scan key seeded target_id={drone_01_target_id} side={artemis_object.side}")
    ->END

=== khovan_drone_01_deliver_deploy_prompt_after_delay ===
    default deploy_prompt_run_id = 0
    await delay_sim(seconds=10)
    if deploy_prompt_run_id != drone_contact_sequence_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 DEPLOY PROMPT] stale delayed prompt suppressed")
        ->END
    if not drone_01_active or drone_01_deploy_prompt_sent:
        ->END

    drone_01_deploy_prompt_sent = True
    await task_schedule(khovan_lifeform_send, {"send_lifeform_id": dillon_lifeform_id, "send_sender": "Commander Dillon", "send_title": "Instructor", "send_text": drone_01_deploy_prompt_text, "send_title_color": "cyan", "send_fallback_sender_id": kestrel_yards_id, "send_breadcrumb": "[KHOVAN ACT1 DRONE 01 DEPLOY PROMPT] guarded ten-second player message sent"})
    ->END

=== khovan_drone_01_reset ===
    default reset_reason = "unknown"
    if drone_01_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_01_navproxy_id)
        drone_01_navproxy_id = 0
    if drone_01_target_id != 0:
        drone_01_cleanup_in_progress = True
        sbs.delete_object(drone_01_target_id)
    drone_01_active = False
    drone_01_target_id = 0
    drone_01_reset_count = drone_01_reset_count + 1
    drone_01_reset_reason = reset_reason
    drone_01_spawn_offset_m = drone_01_spawn_offset_m + 5000
    drone_contact_sequence_run_id = drone_contact_sequence_run_id + 1
    if reset_reason == "unauthorized_damage":
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_reset", "objective_body": "Unauthorized fire. The drone has been pulled and reset farther out. Reacquire, re-establish your range, and wait for clearance before firing.", "objective_step": "Drone 01 reset", "objective_breadcrumb": "[KHOVAN ACT1 DRONE 01 RESET] unauthorized-hit reset message"})
    else:
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_reset", "objective_body": "Target destroyed. The drill was a controlled subsystem disable, not a kill. A fresh drone has been reset farther out; run it again.", "objective_step": "Drone 01 reset", "objective_breadcrumb": "[KHOVAN ACT1 DRONE 01 RESET] premature-destruction reset message"})
    task_schedule(khovan_drone_01_reset_respawn, {"reset_run_id": drone_contact_sequence_run_id})
    ->END

=== khovan_drone_01_reset_respawn ===
    default reset_run_id = drone_contact_sequence_run_id
    # delete_object() dispatches //damage/destroy asynchronously; yield so the
    # production destroy guard consumes cleanup_in_progress before reset flags clear it.
    await delay_sim(seconds=1)
    # Run-ID guard, cookbook section 5.1. The yield above is a window a story
    # jump can land in: the jump seeds bump drone_contact_sequence_run_id
    # (see khovan_act1_drone_contact_fire_init and
    # khovan_act1_drone_contact_fire_prepare_after_engineering), so a reset
    # scheduled before the jump must not spawn Drone 01 into the scene the
    # jump landed in. Incrementing the counter in the reset label is not by
    # itself a guard - nothing re-read it after the delay before this label
    # existed.
    if reset_run_id != drone_contact_sequence_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 RESET] stale respawn suppressed after story-jump seed")
        ->END
    # Precondition still true: a reset respawn is pointless once the drill has
    # handed off to Act II.
    if drone_contact_act2_ready:
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 RESET] respawn suppressed after Act II handoff")
        ->END
    # Not-already-done: something else may have deployed Drone 01 during the yield.
    if drone_01_active:
        script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 01 RESET] respawn suppressed drone already active")
        ->END
    await task_schedule(khovan_drone_01_spawn)
    ->END

# Deliberately NO //enable/science and NO //science route for khovan_drone_01.
#
# Root cause, read out of the installed sbs_utils v1.3.0 source (2026-08-09), not
# guessed - sbs_utils/procedural/science.py:
#
#   start_science_selected() collects every //enable/science label in the compiled
#   mission and runs them. If none of them pass, it calls t.end() and returns, and
#   sbs_utils never touches the Science panel - the engine's own scan renders, which
#   is the full Kralien readout with the A-E shield-frequency bars and the
#   scan/status/intel/bio tabs. That is exactly what the GM Spike Target shows.
#
#   If any //enable/science DOES pass, sbs_utils owns the panel and ScanPromise.
#   show_buttons() runs. Its first branch is decisive:
#       has_scan = sel_so.data_set.get("scan", origin_so.side)
#       if has_scan is None:        scan_tabs = "scan"
#       elif has_scan == "no data": scan_tabs = "scan"
#       else:                       ...build tabs from the //science buttons...
#   then unconditionally sel_so.data_set.set("scan_type_list", scan_tabs, 0).
#
# So while data_set["scan"] is None or the literal "no data" - which is what a
# freshly spawned NPC returns - the panel is hard-forced to a single "scan" tab.
# No custom buttons, no frequency bars. Live 2026-08-09 reproduced this precisely:
# Drone 01 showed one "scan" tab and "no data" while the Spike Target showed
# scan/status/intel/bio plus "weak C". The only way out of that branch is to put
# real text in data_set["scan"] (a <scan> block or science_set_scan_data), and both
# of those also overwrite scan_type_list - which is the frequency display we want.
#
# The trade is therefore either/or and cannot be split: a Khovan //science route on
# this contact OR the stock shield-frequency panel. The drill needs the frequencies,
# so the route goes. Science reads the weak frequency off the stock scan and passes
# it to Weapons verbally. A direct hail completes the scan-and-relay gates; the
# Kestrel Comms routes khovan_drone_01_fallback_scan and
# khovan_drone_01_fallback_shield_relay remain armed at spawn only as fallbacks.
#
# Do not re-add //enable/science for khovan_drone_01 to "restore the Science
# buttons" without re-reading the branch above; it silently costs the frequencies.

//enable/comms if has_roles(COMMS_SELECTED_ID, "khovan_drone_01")

//comms if has_roles(COMMS_SELECTED_ID, "khovan_drone_01")
    # Guarded like every other completion button in this file (fallback_scan,
    # fallback_weapons_lock, etc. all disappear once their gate is satisfied).
    # This one previously had no condition at all, so it stayed visible forever -
    # a re-click after hail completion silently re-ran the whole handler with no
    # visible change, which read to the crew as "the hail did not work."
    + "Hail Drone 01" khovan_drone_01_hail if not drone_01_hail_complete

=== khovan_drone_01_hail ===
    # Duplicate-suppress to match the menu guard above - belt and suspenders, since
    # a queued click can still land after the button should have vanished.
    if drone_01_hail_complete:
        ->END
    drone_01_scan_complete = True
    drone_01_hail_complete = True
    drone_01_shield_frequency_relay_complete = True
    drone_01_scan_fallback_available = False
    drone_01_hail_fallback_available = False
    drone_01_shield_relay_fallback_available = False
    drone_01_status = "comms_hail_scan_relay_complete"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 HAIL] target_id={COMMS_SELECTED_ID}")
    # Bare comms_receive() is the proven-live shape for a player-facing Comms reply in
    # this file - it is what khovan_drone_contact_fire_hail_spike_target uses, operator-
    # confirmed working. Do not wrap this one in comms_override; that wrapper is the
    # GM-only route workaround and is a separate, still-experimental case.
    comms_receive(drone_01_hail_response_text, title="Drone 01", title_color="green")
    # Dillon confirms the next step in the Comms channel, not just the blue
    # current-objective overlay - the overlay alone was hard to notice (reported
    # live), and the hail response above only confirms the hail itself, not what
    # comes after it.
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_weapons_lock_next_step_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 HAIL] guarded next-step confirmation sent"})
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_weapons_lock", "objective_body": "Weapons, lock beams on the drone. Helm, bring us between 1 and 2 km and hold us stationary for fifteen seconds.", "objective_step": "Drone 01 lock and range", "objective_breadcrumb": "[KHOVAN OBJECTIVE 018] hail scan relay complete"})
    # Re-check fire authorization here: Weapons/Helm can finish their lock,
    # range, and stationary-hold gates before Comms hails (stations run in
    # parallel). The stationary-hold watcher only calls
    # khovan_drone_01_authorize_fire once, when ITS gates complete - if hail
    # was the last gate outstanding at that moment, the watcher found the
    # block and exited, and nothing else ever re-checked. Without this call,
    # a crew that locked/held before hailing would sit at "fire blocked"
    # forever with no further signal after this hail confirmation.
    await task_schedule(khovan_drone_01_authorize_fire)
    ->END

=== khovan_drone_01_watch_stationary_hold ===
    default hold_run_id = drone_01_stationary_hold_run_id
    if hold_run_id != drone_01_stationary_hold_run_id or not drone_01_active:
        ->END
    if artemis_id == 0 or drone_01_target_id == 0:
        drone_01_range_fallback_available = True
        drone_01_stationary_hold_fallback_available = True
        drone_01_status = "fallback_missing_range_or_artemis_id"
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        drone_01_range_fallback_available = True
        drone_01_stationary_hold_fallback_available = True
        drone_01_status = "fallback_missing_artemis_object"
        ->END
    drone_range = sbs.distance_id(artemis_id, drone_01_target_id)
    if drone_range < 1000 or drone_range > 2000:
        drone_01_range_band_active = False
        drone_01_stationary_hold_active = False
        drone_01_stationary_hold_seconds = 0
        drone_01_stationary_last_x = artemis_object.pos.x
        drone_01_stationary_last_z = artemis_object.pos.z
        await delay_sim(seconds=1)
        jump khovan_drone_01_watch_stationary_hold
    drone_01_range_band_active = True
    dx = artemis_object.pos.x - drone_01_stationary_last_x
    dz = artemis_object.pos.z - drone_01_stationary_last_z
    movement_sq = dx * dx + dz * dz
    speed = 0
    artemis_engine_object = to_engine_object(artemis_id)
    if artemis_engine_object is not None:
        speed = abs(artemis_engine_object.cur_speed)
    drone_01_stationary_last_x = artemis_object.pos.x
    drone_01_stationary_last_z = artemis_object.pos.z
    if speed <= 1 and movement_sq <= 25:
        drone_01_stationary_hold_seconds = drone_01_stationary_hold_seconds + 1
    else:
        drone_01_stationary_hold_seconds = 0
    if drone_01_stationary_hold_seconds >= 15:
        drone_01_stationary_hold_active = True
        await task_schedule(khovan_drone_01_authorize_fire)
        ->END
    await delay_sim(seconds=1)
    jump khovan_drone_01_watch_stationary_hold

=== khovan_drone_01_authorize_fire ===
    # Duplicate-suppress: the automatic stationary-hold watcher and the Kestrel
    # Comms fallback can both reach this label with every gate satisfied (a race
    # is possible if the fallback lands the same tick the watcher completes), so
    # guard on the completion flag itself, not just the individual gates.
    if drone_01_fire_authorized:
        ->END
    if not drone_01_active or not drone_01_scan_complete or not drone_01_hail_complete or not drone_01_shield_frequency_relay_complete or not drone_01_weapons_lock_active or not drone_01_range_band_active or not drone_01_stationary_hold_active:
        drone_01_status = "fire_authorization_blocked_missing_gate"
        ->END
    drone_01_fire_authorized = True
    drone_01_status = "fire_authorized_weapons_disable_only"
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_fire_authorized_confirmed_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 FIRE AUTHORIZED] guarded confirmation sent"})
    # Technique coaching lands with the fire clearance, which is the moment the
    # crew is first told to go to manual targeting - explaining the critical-hit
    # roll after they have already burned twenty presses is too late to help.
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_weapons_crit_technique_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 FIRE AUTHORIZED] guarded manual-targeting technique note sent"})
    # Seed the subsystem-damage baseline and start the observer here rather than at
    # spawn: any damage before clearance triggers the unauthorized-fire reset, so
    # there is nothing to count until now, and a watcher running through a reset
    # would carry a stale baseline across the respawn.
    drone_01_weapons_damage_baseline = 0
    drone_object = to_object(drone_01_target_id)
    if drone_object is not None:
        seeded_weapons_damage = drone_object.data_set.get("system_damage", sbs.SHPSYS.WEAPONS)
        if seeded_weapons_damage is not None:
            drone_01_weapons_damage_baseline = seeded_weapons_damage
    drone_01_weapons_damage_run_id = drone_01_weapons_damage_run_id + 1
    drone_01_weapons_damage_observer_status = "watching_weapons_system_damage"
    task_schedule(khovan_drone_01_watch_weapons_subsystem_damage, {"damage_run_id": drone_01_weapons_damage_run_id})
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_fire_authorized", "objective_body": "You are cleared to fire. Weapons, go to manual targeting and take the drone's weapons array only. One confirmed critical hit will disable it. Then cease fire.", "objective_step": "Drone 01 Weapons disable", "objective_breadcrumb": "[KHOVAN OBJECTIVE 019] Drone 01 fire authorized"})
    ->END

//damage/object if has_role(DAMAGE_TARGET_ID, "khovan_drone_01")
    # DO NOT reintroduce a MANUAL_SYSTEM read or clear in this handler.
    #
    # It used to open with:
    #     manual_system = get_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM")
    #     ...
    #     set_inventory_value(DAMAGE_SOURCE_ID, "MANUAL_SYSTEM", None)
    # and counted a hit whenever that read came back WEAPONS.
    #
    # The stock console owns that inventory pair and races us for it. Its own
    # //damage/object route (legendarymissions/consoles/manual_weapons.mast:196-207,
    # matched on the "raider" role which Drone 01 carries) reads MANUAL_SYSTEM and
    # aborts on `->END if system is None` before applying any subsystem damage. So
    # whenever this handler won the race, it recorded a hit AND destroyed the
    # engine's ability to actually damage the subsystem - the operator's exact
    # 2026-08-16 report: "Hit 1 of 3 confirmed" in Comms with no damaged subsystem
    # on the drone.
    #
    # Hit counting now lives in khovan_drone_01_watch_weapons_subsystem_damage,
    # which polls the drone's real system_damage value. That is engine truth, it
    # cannot race the stock console, and it makes a counted hit provably a real
    # subsystem hit rather than a proxy signal.
    #
    # Drill survivability (2026-08-09). Design 10_mast_requirements.md section 8.5
    # gate 9 requires "Drone 01 Weapons array disabled in three confirmed hits", but
    # shipData.yaml gives kralien_cruiser "hullpoints": 2 (kralien_battleship 3,
    # kralien_dreadnought 4 - no Kralien warship hull reaches a safe margin). Manual
    # subsystem targeting also requires the target's shields to be down first, so by
    # the time subsystem hits can land at all the hull is the only thing left. Three
    # hits into a two-point hull is not survivable: the operator saw Drone 01
    # destroyed on the first hit. This is a design-vs-engine conflict, recorded as a
    # FINDING - the build side does not get to quietly reduce the three-hit gate.
    #
    # Build-side fix: hold the hull at zero accumulated hits for as long as the drill
    # is live, so the drone can absorb the three subsystem hits the gate asks for.
    # Shields are deliberately NOT restored - they have to stay down or manual
    # subsystem targeting cannot reach the Weapons array at all.
    #
    # Restoration stops the moment drone_01_weapons_disabled goes True, so the drone
    # is normally destructible again for the ceasefire/cleanup phase and Drone 02.
    #
    # "hull_hit_counter" is the key the stock DMX helper reads as hull damage
    # (data/missions/common/dmx.py:59, blob.get("hull_hit_counter", 0)); the paired
    # shield key "shield_val" is written the same way in
    # legendarymissions/collisions/collision.mast:54-56. set_data_set_value() itself
    # is cookbook-proven [LIVE] (section 9.1).
    #
    # UNPROVEN: that writing hull_hit_counter back to 0 actually prevents destruction.
    # It is read as a damage accumulator, not documented as writable. If Drone 01 is
    # still destroyed on an early hit, do NOT escalate by inventing more keys - the
    # proven fallback is to respawn on a tougher hull key and, failing that, run the
    # disable via the GM "Khovan: Fallback Weapons Hit" route. Raise an API-uncertainty
    # finding per cookbook section 12.
    if drone_01_active and not drone_01_weapons_disabled:
        set_data_set_value(DAMAGE_TARGET_ID, "hull_hit_counter", 0, 0)
        drone_01_hull_restore_count = drone_01_hull_restore_count + 1
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 HULL HOLD] restore_count={drone_01_hull_restore_count} target_id={DAMAGE_TARGET_ID}")
    if not drone_01_fire_authorized:
        # Duplicate-suppress the reset (bugfix 2026-08-09, from live trace). A single
        # beam volley delivers several //damage/object events - the trace shows three
        # inside 45 ms at 13:06:54 - and each one previously scheduled its own reset.
        # Every reset despawns Drone 01 and respawns it drone_01_spawn_offset_m + 5000
        # further out, so one volley moved the contact 15 km, not 5 km: offset_m went
        # 15000 -> 30000 -> 45000 across two volleys and the drone became unreachable.
        # It also read to the crew as a one-hit kill, since the ship simply vanished.
        #
        # await task_schedule() yields, so the reset label cannot be relied on to set
        # its own guard before the next damage event lands. The flag must be set
        # synchronously, here, before the schedule call. drone_01_reset_message_sent
        # already existed for exactly this purpose and was never wired up;
        # khovan_drone_01_reset_flags clears it on the respawn.
        if drone_01_reset_message_sent:
            ->END
        drone_01_reset_message_sent = True
        drone_01_status = "unauthorized_damage_reset"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 RESET] unauthorized damage target_id={DAMAGE_TARGET_ID}")
        await task_schedule(khovan_drone_01_reset, {"reset_reason": "unauthorized_damage"})
        ->END
    # Science cue on the first authorized hit. "First hit" here is the first beam
    # that lands after fire clearance, not the first subsystem critical - the
    # crew can watch shields deplete from the very first shot, and that readout is
    # what Weapons needs. Hard duplicate-suppressed: the 2026-08-16 trace logged
    # 186 damage events in a single drill, so an unguarded send here would bury
    # the Comms channel.
    if not drone_01_science_report_request_sent:
        drone_01_science_report_request_sent = True
        await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_science_report_request_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 DAMAGE] guarded Science report request sent"})
    ->END

=== khovan_drone_01_watch_weapons_subsystem_damage ===
    # Polls the drone's real WEAPONS system_damage and counts every increase as a
    # confirmed hit. Started by khovan_drone_01_authorize_fire.
    #
    # The read is the one already proven on an NPC target by the GM spike handler
    # above: data_set.get("system_damage", sbs.SHPSYS.WEAPONS), where the second
    # argument is an INDEX (sbs_utils/mock/sbs.py:570), and the index basis is
    # WEAPONS=0 / ENGINES=1 / SENSORS=2 / SHIELDS=3 per
    # sbs_utils/procedural/internal_damage.py:305-309. A key that has never been
    # written returns None, hence the None-guards.
    #
    # Run-ID guarded per AGENTS.md section 4: an Act II pivot or a drill reset
    # bumps drone_01_weapons_damage_run_id and this watcher retires itself.
    default damage_run_id = drone_01_weapons_damage_run_id
    if damage_run_id != drone_01_weapons_damage_run_id:
        ->END
    if not drone_01_active or drone_01_weapons_disabled or not drone_01_fire_authorized:
        ->END
    if drone_01_target_id == 0:
        drone_01_weapons_damage_observer_status = "fallback_missing_drone_id"
        drone_01_subsystem_hit_fallback_available = True
        ->END
    drone_object = to_object(drone_01_target_id)
    if drone_object is None:
        drone_01_weapons_damage_observer_status = "fallback_missing_drone_object"
        drone_01_subsystem_hit_fallback_available = True
        ->END

    current_weapons_damage = drone_object.data_set.get("system_damage", sbs.SHPSYS.WEAPONS)
    if current_weapons_damage is None:
        current_weapons_damage = 0
    if current_weapons_damage > drone_01_weapons_damage_baseline:
        drone_01_weapons_damage_baseline = current_weapons_damage
        drone_01_weapons_damage_observer_status = "weapons_subsystem_damage_increase_observed"
        # Diagnostic (2026-08-16): the operator observed Science reporting
        # "WEAP 100%" on a contact that had just taken two stock critical hits.
        # Stock writes system_damage = max(cur,1) * 1.35 per crit
        # (manual_weapons.mast:216-226), so the first crit lands 1.35. Log the
        # value against system_max_damage to settle whether Science is showing
        # a real-but-tiny fraction, or whether the engine's science panel does
        # not read this key at all. Read-only - do not "fix" the number here.
        weapons_max_damage = drone_object.data_set.get("system_max_damage", sbs.SHPSYS.WEAPONS)
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 SUBSYSTEM] weapons_damage={current_weapons_damage} weapons_max_damage={weapons_max_damage}")
        await task_schedule(khovan_drone_01_register_weapons_hit, {"hit_source": "automatic_weapons_system_damage_observer"})
        ->END

    await delay_sim(seconds=1)
    jump khovan_drone_01_watch_weapons_subsystem_damage

=== khovan_drone_01_register_weapons_hit ===
    # Single completion path for a confirmed Weapons-array hit, reached from the
    # automatic system_damage observer above and from the Kestrel Comms
    # "Fallback Weapons Hit" route below. Centralizing here guarantees both paths
    # count identically and both send the same Comms-channel acknowledgement -
    # the automatic path previously advanced silently with no Comms confirmation
    # at all, only the current-objective (blue text) update on the final hit.
    default hit_source = "automatic_weapons_system_damage_observer"
    drone_01_weapons_hit_count = drone_01_weapons_hit_count + 1
    drone_01_subsystem_hit_fallback_available = False
    drone_01_status = "weapons_subsystem_hit_confirmed"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 HIT] count={drone_01_weapons_hit_count} of {drone_01_required_weapons_hits} source={hit_source}")
    # Only worth a running tally when more than one hit is required. At the
    # current one-hit gate the disable confirmation below says everything.
    if drone_01_weapons_hit_count < drone_01_required_weapons_hits:
        await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": f"Artemis - Weapons: Hit {drone_01_weapons_hit_count} of {drone_01_required_weapons_hits} confirmed on Drone 01's weapons array.", "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 HIT] guarded confirmation sent"})
        # Re-arm the observer for the next hit. Only when more are needed - past
        # the gate the drone is destructible again and the watcher must stay down.
        drone_01_weapons_damage_run_id = drone_01_weapons_damage_run_id + 1
        task_schedule(khovan_drone_01_watch_weapons_subsystem_damage, {"damage_run_id": drone_01_weapons_damage_run_id})
    if drone_01_weapons_hit_count >= drone_01_required_weapons_hits:
        drone_01_weapons_disabled = True
        drone_01_status = "weapons_array_disabled_awaiting_ceasefire"
        drone_01_ceasefire_fallback_available = True
        await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_weapons_disabled_confirmed_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 DISABLED] guarded confirmation sent"})
        await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_ceasefire", "objective_body": "The drone's weapons array is down. Captain, call ceasefire; Comms, confirm it with Commander Dillon.", "objective_step": "Drone 01 ceasefire", "objective_breadcrumb": "[KHOVAN OBJECTIVE 020] Drone 01 Weapons disabled"})
    ->END

//damage/destroy if has_role(DESTROYED_ID, "khovan_drone_01")
    drone_01_active = False
    if drone_01_cleanup_in_progress:
        drone_01_destruction_source = "cleanup_or_reset"
        drone_01_cleanup_in_progress = False
        ->END
    if not drone_01_weapons_disabled:
        # Same duplicate-suppression as the damage handler above - a destroy can
        # arrive after a reset has already been scheduled by the damage that caused
        # it, and two resets means two respawns and a double distance penalty.
        if drone_01_reset_message_sent:
            ->END
        drone_01_reset_message_sent = True
        drone_01_destroyed_in_error = True
        drone_01_destruction_source = "premature_destroyed_reset"
        drone_01_status = "premature_destruction_reset"
        script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 RESET] premature destruction target_id={DESTROYED_ID}")
        await task_schedule(khovan_drone_01_reset, {"reset_reason": "premature_destruction"})
        ->END
    drone_01_destruction_source = "destroyed_after_disable_unexpected"
    drone_01_status = "destroyed_after_disable_before_ceasefire"
    ->END

=== khovan_drone_01_confirm_ceasefire ===
    if not drone_01_weapons_disabled:
        drone_01_ceasefire_fallback_available = True
        ->END
    drone_01_ceasefire_confirmed = True
    drone_01_ceasefire_fallback_available = False
    drone_01_status = "controlled_disable_complete"
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_ceasefire_confirmed_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 CEASEFIRE] guarded confirmation sent"})
    if drone_01_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_01_navproxy_id)
        drone_01_navproxy_id = 0
    if drone_01_target_id != 0:
        drone_01_cleanup_in_progress = True
        sbs.delete_object(drone_01_target_id)
    drone_01_active = False
    drone_01_target_id = 0
    await task_schedule(khovan_drone_02_spawn)
    ->END

=== khovan_drone_02_spawn ===
    if shakedown_mode == "direct":
        ->END
    if tarsis_station_id == 0:
        drone_02_status = "blocked_missing_tarsis_training_beacon"
        ->END
    beacon = to_object(tarsis_station_id)
    if beacon is None:
        drone_02_status = "blocked_missing_tarsis_training_beacon_object"
        ->END
    # Drone 02 is the free-fire half of the drill: design 10_mast_requirements.md 8.6
    # says "combat target = true", and completion is destruction. It was spawned as
    # "khovan_training, neutral" on a tsn_warpster hull - a NEUTRAL contact on a
    # friendly TSN hull, which is not a combat target. On a neutral side
    # side_are_enemies() is false, so it draws neither the stock enemy Science route
    # nor normal hostile Weapons handling, and asking a crew to destroy a friendly-
    # hulled neutral is the wrong lesson besides.
    #
    # Now a hostile Kralien cruiser with live NPC AI - the opposite of Drone 01 by
    # design. Drone 01 is the controlled subsystem-disable target and does not fight
    # back; Drone 02 is the one the crew engages at will. 8.6 also asks for "lethal
    # pressure = low / training-safe", so this stays a single cruiser at 10 km rather
    # than anything heavier; kralien_cruiser's 2 hull points are a feature here, since
    # destruction is the completion gate.
    drone_02_target = npc_spawn(beacon.pos.x + 10000, beacon.pos.y, beacon.pos.z, "Drone 02", "kralien, raider, khovan_drone_02", "kralien_cruiser", "behav_npcship")
    drone_02_target_id = to_id(drone_02_target)
    if drone_02_target_id == 0:
        drone_02_status = "spawn_failed"
        ->END
    drone_02_navproxy = sim.add_navproxy(drone_02_target_id, "Drone 02", "kralien_cruiser", "#F93")
    drone_02_navproxy_id = to_id(drone_02_navproxy)
    drone_02_active = True
    drone_02_status = "spawned_hostile_free_fire_target_at_10km"
    drone_contact_sequence_status = "drone_02_active"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 02 SPAWN] target_id={drone_02_target_id} offset_m=10000")
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_02_live_fire", "objective_body": "Live-fire target away at ten kilometres. Captain, engage and destroy it. All stations coordinate as standard.", "objective_step": "Drone 02 destruction", "objective_breadcrumb": "[KHOVAN OBJECTIVE 021] Drone 02 deployed"})
    ->END

=== khovan_drone_02_cleanup ===
    if drone_02_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_02_navproxy_id)
        drone_02_navproxy_id = 0
    if drone_02_target_id != 0:
        drone_02_cleanup_in_progress = True
        sbs.delete_object(drone_02_target_id)
    drone_02_active = False
    drone_02_target_id = 0
    drone_02_status = "cleaned_up_not_a_completion"
    script.write_khovan_startup_trace("[KHOVAN ACT1 DRONE 02 CLEANUP] cleanup requested")
    ->END

//damage/destroy if has_role(DESTROYED_ID, "khovan_drone_02")
    drone_02_active = False
    if drone_02_cleanup_in_progress:
        drone_02_destruction_source = "cleanup"
        drone_02_cleanup_in_progress = False
        ->END
    drone_02_destruction_source = "genuine_destruction"
    drone_02_destroyed = True
    drone_02_status = "destroyed_act2_ready"
    drone_contact_act2_ready = True
    drone_contact_act2_handoff_status = "ready_for_slice07_pivot"
    drone_contact_sequence_status = "act2_ready"
    if drone_02_navproxy_id != 0:
        sim.delete_navproxy_by_id(drone_02_navproxy_id)
        drone_02_navproxy_id = 0
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_02_destroyed_confirmed_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 02 DESTROY] guarded confirmation sent"})
    await task_schedule(khovan_drone_contact_fire_send_cultural_packet)
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 02 DESTROY] target_id={DESTROYED_ID} act2_ready=True")
    ->END

=== khovan_drone_contact_fire_send_cultural_packet ===
    if drone_contact_cultural_packet_sent:
        ->END
    drone_contact_cultural_packet_sent = True
    await task_schedule(khovan_set_current_objective, {"objective_id": "act2_ready", "objective_body": "Comms, one more thing before we hand you back. Handling a hostile contact is not just tone control. Different species, fleets, and political groups value different things. Cultural knowledge can help you diffuse a situation, pressure a contact, or detect a false identity. When a contact's claimed culture and actual conduct do not match, report it. Stand by for orders.", "objective_step": "Act II ready", "objective_breadcrumb": "[KHOVAN OBJECTIVE 022] cultural packet sent; Act II ready"})
    ->END

=== khovan_drone_01_fallback_scan ===
    drone_01_scan_complete = True
    drone_01_scan_fallback_available = False
    drone_01_status = "science_scan_confirmed"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 SCAN] confirmed via Kestrel Comms target_id={drone_01_target_id}")
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_scan_confirmed_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 SCAN] guarded confirmation sent"})
    await task_schedule(khovan_drone_01_authorize_fire)
    ->END

=== khovan_drone_01_fallback_hail ===
    # Kestrel-side confirmation for when Drone 01 itself is not selectable on Comms -
    # for example if khovan_drone_01_mark_scan_known failed and the contact is still
    # rendering as "unknown". Relays the drone's response rather than dropping it.
    drone_01_hail_complete = True
    drone_01_hail_fallback_available = False
    drone_01_status = "comms_hail_confirmed_via_kestrel"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 HAIL] confirmed via Kestrel Comms target_id={drone_01_target_id}")
    comms_receive(drone_01_hail_response_text, title="Drone 01", title_color="green")
    # This route previously stopped here: it never sent the next-step
    # confirmation or advanced the blue current-objective text, unlike the
    # direct khovan_drone_01_hail path above. A crew hailed via the Kestrel
    # fallback stayed on the "Drone away, Science scan the contact" objective
    # indefinitely even after Weapons/Helm finished their gates - matching
    # both fixes made to the direct hail handler.
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_weapons_lock_next_step_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 HAIL] guarded next-step confirmation sent via Kestrel"})
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_weapons_lock", "objective_body": "Weapons, lock beams on the drone. Helm, bring us between 1 and 2 km and hold us stationary for fifteen seconds.", "objective_step": "Drone 01 lock and range", "objective_breadcrumb": "[KHOVAN OBJECTIVE 018] hail confirmed via Kestrel"})
    await task_schedule(khovan_drone_01_authorize_fire)
    ->END

=== khovan_drone_01_fallback_shield_relay ===
    # Fallback route when direct Drone 01 hail is not usable. Science reads the weak
    # frequency off the stock scan panel and Comms confirms it here, so this also
    # satisfies the scan gate - the frequency cannot be read without scanning.
    drone_01_scan_complete = True
    drone_01_scan_fallback_available = False
    drone_01_shield_frequency_relay_complete = True
    drone_01_shield_relay_fallback_available = False
    drone_01_status = "shield_frequency_relay_complete"
    script.write_khovan_startup_trace(f"[KHOVAN ACT1 DRONE 01 SCAN RELAY] confirmed via Kestrel Comms target_id={drone_01_target_id}")
    await task_schedule(khovan_drone_contact_fire_send_message, {"drone_message_text": drone_01_shield_relay_confirmed_text, "drone_message_breadcrumb": "[KHOVAN ACT1 DRONE 01 SCAN RELAY] guarded confirmation sent"})
    await task_schedule(khovan_set_current_objective, {"objective_id": "drone_01_weapons_lock", "objective_body": "Weapons, lock beams on the drone. Helm, bring us between 1 and 2 km and hold us stationary for fifteen seconds.", "objective_step": "Drone 01 lock and range", "objective_breadcrumb": "[KHOVAN OBJECTIVE 018] shield relay complete"})
    await task_schedule(khovan_drone_01_authorize_fire)
    ->END

