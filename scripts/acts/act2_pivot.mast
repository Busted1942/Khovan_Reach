# Khovan Reach Slice 07A Act II pivot.
# Anderson orders, Act I -> Act II phase transition, distress-signal localization.
#
# Scope is the 07A packet only. Halcyon spawn/scan/hail, Engineering/DAMCON
# deployment, Hessler, the cascade, and any DAMCON timer are Phase B or later
# and are deliberately absent - see the packet's "Do not implement" list.

shared act2_pivot_initialized = False
shared act2_pivot_status = "not_initialized"
shared act2_last_progression_summary = "none"
shared act2_pivot_run_id = 0
shared act2_handoff_observer_ticks = 0
shared act2_handoff_fallback_available = False

shared anderson_orders_delivered = False
shared anderson_clip_1_stub_sent = False
shared anderson_orders_ack_status = "pending"
shared anderson_orders_prompt_run_id = 0

shared distress_signal_detected = False
shared distress_localized = False
shared distress_localization_status = "not_started"
shared distress_science_gate_status = "not_started"
shared distress_localization_fallback_available = False
shared distress_localization_source = "none"
shared distress_source_x = 0
shared distress_source_z = 0
shared distress_source_tarsis_range_m = 95000
shared distress_range_sq = 0
shared distress_detection_range_sq = 0
shared distress_detection_range_m = 30000
shared distress_sweep_run_id = 0
shared distress_sweep_observer_ticks = 0

shared dillon_clip_8_stub_sent = False

# Player-facing copy. Addressee convention, cookbook 6.2: the body opens with
# who is being addressed, one line per recipient, and never re-names its own
# sender because the message header already carries it.
shared anderson_orders_text = "Artemis - Captain: Admiral Anderson, Command Coordination. Long-range monitoring has picked up a fragmentary distress signal approximately ninety kilometres from Tarsis Station, bearing zero-nine-zero. It is on a TSN-compatible emergency band, but too degraded to identify or authenticate: either a civilian beacon or a TSN vessel in difficulty. No other asset is in range to answer it. Proceed to the reported area, locate the source, render aid as appropriate, and report your findings. The qualification framework remains in effect; this is a live operation now. Acknowledge these orders for the record."
shared dillon_clip_8_text = "Artemis - Captain: The framework still applies, but the consequences are real now. Direct your crew, report the deviation to Command, and keep the ship's cadence up. I will keep observing."
shared distress_transit_objective_text = "Artemis - Captain: Take Artemis toward the reported area approximately ninety kilometres from Tarsis Station, bearing zero-nine-zero. Direct Science to sweep as you close; the signal should resolve once you are inside sensor range."
shared distress_localization_prompt_text = "Artemis - Captain: Proceed toward bearing zero-nine-zero from Tarsis Station and direct Science to maintain a long-range sweep. Once Science locates the signal, investigate the contact and determine what assistance it requires."

# Comms route rides Tarsis. Play guide Scene 5 puts Artemis "returning from the
# training area, en route back toward Tarsis", so Tarsis is the station in
# contact during the pivot, and its route is the live-proven one in this repo
# (act1_generator_tarsis_gate.mast). Halcyon does not exist until Phase B, so a
# scan route on the distress source cannot be the Phase A path - the Acts II/III
# gate map rates that row against Halcyon, which Phase B spawns. This route only
# acknowledges Anderson and reports status; Science owns localization.
//comms if has_roles(COMMS_SELECTED_ID, "tarsis_station") and mission_phase == "act_2"
    act2_pivot_status = "act2_comms_options_rendered"
    script.write_khovan_startup_trace("[KHOVAN ACT2 COMMS OPTIONS] Act II options rendered")
    + "Acknowledge Anderson Orders" khovan_act2_acknowledge_orders if anderson_orders_delivered and anderson_orders_ack_status == "pending"
    + "Report Act II Status" khovan_act2_report_status

=== khovan_act2_initialize_pivot ===
    act2_pivot_initialized = True
    act2_pivot_status = "initialized_waiting_for_act1_completion"
    act2_last_progression_summary = "Act II pivot initialized; waiting on Act I completion."
    act2_pivot_run_id = act2_pivot_run_id + 1
    act2_handoff_observer_ticks = 0
    act2_handoff_fallback_available = False
    anderson_orders_delivered = False
    anderson_clip_1_stub_sent = False
    anderson_orders_ack_status = "pending"
    anderson_orders_prompt_run_id = anderson_orders_prompt_run_id + 1
    distress_signal_detected = False
    distress_localized = False
    distress_localization_status = "not_started"
    distress_science_gate_status = "not_started"
    distress_localization_fallback_available = False
    distress_localization_source = "none"
    dillon_clip_8_stub_sent = False
    script.write_khovan_startup_trace("[KHOVAN ACT2 001] Act II pivot state initialized")
    task_schedule(khovan_act2_watch_act1_handoff, {"handoff_run_id": act2_pivot_run_id})
    ->END

# Watch for the Act I handoff rather than having Act I call us.
#
# The 07A packet's "Do not implement" list forbids any change to Act I files
# beyond timer invalidation hooks, so the call cannot originate there. Slice 06
# already publishes drone_contact_act2_ready when Drone 02 is destroyed and when
# the Direct Scenario route bypasses the drills, which is a clean seam to poll.
#
# Bounded observer, cookbook 5.2, at a 5-second period. The ceiling is sized for
# the longest Act I fork - the Full Shakedown runs 45 minutes or so, and 900
# ticks is 75 minutes - so a crew taking their time is not cut off. If it does
# expire, JUMP-011 is the GM route into Act II, so the timeout degrades to a
# manual entry rather than a dead mission.
=== khovan_act2_watch_act1_handoff ===
    default handoff_run_id = 0
    if mission_phase == "act_2":
        ->END
    if handoff_run_id != act2_pivot_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT2 MSG ORDER] stale Act I handoff observer suppressed")
        ->END

    act2_handoff_observer_ticks = act2_handoff_observer_ticks + 1
    if drone_contact_act2_ready:
        act2_pivot_status = "act1_handoff_observed"
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 HANDOFF] Act I handoff observed at tick={act2_handoff_observer_ticks}")
        await task_schedule(khovan_act2_begin_pivot)
        ->END

    if act2_handoff_observer_ticks >= 900 and not act2_handoff_fallback_available:
        act2_handoff_fallback_available = True
        act2_pivot_status = "act1_handoff_observer_timed_out_use_jump_011"
        script.write_khovan_startup_trace("[KHOVAN ACT2 HANDOFF FALLBACK] observer ceiling reached; use JUMP-011 to enter Act II")
        ->END

    await delay_sim(seconds=5)
    jump khovan_act2_watch_act1_handoff
    ->END

# Entry point from Act I. Slice 06 sets drone_contact_act2_ready when Drone 02
# is destroyed, and the Direct Scenario route sets it on bypass. This label owns
# the phase transition; nothing else writes mission_phase = "act_2".
=== khovan_act2_begin_pivot ===
    if mission_phase == "act_2":
        script.write_khovan_startup_trace("[KHOVAN ACT2 MSG ORDER] duplicate suppressed Act II pivot")
        ->END
    if not drone_contact_act2_ready:
        act2_pivot_status = "blocked_act1_not_complete"
        script.write_khovan_startup_trace("[KHOVAN ACT2 BLOCKED] pivot blocked before Act I handoff")
        ->END

    # Invalidate every Act I delayed task before the phase changes. Cookbook 5.1:
    # a stale Kestrel advisory or Engineering observer firing mid-Act-II is the
    # documented hazard, and bumping the generation counters is what the guards
    # compare against.
    await task_schedule(khovan_act2_invalidate_act1_timers)

    mission_phase = "act_2"
    current_scene = 5
    current_beat = "scene_5_new_orders"
    act2_pivot_run_id = act2_pivot_run_id + 1
    act2_pivot_status = "act2_entered_awaiting_anderson_orders"
    act2_last_progression_summary = "Act II entered from Act I handoff; Anderson orders pending."
    script.write_khovan_startup_trace("[KHOVAN ACT2 002] mission_phase=act_2 current_scene=5")
    await task_schedule(khovan_scenario_control_panel_update_overview)
    await task_schedule(khovan_act2_deliver_anderson_orders)
    ->END

# Bumping every Act I run-ID counter is what makes a pending Act I task bail on
# resume. Each of these is compared by an existing guard in its own file; adding
# a new Act I timer means adding it here too.
=== khovan_act2_invalidate_act1_timers ===
    kestrel_generator_advisory_run_id = kestrel_generator_advisory_run_id + 1
    kestrel_homing_reserve_prompt_run_id = kestrel_homing_reserve_prompt_run_id + 1
    kestrel_stock_station_disable_run_id = kestrel_stock_station_disable_run_id + 1
    engineering_shakedown_undock_watch_run_id = engineering_shakedown_undock_watch_run_id + 1
    engineering_power_preset_run_id = engineering_power_preset_run_id + 1
    controlled_overload_prompt_run_id = controlled_overload_prompt_run_id + 1
    controlled_overload_repair_run_id = controlled_overload_repair_run_id + 1
    navigation_priority_run_id = navigation_priority_run_id + 1
    damcon_buff_run_id = damcon_buff_run_id + 1
    drone_contact_sequence_run_id = drone_contact_sequence_run_id + 1
    drone_01_stationary_hold_run_id = drone_01_stationary_hold_run_id + 1
    drone_01_weapons_damage_run_id = drone_01_weapons_damage_run_id + 1
    drone_02_weapons_damage_run_id = drone_02_weapons_damage_run_id + 1
    script.write_khovan_startup_trace("[KHOVAN ACT2 003] Act I delayed tasks invalidated by generation bump")
    ->END

=== khovan_act2_deliver_anderson_orders ===
    if anderson_clip_1_stub_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT2 MSG ORDER] duplicate suppressed Anderson Clip 1")
        ->END
    if mission_phase != "act_2":
        act2_pivot_status = "anderson_orders_blocked_before_act2"
        ->END

    anderson_clip_1_stub_sent = True
    anderson_orders_delivered = True
    anderson_orders_ack_status = "pending"
    act2_pivot_status = "anderson_orders_delivered_awaiting_ack"
    act2_last_progression_summary = "Anderson Clip 1 delivered; captain acknowledgment pending."
    last_checkpoint = "post_anderson_orders"
    script.write_khovan_startup_trace("[KHOVAN ACT2 004] Anderson Clip 1 text stand-in sent")
    script.write_khovan_startup_trace("[KHOVAN ACT2 SAVE] checkpoint post_anderson_orders recorded")
    # Anderson transmits from Command, off-map: no on-map object is a
    # fictionally correct sender for him, so the lifeform is the only clean
    # path and the station borrow is strictly a degraded fallback. Cookbook
    # 16.3.2.
    await task_schedule(khovan_lifeform_send, {"send_lifeform_id": anderson_lifeform_id, "send_sender": "Admiral Anderson", "send_title": "Command Coordination", "send_text": anderson_orders_text, "send_title_color": "yellow", "send_fallback_sender_id": tarsis_station_id, "send_breadcrumb": "[KHOVAN ACT2 004A] Anderson orders message sent"})
    await task_schedule(khovan_set_current_objective, {"objective_id": "act2_anderson_orders", "objective_body": "Artemis - Captain: Admiral Anderson's command channel is being relayed through Tarsis Station. Have Comms select Tarsis Station and acknowledge his orders for the record.", "objective_step": "Act II new orders", "objective_owner": "Artemis Captain", "objective_breadcrumb": "[KHOVAN OBJECTIVE 023] objective updated: Anderson orders"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

=== khovan_act2_acknowledge_orders ===
    if anderson_orders_ack_status == "acknowledged":
        script.write_khovan_startup_trace("[KHOVAN ACT2 MSG ORDER] duplicate suppressed orders acknowledgment")
        yield success
    if not anderson_orders_delivered:
        act2_pivot_status = "ack_blocked_before_orders"
        script.write_khovan_startup_trace("[KHOVAN ACT2 BLOCKED] acknowledgment before orders delivered")
        yield fail

    anderson_orders_ack_status = "acknowledged"
    current_beat = "scene_5_orders_acknowledged"
    act2_pivot_status = "orders_acknowledged_awaiting_distress_localization"
    act2_last_progression_summary = "Captain acknowledged Anderson orders; Dillon pivot note sent."
    script.write_khovan_startup_trace("[KHOVAN ACT2 005] Anderson orders acknowledged by Comms")
    comms_receive("Acknowledgment recorded and relayed to Command. Their bearing solution is approximate, so keep Artemis closing on zero-nine-zero. Once the source enters the ship's long-range sensor envelope, Science should resolve it. Captain, investigate the contact when Science reports the fix.", title="Tarsis Command Relay", title_color="green")
    await task_schedule(khovan_act2_deliver_dillon_pivot_note)
    await task_schedule(khovan_act2_open_distress_localization)
    yield success

=== khovan_act2_deliver_dillon_pivot_note ===
    if dillon_clip_8_stub_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT2 MSG ORDER] duplicate suppressed Dillon Clip 8")
        ->END
    dillon_clip_8_stub_sent = True
    script.write_khovan_startup_trace("[KHOVAN ACT2 006] Dillon Clip 8 text stand-in sent")
    await task_schedule(khovan_engineering_send_message, {"engineering_message_text": dillon_clip_8_text, "engineering_message_breadcrumb": "[KHOVAN ACT2 006A] Dillon pivot note sent"})
    ->END

# Scene 7. No contact object exists yet - Halcyon spawns in Phase B - so Science
# localizes the seeded signal coordinate through the automatic proximity sweep.
# The GM-supervised route is recovery only and is never exposed on player Comms.
=== khovan_act2_open_distress_localization ===
    if distress_signal_detected:
        ->END
    distress_signal_detected = True
    distress_localization_status = "closing_on_signal"
    distress_science_gate_status = "proximity_sweep_running"
    distress_localization_fallback_available = True
    current_scene = 6
    current_beat = "scene_6_long_range_transit"
    act2_pivot_status = "closing_on_distress_source"

    # Tarsis is the fixed navigation reference named in Anderson's orders. The
    # source sits exactly 95 km due east (+X / bearing 090) of the station, while
    # the player-facing estimate is deliberately rounded to approximately 90 km.
    if tarsis_station_id == 0:
        distress_science_gate_status = "fallback_missing_tarsis_id_at_seed"
        script.write_khovan_startup_trace("[KHOVAN ACT2 SWEEP] source not seeded: no Tarsis id; GM Science-report recovery is available")
        ->END
    tarsis_object = to_object(tarsis_station_id)
    if tarsis_object is None:
        distress_science_gate_status = "fallback_missing_tarsis_object_at_seed"
        script.write_khovan_startup_trace("[KHOVAN ACT2 SWEEP] source not seeded: no Tarsis object; GM Science-report recovery is available")
        ->END
    distress_source_x = tarsis_object.pos.x + distress_source_tarsis_range_m
    distress_source_z = tarsis_object.pos.z

    distress_sweep_run_id = distress_sweep_run_id + 1
    distress_sweep_observer_ticks = 0
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 007] distress source seeded at ({distress_source_x},{distress_source_z}); sweep running")
    task_schedule(khovan_act2_watch_distress_proximity, {"sweep_run_id": distress_sweep_run_id})
    await task_schedule(khovan_lifeform_send, {"send_lifeform_id": dillon_lifeform_id, "send_sender": "Commander Dillon", "send_title": "Instructor", "send_text": distress_localization_prompt_text, "send_title_color": "cyan", "send_fallback_sender_id": kestrel_yards_id, "send_breadcrumb": "[KHOVAN ACT2 007A] distress localization prompt sent"})
    await task_schedule(khovan_set_current_objective, {"objective_id": "act2_distress_transit", "objective_body": distress_transit_objective_text, "objective_step": "Act II transit to signal", "objective_owner": "Artemis Captain", "objective_breadcrumb": "[KHOVAN OBJECTIVE 024] objective updated: transit to distress source"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

# Proximity sweep. This is the beat the operator asked for: fly into the region
# and the sensors pick the signal up. Cookbook 5.2 bounded observer; the
# distance maths is the Vec3 pattern from LegendaryMissions
# (comms/enemy_surrender.mast:139 uses diff.length() the same way).
#
# No object exists for the source yet - Halcyon spawns in 07B - so this measures
# distance to a seeded coordinate rather than to a contact. That keeps Phase A
# free of a spawn it does not own while still giving Science a real gate.
=== khovan_act2_watch_distress_proximity ===
    default sweep_run_id = 0
    if distress_localized:
        ->END
    if sweep_run_id != distress_sweep_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT2 MSG ORDER] stale distress sweep suppressed")
        ->END
    if artemis_id == 0:
        distress_science_gate_status = "fallback_missing_artemis_id"
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        distress_science_gate_status = "fallback_missing_artemis_object"
        ->END

    distress_sweep_observer_ticks = distress_sweep_observer_ticks + 1
    sweep_dx = artemis_object.pos.x - distress_source_x
    sweep_dz = artemis_object.pos.z - distress_source_z
    # Squared comparison, no sqrt. math.* is not proven available in MAST here,
    # and the squared form needs no module at all - the same shape already live
    # in act1_drone_contact_fire.mast's stationary-hold observer (movement_sq).
    distress_range_sq = sweep_dx * sweep_dx + sweep_dz * sweep_dz
    distress_detection_range_sq = distress_detection_range_m * distress_detection_range_m
    if distress_range_sq <= distress_detection_range_sq:
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 SWEEP] signal resolved range_sq={distress_range_sq} threshold_sq={distress_detection_range_sq} tick={distress_sweep_observer_ticks}")
        await task_schedule(khovan_act2_complete_distress_localization, {"localization_source": "automatic_proximity_sweep"})
        ->END

    if distress_sweep_observer_ticks >= 600:
        distress_science_gate_status = "sweep_ceiling_reached_use_gm_science_report"
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 SWEEP FALLBACK] ceiling reached range_sq={distress_range_sq}; GM Science-report recovery available")
        ->END

    await delay_sim(seconds=3)
    jump khovan_act2_watch_distress_proximity
    ->END

=== khovan_act2_gm_confirm_science_localization ===
    if distress_localized:
        script.write_khovan_startup_trace("[KHOVAN ACT2 MSG ORDER] duplicate suppressed distress localization")
        yield success
    if not distress_signal_detected:
        act2_pivot_status = "localization_blocked_before_detection"
        script.write_khovan_startup_trace("[KHOVAN ACT2 BLOCKED] localization before signal detected")
        yield fail

    await task_schedule(khovan_act2_complete_distress_localization, {"localization_source": "gm_supervised_science_report"})
    yield success

# Single completion label so the automatic sweep and GM recovery record the
# same state and source without generating a localization Comms message.
=== khovan_act2_complete_distress_localization ===
    default localization_source = "unspecified"
    if distress_localized:
        ->END
    distress_localized = True
    distress_localization_source = localization_source
    distress_localization_status = "localized"
    distress_science_gate_status = "satisfied_by_science_report"
    current_beat = "scene_7_distress_localized"
    act2_pivot_status = "distress_localized_ready_for_phase_b"
    act2_last_progression_summary = "Distress source localized; Phase B owns Halcyon arrival."
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 008] distress source localized source={localization_source}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "act2_localized", "objective_body": "Artemis - Captain: Close on Halcyon. Have Science report, then order Comms to hail.", "objective_step": "Science report, then Captain orders hail", "objective_owner": "Artemis Captain", "objective_breadcrumb": "[KHOVAN OBJECTIVE 025] objective updated: Science verbal report precedes Comms hail"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

=== khovan_act2_report_status ===
    with comms_override(COMMS_ORIGIN_ID, COMMS_ORIGIN_ID, from_name="Khovan Act II"):
        comms_receive(f"phase={mission_phase} scene={current_scene} orders={anderson_orders_ack_status} detected={distress_signal_detected} localized={distress_localized} source={distress_localization_source}", title="Act II Status", title_color="cyan")
    script.write_khovan_startup_trace("[KHOVAN ACT2 STATUS] Act II status reported")
    yield success

# --- Story-jump seeds -------------------------------------------------------
# JUMP-011 delivers Anderson's orders and waits for the normal Tarsis
# acknowledgment. JUMP-012 lands with the source already localized. Both build
# on the same clean Act II reset so a later-state contact or stale timer cannot
# survive a backwards jump.

=== khovan_act2_story_jump_reset_act2_base ===
    await task_schedule(khovan_act1_story_jump_seed_act1_success_cleanup)
    await task_schedule(khovan_act2_invalidate_act1_timers)
    mission_phase = "act_2"
    current_scene = 5
    current_beat = "scene_5_new_orders"
    last_checkpoint = "pre_anderson_orders"
    act2_pivot_initialized = True
    act2_pivot_run_id = act2_pivot_run_id + 1
    anderson_orders_delivered = False
    anderson_clip_1_stub_sent = False
    anderson_orders_ack_status = "pending"
    anderson_orders_prompt_run_id = anderson_orders_prompt_run_id + 1
    dillon_clip_8_stub_sent = False
    distress_signal_detected = False
    distress_localized = False
    distress_localization_status = "not_started"
    distress_science_gate_status = "not_started"
    distress_localization_fallback_available = False
    distress_localization_source = "none"
    distress_source_x = 0
    distress_source_z = 0
    distress_sweep_run_id = distress_sweep_run_id + 1
    distress_sweep_observer_ticks = 0
    act2_pivot_status = "story_jump_reset_ready_for_anderson_orders"
    act2_last_progression_summary = "Act II reset; Anderson orders ready for delivery."
    await task_schedule(khovan_halcyon_reset_for_act2_jump)
    ->END

=== khovan_act2_story_jump_seed_anderson_orders ===
    await task_schedule(khovan_act2_story_jump_reset_act2_base)
    if act1_story_jump_cleanup_barrier_status != "settled":
        act2_pivot_status = "jump_011_blocked_act1_cleanup_not_settled"
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 011 BLOCKED] Act I cleanup did not settle")
        ->END
    if halcyon_cleanup_barrier_status != "settled":
        act2_pivot_status = "jump_011_blocked_cleanup_not_settled"
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 011 BLOCKED] Halcyon cleanup did not settle")
        ->END
    await task_schedule(khovan_act2_deliver_anderson_orders)
    script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 011] Anderson orders delivered; awaiting Tarsis acknowledgment")
    ->END

=== khovan_act2_story_jump_seed_distress_localized ===
    await task_schedule(khovan_act2_story_jump_reset_act2_base)
    if act1_story_jump_cleanup_barrier_status != "settled":
        act2_pivot_status = "jump_012_blocked_act1_cleanup_not_settled"
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 012 BLOCKED] Act I cleanup did not settle")
        ->END
    if halcyon_cleanup_barrier_status != "settled":
        act2_pivot_status = "jump_012_blocked_cleanup_not_settled"
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 012 BLOCKED] Halcyon cleanup did not settle")
        ->END
    anderson_orders_delivered = True
    anderson_clip_1_stub_sent = True
    anderson_orders_ack_status = "acknowledged"
    dillon_clip_8_stub_sent = True
    distress_signal_detected = True
    distress_localized = True
    distress_localization_status = "localized"
    distress_science_gate_status = "satisfied_by_science_report"
    distress_localization_fallback_available = True
    distress_localization_source = "story_jump_seed"
    current_scene = 7
    current_beat = "scene_7_distress_localized"
    last_checkpoint = "post_anderson_orders"
    act2_pivot_status = "seeded_distress_localized"
    act2_last_progression_summary = "Seeded to localized state; Phase B owns Halcyon arrival."
    script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 012] seeded distress-localized state")
    await task_schedule(khovan_halcyon_spawn)
    ->END
