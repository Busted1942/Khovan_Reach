=== khovan_halcyon_manifest_confirm ===
    script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON MANIFEST CLICK] transmit complement")
    if halcyon_manifest_confirmed:
        comms_navigate("//comms")
        yield success
    await task_schedule(khovan_halcyon_manifest_recount)
    if not halcyon_manifest_engineering_selected or halcyon_manifest_officer_count < 1 or halcyon_manifest_officer_count > 2:
        halcyon_manifest_status = "confirmation_blocked_requires_engineering_and_one_or_two_officers"
        halcyon_contact_fallback_available = True
        comms_navigate("//comms/khovan_halcyon_manifest")
        yield fail
    if halcyon_manifest_captain_selected and not halcyon_manifest_acting_command_designated:
        halcyon_manifest_status = "confirmation_blocked_captain_requires_acting_command"
        halcyon_contact_fallback_available = True
        comms_navigate("//comms/khovan_halcyon_manifest")
        yield fail

    halcyon_manifest_summary = "DAMCON Team Reyes (Reyes, Park, and Achebe); Engineering Officer"
    if halcyon_manifest_captain_selected:
        halcyon_manifest_summary = f"{halcyon_manifest_summary}; Captain; Artemis acting command: {halcyon_manifest_acting_command_role} Officer"
    if halcyon_manifest_science_selected:
        halcyon_manifest_summary = f"{halcyon_manifest_summary}; Science Officer"
    if halcyon_manifest_weapons_selected:
        halcyon_manifest_summary = f"{halcyon_manifest_summary}; Weapons Officer"
    if halcyon_manifest_helm_selected:
        halcyon_manifest_summary = f"{halcyon_manifest_summary}; Helm Officer"
    if halcyon_manifest_comms_selected:
        halcyon_manifest_summary = f"{halcyon_manifest_summary}; Comms Officer"
    halcyon_manifest_confirmed = True
    halcyon_manifest_status = "complement_transmitted"
    halcyon_deploy_acknowledgement_text = f"Artemis - Captain: Manifest received: {halcyon_manifest_summary}. We are standing by at Halcyon's transfer lock to receive the away team."
    if not halcyon_deploy_acknowledgement_sent:
        await task_schedule(khovan_lifeform_send, {"send_lifeform_id": hessler_lifeform_id, "send_sender": "Captain Aurel Hessler", "send_title": "Halcyon Drift", "send_text": halcyon_deploy_acknowledgement_text, "send_title_color": "green", "send_fallback_sender_id": halcyon_object_id, "send_breadcrumb": "[KHOVAN ACT2 HALCYON 005D] Hessler received complement and is standing by"})
        halcyon_deploy_acknowledgement_sent = True
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON MANIFEST] transmitted officers={halcyon_manifest_officer_count} complement={halcyon_manifest_summary}")
    await task_schedule(khovan_set_current_objective, {"objective_id": "halcyon_deploy_authorized", "objective_body": "Artemis - Captain: Halcyon has the away-team complement. Authorize the engineering deployment when ready.", "objective_step": "Captain authorizes declared complement", "objective_owner": "Artemis Captain", "objective_breadcrumb": "[KHOVAN OBJECTIVE 027A] objective updated: complement transmitted; awaiting authorization"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    comms_navigate("//comms")
    yield success

=== khovan_halcyon_manifest_revise ===
    if engineering_deployed:
        yield fail
    halcyon_manifest_confirmed = False
    halcyon_deploy_acknowledgement_sent = False
    halcyon_manifest_status = "revision_requested"
    await task_schedule(khovan_set_current_objective, {"objective_id": "halcyon_deploy", "objective_body": "Artemis - Captain: Order Comms to revise and retransmit the away-team complement.", "objective_step": "Comms revises away-team complement", "objective_owner": "Artemis Captain", "objective_breadcrumb": "[KHOVAN OBJECTIVE 027B] objective updated: complement revision"})
    comms_navigate("//comms/khovan_halcyon_manifest")
    yield success

=== khovan_halcyon_authorize_deployment ===
    if engineering_deployed:
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON] duplicate suppressed deployment authorization")
        yield success
    if not halcyon_hail_observed:
        halcyon_arrival_status = "deployment_blocked_before_hail"
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON BLOCKED] deployment authorized before hail")
        yield fail
    if not halcyon_manifest_confirmed:
        halcyon_arrival_status = "deployment_blocked_manifest_not_transmitted"
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON BLOCKED] deployment authorized before away-team complement")
        yield fail

    # API uncertainty:
    # Question: can a single DAMCON grid team be removed for an away mission
    # and later recreated without disturbing Artemis's other teams?
    # Sources checked: cookbook 9.4/12; installed internal_damage.py
    # grid_restore_damcons() and its own lethal-damage delete path.
    # Documented: DAMCON are named DC1..DC3 grid objects with role `damcons`;
    # sbs.delete_grid_object(host, id) plus Agent.destroyed() is the library's
    # deletion shape; grid_restore_damcons(host) recreates missing named teams.
    # Inferred: that direct shape remains safe when initiated from MAST Comms.
    # Risk/fallback: count before/after, expose status/fallback, and do not
    # advance the away mission unless exactly one team leaves the role index.
    await task_schedule(khovan_halcyon_deploy_damcon_team)
    if not damcon_deployed:
        halcyon_arrival_status = "deployment_blocked_damcon_transfer_failed"
        halcyon_contact_fallback_available = True
        await task_schedule(khovan_scenario_control_panel_update_overview)
        yield fail

    engineering_deployed = True
    engineering_deploy_status = "deployed_to_halcyon"
    # Slice 09 reads engineering_placement to choose the extended (30 min) or
    # compressed (15 min) DAMCON window. The exact strings are the packet's.
    engineering_placement = "aboard_halcyon"
    damcon_deployed = True
    damcon_deploy_status = "deployed_with_engineering"
    halcyon_arrival_status = "engineering_and_damcon_deployed"
    current_beat = "scene_8_engineering_deployed"
    script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON 006] Engineering and DAMCON deployed; placement=aboard_halcyon")
    halcyon_deployed_objective_owner = "Artemis Captain"
    halcyon_deployed_objective_text = f"Artemis - Captain: The declared away team ({halcyon_manifest_summary}) is aboard Halcyon Drift. Await their report and maintain command of Artemis."
    if halcyon_manifest_captain_selected:
        halcyon_deployed_objective_owner = "Artemis Acting Command"
        halcyon_deployed_objective_text = f"Artemis - Acting Command: Captain and the declared away team ({halcyon_manifest_summary}) are aboard Halcyon Drift. Hold command and maintain the bridge-to-away-team channel."
    await task_schedule(khovan_set_current_objective, {"objective_id": "halcyon_deployed", "objective_body": halcyon_deployed_objective_text, "objective_step": "Away team aboard", "objective_owner": halcyon_deployed_objective_owner, "objective_breadcrumb": "[KHOVAN OBJECTIVE 028] objective updated: declared away team aboard"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    yield success

=== khovan_halcyon_deploy_damcon_team ===
    if damcon_deployed:
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DAMCON] duplicate detachment suppressed")
        ->END
    halcyon_damcon_transfer_fallback_available = False
    if artemis_id == 0:
        damcon_deploy_status = "detach_blocked_no_artemis_id"
        halcyon_damcon_transfer_status = "blocked_no_artemis_id"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DAMCON BLOCKED] Artemis id is 0")
        ->END
    artemis_damcon_host = to_object(artemis_id)
    if artemis_damcon_host is None:
        damcon_deploy_status = "detach_blocked_missing_artemis_object"
        halcyon_damcon_transfer_status = "blocked_missing_artemis_object"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DAMCON BLOCKED] Artemis object missing")
        ->END

    halcyon_damcon_candidates = to_object_list(grid_objects(artemis_id) & role("damcons"))
    halcyon_damcon_count_before = len(halcyon_damcon_candidates)
    if halcyon_damcon_count_before == 0:
        damcon_deploy_status = "detach_blocked_no_team_available"
        halcyon_damcon_transfer_status = "blocked_no_team_available"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DAMCON BLOCKED] no DAMCON team available")
        ->END

    # Prefer DC3 so the same visible roster slot is used on every run. If DC3
    # is already absent, deploy the first remaining team rather than inventing
    # a name or assuming list ordering beyond the proven [0] access.
    halcyon_damcon_team_object = halcyon_damcon_candidates[0]
    for halcyon_damcon_candidate in halcyon_damcon_candidates:
        if halcyon_damcon_candidate.name == "DC3":
            halcyon_damcon_team_object = halcyon_damcon_candidate
    if halcyon_damcon_team_object is None:
        damcon_deploy_status = "detach_blocked_missing_team_object"
        halcyon_damcon_transfer_status = "blocked_missing_team_object"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DAMCON BLOCKED] selected team object missing")
        ->END

    halcyon_damcon_team_id = halcyon_damcon_team_object.id
    halcyon_damcon_team_name = halcyon_damcon_team_object.name
    halcyon_damcon_idle_marker_id = get_inventory_value(halcyon_damcon_team_id, "idle_marker", 0)
    if halcyon_damcon_idle_marker_id != 0:
        halcyon_damcon_idle_marker_object = to_object(halcyon_damcon_idle_marker_id)
        sbs.delete_grid_object(artemis_id, halcyon_damcon_idle_marker_id)
        if halcyon_damcon_idle_marker_object is not None:
            halcyon_damcon_idle_marker_object.destroyed()
    sbs.delete_grid_object(artemis_id, halcyon_damcon_team_id)
    halcyon_damcon_team_object.destroyed()

    halcyon_damcon_remaining = to_object_list(grid_objects(artemis_id) & role("damcons"))
    halcyon_damcon_count_after = len(halcyon_damcon_remaining)
    if halcyon_damcon_count_after != halcyon_damcon_count_before - 1:
        damcon_deploy_status = "detach_failed_count_not_reduced"
        halcyon_damcon_transfer_status = "failed_count_not_reduced"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON DAMCON FAILED] before={halcyon_damcon_count_before} after={halcyon_damcon_count_after} team={halcyon_damcon_team_name}")
        ->END

    damcon_deployed = True
    damcon_deploy_status = "deployed_with_engineering"
    halcyon_damcon_transfer_status = "team_removed_from_artemis"
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON DAMCON DEPLOY] before={halcyon_damcon_count_before} after={halcyon_damcon_count_after} team={halcyon_damcon_team_name} id={halcyon_damcon_team_id}")
    ->END

=== khovan_halcyon_restore_damcon_team ===
    if not damcon_deployed and halcyon_damcon_team_name == "none":
        ->END
    if artemis_id == 0:
        damcon_deploy_status = "restore_blocked_no_artemis_id"
        halcyon_damcon_transfer_status = "restore_blocked_no_artemis_id"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DAMCON RESTORE BLOCKED] Artemis id is 0")
        ->END
    artemis_damcon_restore_host = to_object(artemis_id)
    if artemis_damcon_restore_host is None:
        damcon_deploy_status = "restore_blocked_missing_artemis_object"
        halcyon_damcon_transfer_status = "restore_blocked_missing_artemis_object"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DAMCON RESTORE BLOCKED] Artemis object missing")
        ->END

    halcyon_damcon_before_restore = to_object_list(grid_objects(artemis_id) & role("damcons"))
    halcyon_damcon_count_before = len(halcyon_damcon_before_restore)
    grid_restore_damcons(artemis_id)
    halcyon_damcon_after_restore = to_object_list(grid_objects(artemis_id) & role("damcons"))
    halcyon_damcon_count_after = len(halcyon_damcon_after_restore)
    halcyon_damcon_restored_name_found = False
    for halcyon_damcon_restored_candidate in halcyon_damcon_after_restore:
        if halcyon_damcon_restored_candidate.name == halcyon_damcon_team_name:
            halcyon_damcon_restored_name_found = True
    if not halcyon_damcon_restored_name_found or halcyon_damcon_count_after != halcyon_damcon_count_before + 1:
        damcon_deploy_status = "restore_failed_count_or_name"
        halcyon_damcon_transfer_status = "restore_failed_count_or_name"
        halcyon_damcon_transfer_fallback_available = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON DAMCON RESTORE FAILED] before={halcyon_damcon_count_before} after={halcyon_damcon_count_after} expected={halcyon_damcon_team_name}")
        ->END

    damcon_deployed = False
    damcon_deploy_status = "aboard_artemis"
    halcyon_damcon_transfer_status = "team_restored_to_artemis"
    halcyon_damcon_transfer_fallback_available = False
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON DAMCON RESTORE] before={halcyon_damcon_count_before} after={halcyon_damcon_count_after} team={halcyon_damcon_team_name}")
    halcyon_damcon_team_id = 0
    halcyon_damcon_team_name = "none"
    halcyon_damcon_idle_marker_id = 0
    ->END

=== khovan_halcyon_recall_engineering ===
    if engineering_placement == "returned_to_artemis":
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON] duplicate suppressed engineering recall")
        yield success
    if not engineering_deployed:
        halcyon_arrival_status = "recall_blocked_before_deployment"
        yield fail

    await task_schedule(khovan_halcyon_restore_damcon_team)
    if damcon_deployed:
        halcyon_arrival_status = "recall_blocked_damcon_restore_failed"
        halcyon_contact_fallback_available = True
        await task_schedule(khovan_scenario_control_panel_update_overview)
        yield fail

    engineering_placement = "returned_to_artemis"
    engineering_deploy_status = "recalled_to_artemis"
    halcyon_arrival_status = "engineering_recalled"
    script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON 007] Engineering recalled; placement=returned_to_artemis")
    await task_schedule(khovan_scenario_control_panel_update_overview)
    yield success

=== khovan_halcyon_report_status ===
    halcyon_status_reply_text = halcyon_status_waiting_text
    if engineering_placement == "aboard_halcyon":
        halcyon_status_reply_text = halcyon_status_teams_aboard_text
        if halcyon_manifest_captain_selected:
            halcyon_status_reply_text = f"Artemis - Acting Command: Captain and the declared away team ({halcyon_manifest_summary}) are aboard Halcyon Drift. We will report when their assessment is complete."
    if engineering_placement == "returned_to_artemis":
        halcyon_status_reply_text = halcyon_status_teams_returned_text
    await task_schedule(khovan_lifeform_send, {"send_lifeform_id": hessler_lifeform_id, "send_sender": "Captain Aurel Hessler", "send_title": "Halcyon Drift", "send_text": halcyon_status_reply_text, "send_title_color": "green", "send_fallback_sender_id": halcyon_object_id, "send_breadcrumb": "[KHOVAN ACT2 HALCYON STATUS] Hessler status update sent"})
    yield success

# --- Story-jump seed --------------------------------------------------------

=== khovan_halcyon_relocate_artemis_for_jump_012 ===
    halcyon_jump_012_relocation_status = "relocation_started"
    if artemis_id == 0:
        halcyon_jump_012_relocation_status = "blocked_missing_artemis_id"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 012 RELOCATE BLOCKED] missing Artemis id")
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        halcyon_jump_012_relocation_status = "blocked_missing_artemis_object"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 012 RELOCATE BLOCKED] missing Artemis object")
        ->END
    if halcyon_object_id == 0:
        halcyon_jump_012_relocation_status = "blocked_missing_halcyon_id"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 012 RELOCATE BLOCKED] missing Halcyon id")
        ->END
    halcyon_jump_object = to_object(halcyon_object_id)
    if halcyon_jump_object is None:
        halcyon_jump_012_relocation_status = "blocked_missing_halcyon_object"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 012 RELOCATE BLOCKED] missing Halcyon object")
        ->END

    artemis_object.pos = Vec3(halcyon_jump_object.pos.x - halcyon_jump_012_approach_range_m, halcyon_jump_object.pos.y, halcyon_jump_object.pos.z)
    artemis_object.data_set.set("dock_base_id", 0, 0)
    artemis_object.data_set.set("dock_state", "undocked", 0)
    artemis_object.data_set.set("playerThrottle", 0, 0)
    halcyon_jump_012_actual_range_m = sbs.distance_id(artemis_id, halcyon_object_id)
    if halcyon_jump_012_actual_range_m < 4500 or halcyon_jump_012_actual_range_m > 5500:
        halcyon_jump_012_relocation_status = "blocked_approach_range_not_confirmed"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 JUMP 012 RELOCATE BLOCKED] range={halcyon_jump_012_actual_range_m}")
        ->END
    halcyon_jump_012_relocation_status = "relocated_to_halcyon_approach"
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 JUMP 012 RELOCATE] Artemis placed range={halcyon_jump_012_actual_range_m} from Halcyon id={halcyon_object_id}")
    ->END

=== khovan_halcyon_relocate_artemis_for_jump_013 ===
    halcyon_jump_013_relocation_status = "relocation_started"
    if artemis_id == 0:
        halcyon_jump_013_relocation_status = "blocked_missing_artemis_id"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 RELOCATE BLOCKED] missing Artemis id")
        ->END
    artemis_object = to_object(artemis_id)
    if artemis_object is None:
        halcyon_jump_013_relocation_status = "blocked_missing_artemis_object"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 RELOCATE BLOCKED] missing Artemis object")
        ->END
    if halcyon_object_id == 0:
        halcyon_jump_013_relocation_status = "blocked_missing_halcyon_id"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 RELOCATE BLOCKED] missing Halcyon id")
        ->END
    halcyon_jump_object = to_object(halcyon_object_id)
    if halcyon_jump_object is None:
        halcyon_jump_013_relocation_status = "blocked_missing_halcyon_object"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 RELOCATE BLOCKED] missing Halcyon object")
        ->END

    # The [LIVE] Kestrel yard-lock path uses this guarded direct Vec3 assignment.
    # Five kilometres leaves a safe approach gap while putting Halcyon well
    # inside the consoles' useful local range for the Scene 8 scan and hail.
    artemis_object.pos = Vec3(halcyon_jump_object.pos.x - halcyon_jump_013_approach_range_m, halcyon_jump_object.pos.y, halcyon_jump_object.pos.z)
    artemis_object.data_set.set("dock_base_id", 0, 0)
    artemis_object.data_set.set("dock_state", "undocked", 0)
    artemis_object.data_set.set("playerThrottle", 0, 0)
    halcyon_jump_013_actual_range_m = sbs.distance_id(artemis_id, halcyon_object_id)
    if halcyon_jump_013_actual_range_m < 4500 or halcyon_jump_013_actual_range_m > 5500:
        halcyon_jump_013_relocation_status = "blocked_approach_range_not_confirmed"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 JUMP 013 RELOCATE BLOCKED] range={halcyon_jump_013_actual_range_m}")
        ->END
    halcyon_jump_013_relocation_status = "relocated_to_halcyon_approach"
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 JUMP 013 RELOCATE] Artemis placed range={halcyon_jump_013_actual_range_m} from Halcyon id={halcyon_object_id}")
    ->END

=== khovan_act2_story_jump_seed_halcyon_arrival ===
    # Promote an already-valid JUMP-012 state in place. Re-running its full seed
    # here would send Artemis back through Tarsis and delete/recreate the live
    # Halcyon/Hessler pair. Besides being unnecessary, that consecutive 12 -> 13
    # cleanup path crashed live before its deletion barrier could report.
    if distress_localized and halcyon_spawned and halcyon_jump_012_relocation_status == "relocated_to_halcyon_approach":
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 PROMOTE] reusing valid JUMP-012 Halcyon contact without cleanup")
    else:
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 BUILD] no valid JUMP-012 state; seeding localized contact")
        await task_schedule(khovan_act2_story_jump_seed_distress_localized)
    if act1_story_jump_cleanup_barrier_status != "settled":
        halcyon_arrival_status = "jump_013_blocked_act1_cleanup_not_settled"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 BLOCKED] Act I cleanup did not settle")
        ->END
    if not halcyon_spawned:
        halcyon_arrival_status = "jump_013_blocked_halcyon_not_spawned"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013 BLOCKED] localized seed did not produce Halcyon")
        ->END
    await task_schedule(khovan_halcyon_relocate_artemis_for_jump_013)
    if halcyon_jump_013_relocation_status != "relocated_to_halcyon_approach":
        halcyon_arrival_status = "jump_013_blocked_artemis_not_at_halcyon"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 JUMP 013 BLOCKED] Artemis relocation failed status={halcyon_jump_013_relocation_status}")
        ->END
    current_scene = 8
    current_beat = "scene_8_halcyon_arrival"
    last_checkpoint = "post_halcyon_arrival"
    halcyon_arrival_status = "seeded_halcyon_arrival_contact_active"
    script.write_khovan_startup_trace("[KHOVAN ACT2 JUMP 013] seeded Halcyon arrival state with Artemis at five kilometre approach")
    ->END
