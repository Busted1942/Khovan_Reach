# Khovan Reach Slice 07B Halcyon Drift arrival.
# Spawn, Science scan, Comms hail, and Engineering/DAMCON deployment state.
#
# Scope is the arrival hail and deployment request. Hessler's later away-mission
# beats remain Slice 08, the cascade is Slice 08, the DAMCON timer is Slice 09,
# and Halcyon repair is Slice 13 - all deliberately absent.

shared halcyon_arrival_initialized = False
shared halcyon_arrival_run_id = 0
shared halcyon_arrival_observer_ticks = 0
shared halcyon_spawned = False
shared halcyon_object_id = 0
shared halcyon_navproxy_id = 0
shared halcyon_spawn_count = 0
shared halcyon_cleanup_count = 0
shared halcyon_cleanup_in_progress = False
shared halcyon_cleanup_barrier_status = "not_run"
shared halcyon_cleanup_wait_ticks = 0
shared halcyon_destruction_source = "not_observed"
shared halcyon_scan_observed = False
shared halcyon_hail_observed = False
shared halcyon_arrival_status = "not_initialized"
shared halcyon_contact_fallback_available = False

# Act II deployment tracking. NOT the Slice 05 damcon_rest_*/damcon_meal_* gates
# and NOT Slice 09's damcon_timer_* group - the packet flags this name space as
# a collision hazard. engineering_placement is named exactly as the packet
# specifies because Slice 09 reads it to choose extended vs compressed timer.
shared engineering_deployed = False
shared engineering_deploy_status = "aboard_artemis"
shared engineering_placement = "aboard_artemis"
shared damcon_deployed = False
shared damcon_deploy_status = "aboard_artemis"
shared halcyon_deploy_acknowledgement_sent = False
shared halcyon_manifest_confirmed = False
shared halcyon_manifest_officer_count = 0
shared halcyon_manifest_engineering_selected = False
shared halcyon_manifest_captain_selected = False
shared halcyon_manifest_science_selected = False
shared halcyon_manifest_weapons_selected = False
shared halcyon_manifest_helm_selected = False
shared halcyon_manifest_comms_selected = False
shared halcyon_manifest_status = "not_requested"
shared halcyon_manifest_summary = "not_declared"
shared halcyon_manifest_acting_command_designated = False
shared halcyon_manifest_acting_command_role = "none"
shared halcyon_damcon_team_id = 0
shared halcyon_damcon_team_name = "none"
shared halcyon_damcon_idle_marker_id = 0
shared halcyon_damcon_count_before = 0
shared halcyon_damcon_count_after = 0
shared halcyon_damcon_transfer_status = "not_attempted"
shared halcyon_damcon_transfer_fallback_available = False
shared halcyon_jump_012_approach_range_m = 5000
shared halcyon_jump_012_actual_range_m = 0
shared halcyon_jump_012_relocation_status = "not_attempted"
shared halcyon_jump_013_approach_range_m = 5000
shared halcyon_jump_013_relocation_status = "not_attempted"

shared halcyon_hail_response_text = "Artemis - Captain: Captain Aurel Hessler, Halcyon Drift. Our primary reactor is down, hull is open in two sections, and we are on emergency power. Seven aboard, three injured."
shared halcyon_known_scan_data = "Vesperan civilian cargo hauler. Distress beacon active."
shared halcyon_deploy_prompt_text = "Artemis - Captain: Before we open the transfer lock, transmit the complement of your away team. We require one DAMCON team and one or two officers, including a qualified engineer, to make the damaged sections safe."
shared dillon_away_manifest_protocol_text = "Artemis - Captain: Away-mission protocol requires Comms to assemble and transmit the manifest. Assign Engineering and, at your discretion, one additional officer. If you join the away team, designate the officer who will hold command of Artemis in your absence. DAMCON Team Reyes consists of Reyes, Park, and Achebe. It is the required damage-control element."
shared halcyon_deploy_acknowledgement_text = "Artemis - Captain: Manifest not yet received."
shared halcyon_status_waiting_text = "Artemis - Captain: Halcyon Drift is holding on emergency power. We still need your engineering and damage-control teams."
shared halcyon_status_teams_aboard_text = "Artemis - Captain: Your engineering and damage-control teams are aboard Halcyon Drift. We will report when they complete their assessment."
shared halcyon_status_teams_returned_text = "Artemis - Captain: Your teams have returned to Artemis. Halcyon Drift remains on emergency power."

# No custom //enable/science or //science route here. Cookbook 7.1 [LIVE]: a
# custom Science behavior replaces the stock panel and produces the one-tab
# `Scan` / `no data` failure visible in the operator screenshots. Science uses
# the stock display and reports verbally; the Captain then orders this hail.
# Cookbook 6.1 [LIVE]: target-selected Comms routes use matching companions.
//enable/comms if has_roles(COMMS_SELECTED_ID, "khovan_halcyon_drift")
    script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON] Halcyon selected on Comms")

//comms if has_roles(COMMS_SELECTED_ID, "khovan_halcyon_drift")
    halcyon_arrival_status = "comms_route_body_evaluated"
    script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON COMMS] custom route body evaluated")
    + "Hail Halcyon Drift" khovan_halcyon_hail if not halcyon_hail_observed
    + "Assemble Away-Team Complement" //comms/khovan_halcyon_manifest if halcyon_hail_observed and not halcyon_manifest_confirmed
    + "Revise Away-Team Complement" khovan_halcyon_manifest_revise if halcyon_manifest_confirmed and not engineering_deployed
    + "Authorize Engineering Deployment" khovan_halcyon_authorize_deployment if halcyon_manifest_confirmed and not engineering_deployed
    + "Recall Away Team to Artemis" khovan_halcyon_recall_engineering if engineering_deployed and engineering_placement == "aboard_halcyon"
    + "Request Status Update" khovan_halcyon_report_status

# Keep roster mutation off the target-selected root route. Cookbook 6.1 [LIVE]
# uses named submenus plus explicit comms_navigate() refreshes after actions.
# This prevents the engine from rebuilding a changing button list in place.
//comms/khovan_halcyon_manifest if has_roles(COMMS_SELECTED_ID, "khovan_halcyon_drift")
    + "Back to Halcyon Drift" //comms
    + "Select Engineering Officer (Required)" khovan_halcyon_manifest_add_engineering if not halcyon_manifest_confirmed and not halcyon_manifest_engineering_selected and halcyon_manifest_officer_count < 2
    + "Select Captain" khovan_halcyon_manifest_add_captain if not halcyon_manifest_confirmed and not halcyon_manifest_captain_selected and halcyon_manifest_officer_count < 2
    + "Select Science Officer" khovan_halcyon_manifest_add_science if not halcyon_manifest_confirmed and not halcyon_manifest_science_selected and halcyon_manifest_officer_count < 2
    + "Select Weapons Officer" khovan_halcyon_manifest_add_weapons if not halcyon_manifest_confirmed and not halcyon_manifest_weapons_selected and halcyon_manifest_officer_count < 2
    + "Select Helm Officer" khovan_halcyon_manifest_add_helm if not halcyon_manifest_confirmed and not halcyon_manifest_helm_selected and halcyon_manifest_officer_count < 2
    + "Select Comms Officer" khovan_halcyon_manifest_add_comms if not halcyon_manifest_confirmed and not halcyon_manifest_comms_selected and halcyon_manifest_officer_count < 2
    + "Remove Engineering Officer" khovan_halcyon_manifest_remove_engineering if not halcyon_manifest_confirmed and halcyon_manifest_engineering_selected
    + "Remove Captain" khovan_halcyon_manifest_remove_captain if not halcyon_manifest_confirmed and halcyon_manifest_captain_selected
    + "Remove Science Officer" khovan_halcyon_manifest_remove_science if not halcyon_manifest_confirmed and halcyon_manifest_science_selected
    + "Remove Weapons Officer" khovan_halcyon_manifest_remove_weapons if not halcyon_manifest_confirmed and halcyon_manifest_weapons_selected
    + "Remove Helm Officer" khovan_halcyon_manifest_remove_helm if not halcyon_manifest_confirmed and halcyon_manifest_helm_selected
    + "Remove Comms Officer" khovan_halcyon_manifest_remove_comms if not halcyon_manifest_confirmed and halcyon_manifest_comms_selected
    + "Designate Science Officer as Acting Command" khovan_halcyon_manifest_command_science if halcyon_manifest_captain_selected and not halcyon_manifest_confirmed and not halcyon_manifest_science_selected
    + "Designate Weapons Officer as Acting Command" khovan_halcyon_manifest_command_weapons if halcyon_manifest_captain_selected and not halcyon_manifest_confirmed and not halcyon_manifest_weapons_selected
    + "Designate Helm Officer as Acting Command" khovan_halcyon_manifest_command_helm if halcyon_manifest_captain_selected and not halcyon_manifest_confirmed and not halcyon_manifest_helm_selected
    + "Designate Comms Officer as Acting Command" khovan_halcyon_manifest_command_comms if halcyon_manifest_captain_selected and not halcyon_manifest_confirmed and not halcyon_manifest_comms_selected
    + "Clear Acting Command Designation" khovan_halcyon_manifest_command_clear if halcyon_manifest_captain_selected and not halcyon_manifest_confirmed and halcyon_manifest_acting_command_designated
    + "Transmit Away-Team Complement" khovan_halcyon_manifest_confirm if not halcyon_manifest_confirmed and halcyon_manifest_engineering_selected and halcyon_manifest_officer_count >= 1 and halcyon_manifest_officer_count <= 2 and (not halcyon_manifest_captain_selected or halcyon_manifest_acting_command_designated)

# Cleanup fires this same hook, so the flag is read and cleared HERE, never at
# the call site - scripts/lib/entity_cleanup_helpers.mast documents why.
//damage/destroy if has_role(DESTROYED_ID, "khovan_halcyon_drift")
    task_schedule(khovan_remove_hessler_lifeform)
    if halcyon_cleanup_in_progress:
        halcyon_destruction_source = "cleanup"
        halcyon_cleanup_in_progress = False
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON DESTROY] attributed to cleanup")
        ->END
    halcyon_destruction_source = "genuine_destruction"
    halcyon_spawned = False
    halcyon_arrival_status = "halcyon_destroyed_unexpectedly"
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON DESTROY] genuine destruction id={DESTROYED_ID}")
    ->END

=== khovan_act2_initialize_halcyon_arrival ===
    halcyon_arrival_initialized = True
    halcyon_arrival_status = "initialized_waiting_for_localization"
    halcyon_spawned = False
    halcyon_object_id = 0
    halcyon_navproxy_id = 0
    halcyon_cleanup_in_progress = False
    halcyon_cleanup_barrier_status = "not_run"
    halcyon_cleanup_wait_ticks = 0
    halcyon_destruction_source = "not_observed"
    halcyon_scan_observed = False
    halcyon_hail_observed = False
    halcyon_contact_fallback_available = False
    engineering_deployed = False
    engineering_deploy_status = "aboard_artemis"
    engineering_placement = "aboard_artemis"
    damcon_deployed = False
    damcon_deploy_status = "aboard_artemis"
    halcyon_deploy_acknowledgement_sent = False
    halcyon_manifest_confirmed = False
    halcyon_manifest_officer_count = 0
    halcyon_manifest_engineering_selected = False
    halcyon_manifest_captain_selected = False
    halcyon_manifest_science_selected = False
    halcyon_manifest_weapons_selected = False
    halcyon_manifest_helm_selected = False
    halcyon_manifest_comms_selected = False
    halcyon_manifest_status = "not_requested"
    halcyon_manifest_summary = "not_declared"
    halcyon_manifest_acting_command_designated = False
    halcyon_manifest_acting_command_role = "none"
    halcyon_damcon_team_id = 0
    halcyon_damcon_team_name = "none"
    halcyon_damcon_idle_marker_id = 0
    halcyon_damcon_count_before = 0
    halcyon_damcon_count_after = 0
    halcyon_damcon_transfer_status = "not_attempted"
    halcyon_damcon_transfer_fallback_available = False
    halcyon_jump_012_actual_range_m = 0
    halcyon_jump_012_relocation_status = "not_attempted"
    halcyon_jump_013_relocation_status = "not_attempted"
    script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON 001] Halcyon arrival state initialized")
    await task_schedule(khovan_halcyon_restart_arrival_observer)
    ->END

=== khovan_halcyon_restart_arrival_observer ===
    halcyon_arrival_run_id = halcyon_arrival_run_id + 1
    halcyon_arrival_observer_ticks = 0
    halcyon_arrival_status = "waiting_for_localization"
    task_schedule(khovan_halcyon_watch_distress_localization, {"arrival_run_id": halcyon_arrival_run_id})
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON AUTO] arrival observer armed run_id={halcyon_arrival_run_id}")
    ->END

# Backward Act II resets must remove a later Halcyon contact, reset its
# dependent state, and re-arm the automatic arrival observer. Cleanup's deferred
# destroy flag is deliberately not cleared here; the destroy hook owns it.
=== khovan_halcyon_reset_for_act2_jump ===
    await task_schedule(khovan_halcyon_restore_damcon_team)
    if damcon_deployed:
        halcyon_arrival_status = "act2_reset_blocked_damcon_restore_failed"
        halcyon_contact_fallback_available = True
        ->END
    await task_schedule(khovan_halcyon_cleanup_and_wait_for_respawn)
    if halcyon_cleanup_barrier_status != "settled":
        halcyon_arrival_status = "act2_reset_blocked_cleanup_not_settled"
        halcyon_contact_fallback_available = True
        ->END
    halcyon_scan_observed = False
    halcyon_hail_observed = False
    halcyon_contact_fallback_available = False
    engineering_deployed = False
    engineering_deploy_status = "aboard_artemis"
    engineering_placement = "aboard_artemis"
    damcon_deployed = False
    damcon_deploy_status = "aboard_artemis"
    halcyon_deploy_acknowledgement_sent = False
    halcyon_manifest_confirmed = False
    halcyon_manifest_officer_count = 0
    halcyon_manifest_engineering_selected = False
    halcyon_manifest_captain_selected = False
    halcyon_manifest_science_selected = False
    halcyon_manifest_weapons_selected = False
    halcyon_manifest_helm_selected = False
    halcyon_manifest_comms_selected = False
    halcyon_manifest_status = "not_requested"
    halcyon_manifest_summary = "not_declared"
    halcyon_manifest_acting_command_designated = False
    halcyon_manifest_acting_command_role = "none"
    halcyon_damcon_team_id = 0
    halcyon_damcon_team_name = "none"
    halcyon_damcon_idle_marker_id = 0
    halcyon_damcon_transfer_fallback_available = False
    halcyon_jump_012_actual_range_m = 0
    halcyon_jump_012_relocation_status = "not_attempted"
    halcyon_jump_013_relocation_status = "not_attempted"
    await task_schedule(khovan_halcyon_restart_arrival_observer)
    ->END

# Phase B owns the contact spawn. Observe the localization state published by
# the Act II pivot and spawn Halcyon automatically at that same fixed source.
# JUMP-013 remains the manual fallback if this bounded observer expires.
=== khovan_halcyon_watch_distress_localization ===
    default arrival_run_id = 0
    if halcyon_spawned:
        ->END
    if arrival_run_id != halcyon_arrival_run_id:
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON] stale arrival observer suppressed")
        ->END

    halcyon_arrival_observer_ticks = halcyon_arrival_observer_ticks + 1
    if distress_localized:
        halcyon_arrival_status = "localization_observed_spawning_contact"
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON AUTO] localization observed tick={halcyon_arrival_observer_ticks}; spawning contact")
        await task_schedule(khovan_halcyon_spawn)
        ->END

    if halcyon_arrival_observer_ticks >= 3000:
        halcyon_arrival_status = "arrival_observer_timed_out_use_jump_013"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON FALLBACK] arrival observer ceiling reached; use JUMP-013")
        ->END

    await delay_sim(seconds=3)
    jump khovan_halcyon_watch_distress_localization
    ->END

=== khovan_halcyon_spawn ===
    # Idempotent, cookbook 8.1. Two guards, because they catch different things:
    # the flag catches a second call in the same run, and the role query catches
    # a contact that survived a story-jump seed the flag did not know about.
    if halcyon_spawned:
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON] duplicate spawn suppressed by flag")
        ->END
    existing_halcyon = to_object_list(role("khovan_halcyon_drift"))
    if len(existing_halcyon) > 0:
        halcyon_object_id = existing_halcyon[0].id
        halcyon_spawned = True
        halcyon_arrival_status = "reused_existing_contact"
        await task_schedule(khovan_create_hessler_lifeform, {"hessler_host_id": halcyon_object_id})
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON] reused existing contact id={halcyon_object_id}")
        ->END
    if tarsis_station_id == 0:
        halcyon_arrival_status = "blocked_missing_tarsis_id"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON BLOCKED] missing Tarsis id")
        ->END
    tarsis_object = to_object(tarsis_station_id)
    if tarsis_object is None:
        halcyon_arrival_status = "blocked_missing_tarsis_object"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON BLOCKED] missing Tarsis object")
        ->END

    halcyon_spawn_count = halcyon_spawn_count + 1
    halcyon_object = npc_spawn(tarsis_object.pos.x + distress_source_tarsis_range_m, tarsis_object.pos.y, tarsis_object.pos.z, "Halcyon Drift", "vesperan, civilian, khovan_halcyon_drift", "tsn_warpster", "behav_npcship")
    halcyon_object_id = to_id(halcyon_object)
    if halcyon_object_id == 0:
        halcyon_arrival_status = "spawn_failed"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON BLOCKED] npc_spawn returned id 0")
        ->END

    halcyon_navproxy = sim.add_navproxy(halcyon_object_id, "Halcyon Drift", "tsn_warpster", "#FA5")
    halcyon_navproxy_id = to_id(halcyon_navproxy)
    halcyon_spawned = True
    halcyon_arrival_status = "halcyon_contact_active"
    current_scene = 8
    current_beat = "scene_8_halcyon_arrival"
    last_checkpoint = "post_halcyon_arrival"
    # GM/Comms confirmations back every automatic gate on this contact.
    halcyon_contact_fallback_available = True
    await task_schedule(khovan_create_hessler_lifeform, {"hessler_host_id": halcyon_object_id})
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON 002] Halcyon spawned id={halcyon_object_id} spawn_count={halcyon_spawn_count}")
    script.write_khovan_startup_trace("[KHOVAN ACT2 SAVE] checkpoint post_halcyon_arrival recorded")
    # Cookbook 7.4 preference 3: write only the side-specific scan key so SBS
    # Utils no longer classifies Halcyon as `unknown`, while leaving the stock
    # scan_type_list untouched. The Comms fallback flag remains armed for live
    # recovery because this direct write is compile-backed, not yet live-measured
    # on Halcyon.
    await task_schedule(khovan_set_current_objective, {"objective_id": "halcyon_arrival", "objective_body": "Artemis - Captain: Have Science report on Halcyon, then order Comms to hail.", "objective_step": "Science report, then Captain orders hail", "objective_owner": "Artemis Captain", "objective_breadcrumb": "[KHOVAN OBJECTIVE 026] objective updated: Science verbal report precedes Comms hail"})
    if artemis_id == 0:
        halcyon_arrival_status = "known_contact_seed_blocked_no_artemis"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON KNOWN BLOCKED] Artemis id is 0; use Comms/GM fallback")
        await task_schedule(khovan_scenario_control_panel_update_overview)
        ->END
    artemis_object = to_object(artemis_id)
    halcyon_known_object = to_object(halcyon_object_id)
    if artemis_object is not None and halcyon_known_object is not None:
        halcyon_known_object.data_set.set("scan", halcyon_known_scan_data, artemis_object.side)
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON KNOWN] stock Science scan key seeded; Comms hail available")
    else:
        halcyon_arrival_status = "known_contact_seed_blocked_missing_object"
        halcyon_contact_fallback_available = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON KNOWN SAFE] missing Artemis or Halcyon object; use Comms/GM fallback")
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END

=== khovan_halcyon_cleanup ===
    await task_schedule(khovan_remove_hessler_lifeform)
    if not halcyon_spawned and halcyon_object_id == 0:
        existing_halcyon_for_cleanup = to_object_list(role("khovan_halcyon_drift"))
        if len(existing_halcyon_for_cleanup) == 0:
            ->END
        halcyon_object_id = existing_halcyon_for_cleanup[0].id
        halcyon_spawned = True
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON CLEANUP] recovered untracked contact id={halcyon_object_id}")
    halcyon_cleanup_count = halcyon_cleanup_count + 1
    # Set before the delete; the destroy handler consumes it. Never cleared here.
    halcyon_cleanup_in_progress = True
    await task_schedule(khovan_entity_cleanup_despawn_contact, {"cleanup_object_id": halcyon_object_id, "cleanup_navproxy_id": halcyon_navproxy_id, "cleanup_owner": "halcyon_drift"})
    halcyon_object_id = 0
    halcyon_navproxy_id = 0
    halcyon_spawned = False
    halcyon_arrival_status = "halcyon_contact_removed"
    script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON 003] Halcyon cleanup cleanup_count={halcyon_cleanup_count}")
    ->END

# delete_object() and its destroy hook are deferred. A respawn must not query
# the role index until the doomed contact has actually left it, or it can
# re-adopt the old id and then lose that object moments later. This bounded
# barrier is the cookbook 5.2 [LIVE] observer shape; JUMP-013 remains the fallback.
=== khovan_halcyon_cleanup_and_wait_for_respawn ===
    halcyon_cleanup_barrier_status = "cleanup_requested"
    halcyon_cleanup_wait_ticks = 0
    await task_schedule(khovan_halcyon_cleanup)
    jump khovan_halcyon_wait_for_cleanup_settle
    ->END

=== khovan_halcyon_wait_for_cleanup_settle ===
    await delay_sim(seconds=1)
    halcyon_cleanup_wait_ticks = halcyon_cleanup_wait_ticks + 1
    remaining_halcyon = to_object_list(role("khovan_halcyon_drift"))
    remaining_hessler = to_object_list(role("khovan_hessler"))
    if len(remaining_halcyon) == 0 and len(remaining_hessler) == 0:
        # The hook normally consumes this flag. Clearing it here is only the
        # confirmed-deletion fallback for an engine build that omits the hook.
        halcyon_cleanup_in_progress = False
        halcyon_cleanup_barrier_status = "settled"
        hessler_lifeform_status = "removed"
        script.write_khovan_startup_trace(f"[KHOVAN ACT2 HALCYON CLEANUP] contact and Hessler deletion settled tick={halcyon_cleanup_wait_ticks}")
        ->END
    if halcyon_cleanup_wait_ticks >= 5:
        halcyon_cleanup_barrier_status = "timed_out_contact_or_hessler_still_indexed"
        halcyon_contact_fallback_available = True
        halcyon_arrival_status = "cleanup_barrier_timed_out_use_jump_013"
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON CLEANUP FALLBACK] contact or Hessler remained in role index; respawn blocked")
        ->END
    jump khovan_halcyon_wait_for_cleanup_settle
    ->END

=== khovan_halcyon_hail ===
    if halcyon_hail_observed:
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON] duplicate suppressed Halcyon hail")
        yield success
    # Cookbook 7.1: with the stock panel retained, Science reports verbally and
    # the Captain's hail order is the observable gate. Record that gate without
    # generating a second, Comms-style Science transmission.
    if not halcyon_scan_observed:
        halcyon_scan_observed = True
        script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON 004] Science verbal report confirmed by Captain's hail order")
    halcyon_hail_observed = True
    halcyon_arrival_status = "halcyon_hailed"
    script.write_khovan_startup_trace("[KHOVAN ACT2 HALCYON 005] Halcyon hail observed")
    # Both messages originate aboard Halcyon. Hessler speaks through his
    # Halcyon-hosted lifeform; if creation failed, cookbook 16.3.2 falls back to
    # borrowing Halcyon's ship object and preserves the route.
    await task_schedule(khovan_lifeform_send, {"send_lifeform_id": hessler_lifeform_id, "send_sender": "Captain Aurel Hessler", "send_title": "Halcyon Drift", "send_text": halcyon_hail_response_text, "send_title_color": "green", "send_fallback_sender_id": halcyon_object_id, "send_breadcrumb": "[KHOVAN ACT2 HALCYON 005A] Hessler hail response sent"})
    await task_schedule(khovan_lifeform_send, {"send_lifeform_id": hessler_lifeform_id, "send_sender": "Captain Aurel Hessler", "send_title": "Halcyon Drift", "send_text": halcyon_deploy_prompt_text, "send_title_color": "green", "send_fallback_sender_id": halcyon_object_id, "send_breadcrumb": "[KHOVAN ACT2 HALCYON 005B] Hessler deployment request sent"})
    # Dillon remains an observer: he supplies the training protocol to the
    # Captain, but neither chooses the roster nor directs a station.
    await task_schedule(khovan_lifeform_send, {"send_lifeform_id": dillon_lifeform_id, "send_sender": "Commander Dillon", "send_title": "Instructor", "send_text": dillon_away_manifest_protocol_text, "send_title_color": "cyan", "send_fallback_sender_id": kestrel_yards_id, "send_breadcrumb": "[KHOVAN ACT2 HALCYON 005C] Dillon stated away-team manifest protocol"})
    halcyon_manifest_status = "waiting_for_comms_selection"
    await task_schedule(khovan_set_current_objective, {"objective_id": "halcyon_deploy", "objective_body": "Artemis - Captain: Order Comms to select Engineering and up to one additional officer, then transmit the away-team complement. If you go, designate acting command first.", "objective_step": "Comms selects complement and any acting command", "objective_owner": "Artemis Captain", "objective_breadcrumb": "[KHOVAN OBJECTIVE 027] objective updated: Comms assembles away-team complement"})
    await task_schedule(khovan_scenario_control_panel_update_overview)
    yield success

=== khovan_halcyon_manifest_recount ===
    halcyon_manifest_officer_count = 0
    if halcyon_manifest_engineering_selected:
