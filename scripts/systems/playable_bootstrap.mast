# Slice 01B minimum playable bootstrap.
# LegendaryMissions owns sim_create, player spawning, assignment, and console selection.
# This helper only binds Khovan state to the reference-created Artemis.

=== khovan_reach_initialize_playable_bootstrap ===
    script.write_khovan_startup_trace("[KHOVAN BOOT 005] playable_bootstrap entered")
    artemis_player_ship_status = "checking_reference_player_ship"
    scene_1_runtime_presence = "player_ship_checking"
    player_console_select_status = "legendary_reference_lifecycle"

    script.write_khovan_startup_trace("[KHOVAN BOOT 006] before Artemis/player ship init or confirmation")
    script.write_khovan_startup_trace("[KHOVAN BOOT 006A] before reference player ship query")
    player_objects = sorted(to_object_list(role("__player__") & role("tsn")), key=lambda p: p.id)
    script.write_khovan_startup_trace("[KHOVAN BOOT 006B] after reference player ship query")
    artemis_object = None

    for player_ship in player_objects:
        if player_ship.name == "Artemis":
            artemis_object = player_ship

    if artemis_object is None and len(player_objects) > 0:
        artemis_object = player_objects[0]
        artemis_object.name = "Artemis"

    if artemis_object is None:
        shared artemis_id = 0
        artemis_player_ship_status = "missing_after_spawn_players"
        scene_1_runtime_presence = "dillon_stub_only_player_ship_missing"
        script.write_khovan_startup_trace("[KHOVAN BOOT 006C] no reference player ship found")
        log("Slice 01B playable bootstrap could not find a TSN player ship after spawn_players.")
        ->END

    shared artemis_id = artemis_object.id
    script.write_khovan_startup_trace("[KHOVAN BOOT 006C] before Khovan ship binding")
    artemis_object.name = "Artemis"
    artemis_object.update_comms_id()
    script.write_khovan_startup_trace("[KHOVAN BOOT 006D] after Khovan ship binding")

    artemis_player_ship_status = "initialized"
    scene_1_runtime_presence = "artemis_player_ship_and_dillon_stub"
    script.write_khovan_startup_trace("[KHOVAN BOOT 007] after Artemis/player ship init or confirmation")
    log(f"Slice 01B playable bootstrap bound Artemis player ship id {artemis_id} after spawn_players.")
    ->END
