# Slice 01 audio wrapper stub. Real playback API needs Cosmos smoke validation.

shared dillon_clip_1_stub_text = "Captain. Crew of Artemis. This is a qualification cruise. Standard pattern: depart Kestrel, dock and resupply at Tarsis, conduct the selected shakedown profile, then return for debrief. I'll be observing. Run the cruise. Do your jobs. Captain, the ship is yours."
shared dillon_clip_1_stub_sent = False

=== khovan_reach_send_safe_startup_message ===
    default startup_sender = "Khovan Reach"
    default startup_text = ""
    default startup_color = "#446"
    default startup_breadcrumb = ""
    sbs.send_story_dialog(0, startup_sender, startup_text, "", startup_color)
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG SAFE] startup message sent via safe visible fallback")
    script.write_khovan_startup_trace("[KHOVAN ACT1 MSG SAFE] comms_receive skipped: no valid sender/context")
    if startup_breadcrumb != "":
        script.write_khovan_startup_trace(startup_breadcrumb)
    ->END

=== khovan_reach_stub_dillon_clip_1 ===
    if dillon_clip_1_stub_sent:
        script.write_khovan_startup_trace("[KHOVAN ACT1 MSG ORDER] duplicate suppressed Dillon Clip 1 stub")
        ->END

    dillon_clip_1_stub_sent = True
    dillon_clip_1_status = "stubbed"
    dillon_clip_1_stub_text = "Captain. Crew of Artemis. This is a qualification cruise. Standard pattern: depart Kestrel, dock and resupply at Tarsis, conduct the selected shakedown profile, then return for debrief. I'll be observing. Run the cruise. Do your jobs. Captain, the ship is yours."
    await task_schedule(khovan_reach_send_safe_startup_message, {"startup_sender": "Dillon / Training Control", "startup_text": dillon_clip_1_stub_text, "startup_color": "#446", "startup_breadcrumb": "[KHOVAN ACT1 MSG DILLON 001] Dillon opening briefing sent"})
    script.write_khovan_startup_trace("[KHOVAN BOOT 008] Dillon Clip 1 stub/queue reached")
    log("Dillon Clip 1 is stubbed for Slice 01; real audio playback API not verified locally.")
    ->END
