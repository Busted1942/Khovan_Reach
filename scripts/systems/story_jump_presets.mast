# Khovan Reach GM-only story jump presets.
# Active presets seed accepted Slice 04/Slice 05 runtime states; future story beats stay out of this menu.
# jump_id values align with the JUMP-nnn canonical names in docs/01_design/40_admin_testing_plan.md
# section 6.1/6.3 where a clean match exists. See "Engineering Shakedown Complete" below for the one
# preset that does not yet have a canonical JUMP-nnn match (docs/04_implementation_setup/branch_ledger.md
# and tests/ADMIN_JUMP_VERIFICATION.md carry the finding).

shared story_jump_registry_initialized = False
shared story_jump_registry_ids = "mission_start_generator_governor|tarsis_resupply_complete|engineering_shakedown_complete|anderson_orders|distress_localized"
shared story_jump_preset_count = 3
shared story_jump_metadata_required_fields = "jump_id|display_name|target_scene|mode_access|mission_phase|required_prior_flags|seeded_state_summary|entities|timers|clips|gm_display|expected_next_event|validation_checks|recovery_notes|skipped_observations"
shared story_jump_last_id = "none"
shared story_jump_last_display_name = "none"
shared story_jump_last_target_scene = 0
shared story_jump_last_validation_result = "not_run"
shared story_jump_last_summary = "No story jump has been executed."
shared story_jump_generation_id = 0
shared story_jump_mode_access = "test_mode_only"
shared story_jump_expected_next_event = "none"
shared story_jump_framework_warning = "none"
shared story_jump_skipped_observations = "none"
shared story_jump_required_prior_flags = "none"
shared story_jump_seeded_state_summary = "none"
shared story_jump_entities = "none"
shared story_jump_timers = "none"
shared story_jump_clips = "none"
shared story_jump_gm_display = "none"
shared story_jump_validation_checks = "none"
shared story_jump_recovery_notes = "none"

shared story_jump_preset_mission_start_generator_governor_metadata = "jump_id=mission_start_generator_governor; jump_number=JUMP-001; display_name=Mission Start; target_scene=1; mode_access=test_mode; mission_phase=act_1; required_prior_flags=none; seeded_state_summary=Slice 04 source-authorized mission start reset; entities=reuse Artemis, Kestrel Yards, and Tarsis Station without proof stations; timers=stale Kestrel advisory timer invalidated; clips=Dillon Clip 1 stub may replay; gm_display=Mission Start preset ready; expected_next_event=Comms requests Kestrel departure clearance; validation_checks=mission_phase,current_scene,current_beat,last_checkpoint,zero_energy,zero_ordnance; recovery_notes=use for fresh start validation; skipped_observations=none"
shared story_jump_preset_tarsis_resupply_complete_metadata = "jump_id=tarsis_resupply_complete; jump_number=JUMP-004; display_name=Post-Tarsis / Engineering Ready; target_scene=2; mode_access=test_mode; mission_phase=act_1; required_prior_flags=none; seeded_state_summary=Slice 04 post-resupply governor-cleared state; entities=reuse Artemis, Kestrel Yards, and Tarsis Station without proof stations; timers=stale Kestrel advisory timer invalidated; clips=none; gm_display=Post-Tarsis handoff preset ready; expected_next_event=Resupply complete; Dillon begins the Engineering shakedown; validation_checks=mission_phase,current_scene,current_beat,last_checkpoint,full_energy,full_armament; recovery_notes=use to test the Slice 05 entry point after Slice 04 handoff; skipped_observations=manual jump skips live proof of Kestrel/Tarsis Comms sequence and mechanical docking"
shared story_jump_preset_engineering_shakedown_complete_metadata = "jump_id=engineering_shakedown_complete; jump_number=none_not_yet_specified_see_admin_plan_JUMP-008_mismatch; display_name=Engineering Shakedown Complete; target_scene=2; mode_access=test_mode; mission_phase=act_1; required_prior_flags=none; seeded_state_summary=Slice 05 engineering shakedown complete state after Tarsis resupply; entities=reuse Artemis, Kestrel Yards, and Tarsis Station without proof stations; timers=stale Kestrel advisory and Slice 05 observer fallbacks invalidated; clips=none; gm_display=Engineering shakedown complete preset ready; expected_next_event=Slice 06 target spike ready; validation_checks=mission_phase,current_scene,current_beat,last_checkpoint,full_energy,full_armament,engineering_shakedown_complete; recovery_notes=use to test content immediately after Slice 05; skipped_observations=manual jump skips live proof of engineering shakedown gates, DAMCON positioning, overload damage, repair, and nav preset. NOTE: admin_testing_plan.md JUMP-008 is defined as engineering_shakedown_START (engineering_shakedown_complete=false), which is the OPPOSITE of what this preset seeds. This preset has no canonical JUMP-nnn match; it sits between JUMP-008 and JUMP-009 in the spec's sequence. Needs an operator decision: add a new JUMP number to the spec, or accept this preset stays unnumbered."

//comms/gamemaster/khovan_story_jump_presets if has_roles(COMMS_ORIGIN_ID, "gamemaster") and test_mode_enabled
    + "Back" //comms/gamemaster/khovan_scenario_control_panel
    + "JUMP-001 Mission Start" khovan_story_jump_preset_mission_start_generator_governor
    + "JUMP-004 Tarsis Resupply Complete" khovan_story_jump_preset_tarsis_resupply_complete
    + "Engineering Shakedown Complete (no JUMP-nnn match)" khovan_story_jump_preset_engineering_shakedown_complete
    + "JUMP-011 Anderson Orders" khovan_story_jump_preset_anderson_orders
    + "JUMP-012 Distress Localized" khovan_story_jump_preset_distress_localized

=== khovan_story_jump_initialize_registry ===
    story_jump_registry_initialized = True
    story_jump_last_id = "none"
    story_jump_last_display_name = "none"
    story_jump_last_target_scene = 0
    story_jump_last_validation_result = "not_run"
    story_jump_last_summary = "Story jump registry initialized. Test Mode presets are GM-only."
    story_jump_generation_id = 0
    story_jump_mode_access = "test_mode_only"
    story_jump_expected_next_event = "none"
    story_jump_framework_warning = "none"
    story_jump_skipped_observations = "none"
    log("Khovan story jump preset registry initialized with active Slice 04 and Slice 05 seeds only.")
    ->END

=== khovan_story_jump_preset_mission_start_generator_governor ===
    await task_schedule(khovan_story_jump_execute_preset, {"jump_id": "mission_start_generator_governor"})
    comms_receive(story_jump_last_summary, title="Khovan Story Jump", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_story_jump_presets")
    ->END

=== khovan_story_jump_preset_tarsis_resupply_complete ===
    await task_schedule(khovan_story_jump_execute_preset, {"jump_id": "tarsis_resupply_complete"})
    comms_receive(story_jump_last_summary, title="Khovan Story Jump", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_story_jump_presets")
    ->END

=== khovan_story_jump_preset_engineering_shakedown_complete ===
    await task_schedule(khovan_story_jump_execute_preset, {"jump_id": "engineering_shakedown_complete"})
    comms_receive(story_jump_last_summary, title="Khovan Story Jump", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_story_jump_presets")
    ->END

=== khovan_story_jump_preset_anderson_orders ===
    await task_schedule(khovan_story_jump_execute_preset, {"jump_id": "anderson_orders"})
    comms_receive(story_jump_last_summary, title="Khovan Story Jump", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_story_jump_presets")
    ->END

=== khovan_story_jump_preset_distress_localized ===
    await task_schedule(khovan_story_jump_execute_preset, {"jump_id": "distress_localized"})
    comms_receive(story_jump_last_summary, title="Khovan Story Jump", title_color="cyan")
    comms_navigate("//comms/gamemaster/khovan_story_jump_presets")
    ->END

=== khovan_story_jump_execute_preset ===
    default jump_id = "mission_start_generator_governor"
    story_jump_generation_id = story_jump_generation_id + 1
    transition_held = False
    story_jump_last_id = jump_id
    story_jump_mode_access = "test_mode_only"
    story_jump_required_prior_flags = "none"
    story_jump_entities = "Artemis, Kestrel Yards, and Tarsis Station reused or created by Slice 04 setup; no proof stations."
    story_jump_timers = "stale Kestrel generator advisory timer invalidated by seed helper."
    story_jump_clips = "none"
    story_jump_validation_checks = "mission_phase,current_scene,current_beat,last_checkpoint,story_jump_generation_id,Slice04 gate flags,resource state"
    story_jump_recovery_notes = "GM Test Mode preset for admin/live-smoke setup only."
    story_jump_framework_warning = "none"
    story_jump_skipped_observations = "none"

    if jump_id == "mission_start_generator_governor":
        await task_schedule(khovan_act1_story_jump_seed_mission_start)
        story_jump_last_display_name = "Mission Start"
        story_jump_last_target_scene = 1
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Comms, request departure clearance from Kestrel Yard Control."
        story_jump_seeded_state_summary = "Slice 04 mission start restored: generator governor active, visible energy 0, all ordnance 0, Kestrel reserve held."
        story_jump_clips = "Dillon Clip 1 stub may replay during contact setup"
        story_jump_gm_display = "Mission Start preset seeded."
    elif jump_id == "tarsis_resupply_complete":
        await task_schedule(khovan_act1_story_jump_seed_post_tarsis_handoff)
        story_jump_last_display_name = "Post-Tarsis / Engineering Ready"
        story_jump_last_target_scene = 2
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Resupply complete. Stand by for Dillon to begin the Engineering shakedown."
        story_jump_seeded_state_summary = "Slice 04 post-Tarsis handoff seeded: generator governor clear, full energy and armament requested, current objective points to Engineering shakedown."
        story_jump_skipped_observations = "Manual jump skips proof of Kestrel departure, Tarsis request sequence, and mechanical docking/resupply."
        story_jump_gm_display = "Post-Tarsis / Engineering Ready preset seeded."
    elif jump_id == "engineering_shakedown_complete":
        await task_schedule(khovan_act1_story_jump_seed_engineering_shakedown_complete)
        story_jump_last_display_name = "Engineering Shakedown Complete"
        story_jump_last_target_scene = 2
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Slice 06 target spike ready."
        story_jump_seeded_state_summary = "Slice 05 engineering shakedown complete seeded: Tarsis resupply complete, all engineering shakedown gates marked complete, and current objective points to Slice 06 target spike."
        story_jump_skipped_observations = "Manual jump skips proof of engineering no-motion, DAMCON positioning, controlled overload damage, repair, and navigation-priority preset."
        story_jump_gm_display = "Engineering Shakedown Complete preset seeded."
    elif jump_id == "anderson_orders":
        await task_schedule(khovan_act2_story_jump_seed_anderson_orders)
        story_jump_last_display_name = "JUMP-011 Anderson Orders"
        story_jump_last_target_scene = 5
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Science reports the distress localization."
        story_jump_seeded_state_summary = "Act II entered, Anderson orders delivered and acknowledged, Dillon pivot note sent, distress signal detected, localization still open."
        story_jump_skipped_observations = "Manual jump skips proof of the Act I handoff, the Anderson message surface, and the acknowledgment route."
        story_jump_gm_display = "JUMP-011 Anderson Orders preset seeded."
    elif jump_id == "distress_localized":
        await task_schedule(khovan_act2_story_jump_seed_distress_localized)
        story_jump_last_display_name = "JUMP-012 Distress Localized"
        story_jump_last_target_scene = 7
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Phase B: Halcyon Drift arrival."
        story_jump_seeded_state_summary = "Act II entered with the distress source already localized; Phase B owns Halcyon spawn, scan, and hail."
        story_jump_skipped_observations = "Manual jump skips proof of the localization route in addition to everything JUMP-011 skips."
        story_jump_gm_display = "JUMP-012 Distress Localized preset seeded."
    else:
        story_jump_last_display_name = "Unknown Story Jump"
        story_jump_last_target_scene = 0
        story_jump_last_validation_result = "invalid_jump_id"
        story_jump_expected_next_event = "none"
        story_jump_seeded_state_summary = "No state seeded."
        story_jump_gm_display = "Unknown story jump id."
        story_jump_framework_warning = "invalid story jump id."
        story_jump_skipped_observations = "not_observed"

    story_jump_last_summary = f"STORY JUMP SUMMARY\njump_id. {story_jump_last_id}\ndisplay_name. {story_jump_last_display_name}\ntarget_scene. {story_jump_last_target_scene}\nmode_access. {story_jump_mode_access}\nmission_phase. {mission_phase}\ncurrent_scene. {current_scene}\ncurrent_beat. {current_beat}\nlast_checkpoint. {last_checkpoint}\ngeneration_id. {story_jump_generation_id}\nvalidation. {story_jump_last_validation_result}\nseeded_state. {story_jump_seeded_state_summary}\nentities. {story_jump_entities}\ntimers. {story_jump_timers}\nclips. {story_jump_clips}\nexpected_next_event. {story_jump_expected_next_event}\nwarning. {story_jump_framework_warning}\nskipped_observations. {story_jump_skipped_observations}"
    scenario_control_panel_last_action = f"story_jump:{story_jump_last_id}"
    scenario_control_panel_action_log = f"{scenario_control_panel_action_log} | STORY JUMP {story_jump_last_id}: validation={story_jump_last_validation_result} generation={story_jump_generation_id}"
    script.write_khovan_startup_trace(f"[KHOVAN JUMP {story_jump_generation_id}] {story_jump_last_id} validation={story_jump_last_validation_result}")
    log(f"Khovan story jump preset executed: {story_jump_last_id} validation={story_jump_last_validation_result} generation={story_jump_generation_id}.")
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END
