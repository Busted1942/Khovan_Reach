    ->END

=== khovan_story_jump_execute_preset ===
    default jump_id = "mission_start_generator_governor"
    story_jump_generation_id = story_jump_generation_id + 1
    transition_held = False
    story_jump_last_id = jump_id
    story_jump_mode_access = "test_mode_only"
    story_jump_required_prior_flags = "none"
    story_jump_entities = "Artemis, Kestrel Yards, and Tarsis Station reused or created by Slice 04 setup; no proof stations."
    story_jump_timers = "stale Kestrel generator advisory timer invalidated by seed helper."
    story_jump_clips = "none"
    story_jump_validation_checks = "mission_phase,current_scene,current_beat,last_checkpoint,story_jump_generation_id,Slice04 gate flags,resource state"
    story_jump_recovery_notes = "GM Test Mode preset for admin/live-smoke setup only."
    story_jump_framework_warning = "none"
    story_jump_skipped_observations = "none"

    if jump_id == "mission_start_generator_governor":
        await task_schedule(khovan_act1_story_jump_seed_mission_start)
        story_jump_last_display_name = "Mission Start"
        story_jump_last_target_scene = 1
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Comms, request departure clearance from Kestrel Yard Control."
        story_jump_seeded_state_summary = "Slice 04 mission start restored: generator governor active, visible energy 0, all ordnance 0, Kestrel reserve held."
        story_jump_clips = "Dillon Clip 1 stub may replay during contact setup"
        story_jump_gm_display = "Mission Start preset seeded."
    elif jump_id == "tarsis_resupply_complete":
        await task_schedule(khovan_act1_story_jump_seed_post_tarsis_handoff)
        story_jump_last_display_name = "Post-Tarsis / Engineering Ready"
        story_jump_last_target_scene = 2
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Resupply complete. Stand by for Dillon to begin the Engineering shakedown."
        story_jump_seeded_state_summary = "Slice 04 post-Tarsis handoff seeded: generator governor clear, full energy and armament requested, current objective points to Engineering shakedown."
        story_jump_skipped_observations = "Manual jump skips proof of Kestrel departure, Tarsis request sequence, and mechanical docking/resupply."
        story_jump_gm_display = "Post-Tarsis / Engineering Ready preset seeded."
    elif jump_id == "engineering_shakedown_complete":
        await task_schedule(khovan_act1_story_jump_seed_engineering_shakedown_complete)
        story_jump_last_display_name = "Engineering Shakedown Complete"
        story_jump_last_target_scene = 2
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Slice 06 target spike ready."
        story_jump_seeded_state_summary = "Slice 05 engineering shakedown complete seeded: Tarsis resupply complete, all engineering shakedown gates marked complete, and current objective points to Slice 06 target spike."
        story_jump_skipped_observations = "Manual jump skips proof of engineering no-motion, DAMCON positioning, controlled overload damage, repair, and navigation-priority preset."
        story_jump_gm_display = "Engineering Shakedown Complete preset seeded."
    elif jump_id == "drone_02_live_fire":
        await task_schedule(khovan_act1_story_jump_seed_drone_02_live_fire)
        story_jump_last_display_name = "JUMP-010A Drone 02 Live Fire"
        story_jump_last_target_scene = 4
        story_jump_last_validation_result = "valid_runtime_seed"
        story_jump_expected_next_event = "Drone 02 is on the range at ten kilometres and will manoeuvre and return fire. Captain, engage and destroy it."
        story_jump_seeded_state_summary = "Drone 01 controlled disable recorded complete and cleared off the range; Drone 02 spawned hostile through the normal path so the fleet/brain attach is exercised for real."
        story_jump_entities = "Artemis, Kestrel Yards, Tarsis Station, plus a hostile Drone 02 and its behavior-tree fleet. Any previous Drone 02 and fleet are cleaned up first so repeat jumps do not stack contacts or brains."
        story_jump_timers = "Drone 01 stationary-hold and subsystem-damage observers invalidated by generation bump."
        story_jump_skipped_observations = "Manual jump skips live proof of every Drone 01 gate - scan, hail, shield relay, beam lock, range band, stationary hold, fire authorization, and the subsystem critical itself."
        story_jump_gm_display = "JUMP-010A Drone 02 Live Fire preset seeded."
    elif jump_id == "anderson_orders":
        await task_schedule(khovan_act2_story_jump_seed_anderson_orders)
        story_jump_last_display_name = "JUMP-011 Anderson Orders"
        story_jump_last_target_scene = 5
        if act1_story_jump_cleanup_barrier_status == "settled" and anderson_orders_delivered and anderson_orders_ack_status == "pending":
            story_jump_last_validation_result = "valid_runtime_seed"
        else:
            story_jump_last_validation_result = "runtime_seed_failed"
            story_jump_framework_warning = "Anderson orders were not delivered with acknowledgment pending; inspect the JUMP-011 BLOCKED trace."
        story_jump_expected_next_event = "Captain directs Comms to select Tarsis Station and acknowledge Anderson's orders."
        story_jump_seeded_state_summary = "Act I recorded as successfully completed; Kestrel/Tarsis holds released; Drone 01, Drone 02, Drone 02 fleet AI, and GM test contacts confirmed deleted. Act II entered with Anderson orders visibly delivered and acknowledgment pending."
        story_jump_entities = "Artemis, Kestrel Yards, and Tarsis Station remain. All Act I drone, fleet, target-spike, and subsystem-control object ids captured at jump time were deleted before Anderson delivery."
        story_jump_timers = "All Act I observers invalidated after successful-state seeding; no prior drill timer remains authoritative."
        story_jump_clips = "Anderson Clip 1 text stand-in delivered through the normal message path"
        story_jump_skipped_observations = "Manual jump skips proof of the Act I handoff; Anderson delivery and the acknowledgment route remain testable."
        story_jump_gm_display = "JUMP-011 Anderson Orders delivered; awaiting Tarsis acknowledgment."
    elif jump_id == "distress_localized":
        await task_schedule(khovan_act2_story_jump_seed_distress_localized)
        story_jump_last_display_name = "JUMP-012 Distress Localized"
        story_jump_last_target_scene = 8
        if act1_story_jump_cleanup_barrier_status == "settled" and distress_localized and halcyon_spawned and halcyon_jump_012_relocation_status == "relocated_to_halcyon_approach":
            story_jump_last_validation_result = "valid_runtime_seed"
        else:
            story_jump_last_validation_result = "runtime_seed_failed"
            story_jump_framework_warning = "Localized state, Halcyon contact, or Artemis approach placement is missing; inspect the JUMP-012 BLOCKED, RELOCATE, and HALCYON CLEANUP traces."
        story_jump_expected_next_event = "Captain directs Science to scan and Comms to hail Halcyon Drift."
        story_jump_seeded_state_summary = "Act I recorded as successfully completed and cleared exactly as in JUMP-011. Act II entered with the distress source localized, Halcyon Drift spawned at the fixed Tarsis-relative contact point, and Artemis placed five kilometres off Halcyon."
        story_jump_entities = "Artemis at the Halcyon approach, Kestrel Yards, Tarsis Station, and one repeat-safe Halcyon Drift contact. All captured Act I drones, fleet AI, and GM test contacts were confirmed deleted before the Halcyon spawn."
        story_jump_timers = "All Act I observers invalidated after successful-state seeding; Act II localization is complete and Halcyon owns the active contact state."
        story_jump_skipped_observations = "Manual jump skips proof of the localization route in addition to everything JUMP-011 skips."
        story_jump_gm_display = "JUMP-012 Distress Localized; Artemis at five kilometre Halcyon approach."
    elif jump_id == "halcyon_arrival":
        await task_schedule(khovan_act2_story_jump_seed_halcyon_arrival)
        story_jump_last_display_name = "JUMP-013 Halcyon Arrival"
        story_jump_last_target_scene = 8
        if act1_story_jump_cleanup_barrier_status == "settled" and halcyon_cleanup_barrier_status == "settled" and halcyon_spawned and halcyon_jump_013_relocation_status == "relocated_to_halcyon_approach" and current_scene == 8:
            story_jump_last_validation_result = "valid_runtime_seed"
        else:
            story_jump_last_validation_result = "runtime_seed_failed"
            story_jump_framework_warning = "Halcyon is not active in Scene 8 or Artemis was not placed at its approach point; inspect the JUMP-013 BLOCKED, RELOCATE, and HALCYON CLEANUP traces."
        story_jump_expected_next_event = "Captain directs Science to scan and Comms to hail Halcyon Drift."
        story_jump_seeded_state_summary = "Act I recorded as successfully completed and cleared exactly as in JUMP-011. Halcyon Drift spawned and selectable; Artemis placed five kilometres off Halcyon; scan, hail, and deployment state reset. Both cleanup barriers and the approach placement settled before success was reported."
        story_jump_entities = "Artemis, Kestrel Yards, Tarsis Station, and exactly one Halcyon Drift contact. No captured Act I drone, fleet AI, GM test contact, or prior Halcyon remains."
        story_jump_timers = "All Act I observers invalidated after successful-state seeding; Halcyon observers reset for the new Scene 8 contact."
        story_jump_skipped_observations = "Manual jump skips proof of the Act II transit and the localization route."
        story_jump_gm_display = "JUMP-013 Halcyon Arrival preset seeded."
    else:
        story_jump_last_display_name = "Unknown Story Jump"
        story_jump_last_target_scene = 0
        story_jump_last_validation_result = "invalid_jump_id"
        story_jump_expected_next_event = "none"
        story_jump_seeded_state_summary = "No state seeded."
        story_jump_gm_display = "Unknown story jump id."
        story_jump_framework_warning = "invalid story jump id."
        story_jump_skipped_observations = "not_observed"

    story_jump_last_summary = f"STORY JUMP SUMMARY\njump_id. {story_jump_last_id}\ndisplay_name. {story_jump_last_display_name}\ntarget_scene. {story_jump_last_target_scene}\nmode_access. {story_jump_mode_access}\nmission_phase. {mission_phase}\ncurrent_scene. {current_scene}\ncurrent_beat. {current_beat}\nlast_checkpoint. {last_checkpoint}\ngeneration_id. {story_jump_generation_id}\nvalidation. {story_jump_last_validation_result}\nseeded_state. {story_jump_seeded_state_summary}\nentities. {story_jump_entities}\ntimers. {story_jump_timers}\nclips. {story_jump_clips}\nexpected_next_event. {story_jump_expected_next_event}\nwarning. {story_jump_framework_warning}\nskipped_observations. {story_jump_skipped_observations}"
    scenario_control_panel_last_action = f"story_jump:{story_jump_last_id}"
    scenario_control_panel_action_log = f"{scenario_control_panel_action_log} | STORY JUMP {story_jump_last_id}: validation={story_jump_last_validation_result} generation={story_jump_generation_id}"
    script.write_khovan_startup_trace(f"[KHOVAN JUMP {story_jump_generation_id}] {story_jump_last_id} validation={story_jump_last_validation_result}")
    log(f"Khovan story jump preset executed: {story_jump_last_id} validation={story_jump_last_validation_result} generation={story_jump_generation_id}.")
    await task_schedule(khovan_scenario_control_panel_update_overview)
    ->END
